---
import { getContent } from '../lib/contentStore';
const content = await getContent(Astro.locals);
const whatsapp = String(content.contact?.whatsapp || '').replace(/\D/g, '');
const instagram = String(content.contact?.instagram || '').replace(/^@/, '');
---
<footer class="public-footer">
  <div class="footer-grid">
    <div>
      <a class="footer-brand" href="/"><img src="/icons/ssb-logo.png" alt="" width="42" height="48" /> <span>Bhayangkara Junior <em>2018</em></span></a>
      <p>Tempat anak bertumbuh melalui sepak bola, disiplin, dan nilai-nilai karakter.</p>
    </div>
    <div><strong>Jelajahi</strong><a href="/tentang">Tentang SSB</a><a href="/program">Program Pembinaan</a><a href="/berita">Berita & Prestasi</a></div>
    <div><strong>Hubungi Kami</strong><span>{content.contact?.address || 'Pamulang, Tangerang Selatan'}</span>{whatsapp && <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener">WhatsApp Pendaftaran</a>}{instagram && <a href={`https://instagram.com/${instagram}`} target="_blank" rel="noopener">Instagram</a>}</div>
    <div class="footer-action"><strong>Mulai perjalanan anak Anda</strong><p>Konsultasikan jadwal dan proses pendaftaran kepada tim kami.</p><a href="/pendaftaran">Daftar Siswa Baru <span>→</span></a></div>
  </div>
  <div class="footer-bottom"><span>© 2018–2026 SSB Bhayangkara Junior. Semua hak dilindungi.</span><span>Sports · Education · Character</span></div>
</footer>
<style>
.public-footer{padding:64px max(18px,calc((100% - 1180px)/2)) 24px;background:#01130b;border-top:1px solid rgba(18,163,93,.32);color:#dceae3}.footer-grid{display:grid;grid-template-columns:1.4fr .8fr 1fr 1.2fr;gap:36px}.footer-brand{display:flex;align-items:center;gap:10px;font-weight:900;font-size:18px}.footer-brand em{color:#ffd84f;font-style:normal}.footer-grid p{color:#8fa69a;line-height:1.7;max-width:310px}.footer-grid strong{display:block;margin:8px 0 14px;color:#ffd84f;font-size:13px;text-transform:uppercase;letter-spacing:.1em}.footer-grid>div:not(:first-child) a,.footer-grid>div:not(:first-child) span{display:block;margin:10px 0;color:#b7cbc0;font-size:14px;line-height:1.5}.footer-grid a:hover{color:#ffd84f}.footer-action{padding:22px;border:1px solid rgba(244,197,45,.3);border-radius:18px;background:rgba(244,197,45,.06)}.footer-action a{display:inline-flex;margin-top:7px;padding:11px 15px;border-radius:999px;background:#f4c52d;color:#052217;font-weight:900}.footer-action a span{color:#052217!important;display:inline!important;margin-left:8px!important}.footer-bottom{display:flex;justify-content:space-between;gap:20px;margin-top:48px;padding-top:18px;border-top:1px solid rgba(18,163,93,.16);color:#718f81;font-size:11px;letter-spacing:.08em}@media(max-width:850px){.footer-grid{grid-template-columns:1fr 1fr}.footer-bottom{display:block}.footer-bottom span{display:block;margin-top:8px}}@media(max-width:520px){.footer-grid{grid-template-columns:1fr}.public-footer{padding-top:48px}}
</style>

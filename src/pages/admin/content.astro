---
import { getUserBySession } from '../../lib/authStore';

const sessionToken = Astro.cookies.get('ssb_session')?.value || '';
const currentUser = sessionToken
  ? await getUserBySession(Astro.locals, sessionToken)
  : null;

if (!currentUser || currentUser.role !== 'admin') {
  return Astro.redirect(
    '/login?redirect=' + encodeURIComponent(Astro.url.pathname)
  );
}

export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
---

<Layout title="Kelola Konten - Admin SSB Bhayangkara Junior 2018">
  <AdminNav />

<main class="content-admin">

    <header class="page-head">
      <div>
        <p class="eyebrow">ADMIN • CONTENT MANAGEMENT</p>
        <h1>Kelola Konten</h1>
        <p>
          Edit isi website, jadwal, turnamen, galeri, dan informasi utama.
        </p>
      </div>

      <a href="/admin/pendaftaran" class="back-btn">
        ← Pendaftaran
      </a>
    </header>

    <div id="message" class="message" hidden></div>

    <section class="editor-card">
      <div class="section-title">
        <div>
          <span>01</span>
          <h2>Hero / Banner Utama</h2>
        </div>
      </div>

      <div class="form-grid">
        <label>
          <span>Judul Utama</span>
          <input id="heroTitle" type="text">
        </label>

        <label>
          <span>Teks Pendukung</span>
          <input id="heroSubtitle" type="text">
        </label>

        <label>
          <span>Teks Tombol</span>
          <input id="heroButtonText" type="text">
        </label>

        <label>
          <span>Link Tombol</span>
          <input id="heroButtonLink" type="text">
        </label>
      </div>

      <div class="photo-upload">
        <div class="upload-icon">🖼️</div>

        <div class="upload-main">
          <strong>Foto Banner</strong>
          <p id="heroUploadStatus">Belum ada foto banner.</p>

          <div id="heroPreview" class="upload-preview" hidden>
            <img id="heroPreviewImage" alt="Preview banner">
          </div>
        </div>

        <label class="upload-btn">
          Pilih Foto
          <input
            id="heroFile"
            type="file"
            accept="image/jpeg,image/png,image/webp,image/avif"
          >
        </label>
      </div>
    </section>


    <section class="editor-card">
      <div class="section-title">
        <div>
          <span>02</span>
          <h2>Visi & Misi</h2>
        </div>
      </div>

      <label>
        <span>Visi</span>
        <textarea id="visionText" rows="4"></textarea>
      </label>

      <label>
        <span>Misi — satu poin setiap baris</span>
        <textarea id="missionItems" rows="6"></textarea>
      </label>
    </section>


    <section class="editor-card">
      <div class="section-title">
        <div>
          <span>03</span>
          <h2>Kontak & Informasi</h2>
        </div>
      </div>

      <div class="form-grid">
        <label>
          <span>WhatsApp</span>
          <input id="whatsapp" type="text" placeholder="628xxxxxxxxxx">
        </label>

        <label>
          <span>Instagram</span>
          <input id="instagram" type="text" placeholder="@ssb_bhayangkarajunior">
        </label>

        <label class="full">
          <span>Alamat</span>
          <textarea id="address" rows="3"></textarea>
        </label>
      </div>
    </section>


    <section id="schedule" class="editor-card">
      <div class="section-title">
        <div>
          <span>04</span>
          <h2>Jadwal Latihan</h2>
        </div>

        <button id="addSchedule" type="button" class="add-btn">
          + Tambah Jadwal
        </button>
      </div>

      <div id="scheduleList" class="repeat-list"></div>
    </section>


    <section id="tournaments" class="editor-card">
      <div class="section-title">
        <div>
          <span>05</span>
          <h2>Turnamen</h2>
        </div>

        <button id="addTournament" type="button" class="add-btn">
          + Tambah Turnamen
        </button>
      </div>

      <div id="tournamentList" class="repeat-list"></div>
    </section>


    <section class="editor-card">
      <div class="section-title">
        <div>
          <span>06</span>
          <h2>Galeri Foto</h2>
        </div>

        <button id="addGallery" type="button" class="add-btn">
          + Tambah Foto
        </button>
      </div>

      <div id="galleryList" class="gallery-list"></div>

      <div class="photo-note">
        📸 Foto galeri akan disimpan di penyimpanan khusus website,
        bukan di folder <code>public</code>.
      </div>
    </section>


    <section id="announcements" class="editor-card">
      <div class="section-title">
        <div>
          <span>07</span>
          <h2>Pengumuman</h2>
        </div>

        <button id="addAnnouncement" type="button" class="add-btn">
          + Tambah
        </button>
      </div>

      <div id="announcementList" class="repeat-list"></div>
    </section>


    <div class="save-bar">
      <div>
        <strong>Simpan semua perubahan</strong>
        <small>Perubahan tersimpan di server lokal.</small>
      </div>

      <button id="saveBtn" type="button" class="save-btn">
        Simpan Konten
      </button>
    </div>

  </main>
</Layout>

<style>
  :global(body) {
    background: #031c12;
  }

  .content-admin {
    width: min(1100px, calc(100% - 24px));
    margin: auto;
    padding: 80px 0 130px;
    color: #f4f8f4;
  }

  .page-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 25px;
  }

  .eyebrow {
    color: #e6bd35;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .14em;
    margin: 0 0 8px;
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 7vw, 55px);
    line-height: 1;
  }

  .page-head p:not(.eyebrow) {
    color: #8fa69a;
    margin: 12px 0 0;
  }

  .back-btn {
    border: 1px solid #31543f;
    border-radius: 10px;
    padding: 11px 15px;
    color: #f4f8f4;
    text-decoration: none;
    font-weight: 800;
    background: #09291b;
  }

  .editor-card {
    border: 1px solid #1c5a40;
    border-radius: 20px;
    background: #03291a;
    padding: 24px;
    margin-bottom: 18px;
  }

  .section-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 22px;
  }

  .section-title > div {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .section-title span {
    color: #e6bd35;
    font-weight: 900;
    font-size: 13px;
  }

  h2 {
    margin: 0;
    font-size: 23px;
  }

  label {
    display: block;
    margin-bottom: 15px;
  }

  label > span {
    display: block;
    margin-bottom: 7px;
    color: #9eb1a5;
    font-size: 13px;
    font-weight: 700;
  }

  input,
  textarea,
  select {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #31543f;
    border-radius: 10px;
    background: #061f14;
    color: #f4f8f4;
    padding: 12px 13px;
    outline: none;
    font: inherit;
  }

  input:focus,
  textarea:focus,
  select:focus {
    border-color: #e6bd35;
  }

  textarea {
    resize: vertical;
    min-height: 90px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 15px;
  }

  .form-grid .full {
    grid-column: 1 / -1;
  }

  .photo-upload {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 15px;
    border: 1px dashed #31543f;
    border-radius: 15px;
    padding: 16px;
    margin-top: 8px;
    background: #061f14;
  }

  .upload-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #e6bd35;
    font-size: 22px;
  }

  .photo-upload strong {
    display: block;
  }

  .photo-upload p {
    margin: 4px 0 0;
    color: #718b7d;
    font-size: 12px;
  }

  .photo-upload button {
    margin-left: auto;
    border: 1px solid #31543f;
    border-radius: 9px;
    background: #102f20;
    color: #718b7d;
    padding: 9px 12px;
  }

  .add-btn {
    border: 1px solid #31543f;
    border-radius: 9px;
    background: #09291b;
    color: #e6bd35;
    padding: 9px 12px;
    font-weight: 800;
    cursor: pointer;
  }

  .repeat-list {
    display: grid;
    gap: 12px;
  }

  .repeat-item {
    display: grid;
    grid-template-columns: minmax(150px, .55fr) minmax(260px, 1.45fr) auto;
    gap: 12px;
    align-items: end;
    padding: 16px;
    border: 1px solid #1b5d40;
    border-radius: 15px;
    background:
      linear-gradient(135deg, rgba(12,67,43,.72), rgba(4,31,20,.92));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.025);
  }

  .repeat-item label {
    margin: 0;
    min-width: 0;
  }

  .repeat-item input {
    min-height: 45px;
  }

  .repeat-item .remove-btn {
    min-width: 76px;
  }

  .remove-btn {
    height: 45px;
    border: 1px solid #6e3838;
    border-radius: 9px;
    background: #281616;
    color: #ff9b9b;
    padding: 0 12px;
    cursor: pointer;
    font-weight: 800;
  }

  .gallery-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .gallery-item {
    min-width: 0;
    border: 1px solid #1b5d40;
    border-radius: 15px;
    background:
      linear-gradient(145deg, rgba(7,48,31,.96), rgba(4,29,19,.96));
    padding: 13px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.025);
  }

  .gallery-item input {
    min-height: 42px;
  }

  .gallery-item label > span {
    font-size: 12px;
  }

  .gallery-item label {
    margin-bottom: 10px;
  }

  .gallery-item .remove-btn {
    width: 100%;
  }

  .photo-note {
    margin-top: 14px;
    color: #718b7d;
    font-size: 12px;
  }

  code {
    color: #e6bd35;
  }

  .message {
    margin-bottom: 18px;
    border: 1px solid #31543f;
    border-radius: 10px;
    background: #09291b;
    color: #9ed7a9;
    padding: 13px 15px;
    font-weight: 800;
  }

  .save-bar {
    position: sticky;
    bottom: 10px;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    border: 1px solid #496f54;
    border-radius: 14px;
    background: rgba(3, 28, 18, .97);
    padding: 10px 12px;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 30px rgba(0,0,0,.25);
  }

  .save-bar strong {
    display: block;
    font-size: 14px;
  }

  .save-bar small {
    display: block;
    color: #718b7d;
    margin-top: 2px;
    font-size: 11px;
  }

  .save-btn {
    flex: 0 0 auto;
    border: 0;
    border-radius: 9px;
    background: #e6bd35;
    color: #102116;
    padding: 10px 15px;
    font-weight: 900;
    font-size: 14px;
    cursor: pointer;
  }

  .upload-main {
    flex: 1;
    min-width: 0;
  }

  .upload-main p {
    color: #718b7d;
    margin: 4px 0 0;
    font-size: 12px;
  }

  .upload-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #e6bd35;
    border-radius: 9px;
    background: #102f20;
    color: #e6bd35;
    padding: 9px 13px;
    font-weight: 800;
    font-size: 13px;
    cursor: pointer;
    white-space: nowrap;
  }

  .upload-btn input {
    display: none;
  }

  .upload-preview {
    margin-top: 12px;
    width: min(100%, 520px);
    aspect-ratio: 16 / 7;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid #31543f;
    background: #061f14;
    box-shadow: 0 8px 24px rgba(0,0,0,.18);
  }

  .upload-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-preview {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 9px;
    margin-bottom: 12px;
    background: #061f14;
    border: 1px solid #16472f;
  }

  .gallery-preview[hidden] {
    display: none;
  }

  .gallery-preview img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .gallery-upload {
    width: 100%;
    box-sizing: border-box;
  }

  .upload-status {
    display: block;
    margin-top: 6px;
    color: #8fa69a;
    font-size: 11px;
  }

  .save-btn:disabled {
    opacity: .55;
  }

  @media (max-width: 900px) {
    .content-admin {
      width: min(100% - 28px, 720px);
      padding: 76px 0 125px;
    }

    .editor-card {
      padding: 18px;
      border-radius: 18px;
    }

    .page-head {
      margin-bottom: 18px;
    }

    .page-head h1 {
      font-size: clamp(32px, 9vw, 46px);
    }

    .repeat-item {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 15px;
    }

    .repeat-item .remove-btn {
      width: 100%;
    }

    .gallery-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }

  @media (max-width: 520px) {
    .content-admin {
      width: min(100% - 20px, 480px);
      padding-top: 70px;
    }

    .editor-card {
      padding: 14px;
      border-radius: 16px;
    }

    .section-title {
      align-items: flex-start;
      margin-bottom: 16px;
    }

    .section-title > div {
      min-width: 0;
    }

    h2 {
      font-size: 20px;
    }

    .gallery-list {
      grid-template-columns: 1fr;
    }

    .save-bar {
      left: 10px;
      right: 10px;
    }
  }

  @media (max-width: 700px) {
    .content-admin {
      padding-top: 65px;
    }

    .page-head {
      align-items: stretch;
      flex-direction: column;
    }

    .back-btn {
      text-align: center;
    }

    .form-grid {
      grid-template-columns: 1fr;
    }

    .form-grid .full {
      grid-column: auto;
    }

    .repeat-item {
      grid-template-columns: 1fr;
    }

    .gallery-list {
      grid-template-columns: 1fr;
    }

    .photo-upload {
      grid-template-columns: auto 1fr;
      align-items: start;
    }

    .photo-upload .upload-btn {
      grid-column: 1 / -1;
      width: 100%;
    }

    .save-bar {
      align-items: center;
      flex-direction: row;
      gap: 10px;
      padding: 9px 10px;
    }

    .save-bar > div {
      min-width: 0;
    }

    .save-bar strong {
      font-size: 12px;
      white-space: nowrap;
    }

    .save-bar small {
      font-size: 10px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 175px;
    }

    .save-btn {
      width: auto;
      min-width: 125px;
      padding: 10px 11px;
      font-size: 13px;
    }
  }
</style>

<script>
  let content: any = {
    hero: {},
    vision: {},
    mission: { items: [] },
    contact: {},
    schedule: [],
    tournaments: [],
    gallery: [],
    announcements: []
  };

  const $ = (id: string) =>
    document.getElementById(id) as HTMLElement;

  async function loadContent() {
    try {
      const response = await fetch(
        '/api/admin/content',
        { cache: 'no-store' }
      );

      const result = await response.json();

      if (!result.success) {
        throw new Error(result.message);
      }

      content = result.data;

      fillForm();
      renderSchedules();
      renderTournaments();
      renderGallery();
      renderAnnouncements();

    } catch (error) {
      showMessage(
        error instanceof Error
          ? error.message
          : 'Gagal memuat konten.',
        true
      );
    }
  }

  function fillForm() {
    ( $('heroTitle') as HTMLInputElement ).value =
      content.hero?.title || '';

    ( $('heroSubtitle') as HTMLInputElement ).value =
      content.hero?.subtitle || '';

    ( $('heroButtonText') as HTMLInputElement ).value =
      content.hero?.buttonText || '';

    ( $('heroButtonLink') as HTMLInputElement ).value =
      content.hero?.buttonLink || '';

    ( $('visionText') as HTMLTextAreaElement ).value =
      content.vision?.text || '';

    ( $('missionItems') as HTMLTextAreaElement ).value =
      (content.mission?.items || []).join('\n');

    ( $('whatsapp') as HTMLInputElement ).value =
      content.contact?.whatsapp || '';

    ( $('instagram') as HTMLInputElement ).value =
      content.contact?.instagram || '';

    ( $('address') as HTMLTextAreaElement ).value =
      content.contact?.address || '';

    const heroImage = content.hero?.image;

    if (heroImage) {
      const preview =
        $('heroPreview') as HTMLElement;

      const image =
        $('heroPreviewImage') as HTMLImageElement;

      const status =
        $('heroUploadStatus');

      image.src = heroImage;
      preview.hidden = false;
      status.textContent =
        '✓ Foto banner sudah tersimpan.';
    }
  }

  function renderSchedules() {
    const list = $('scheduleList');

    list.innerHTML =
      (content.schedule || []).map(
        (item: any, index: number) => `
          <div class="repeat-item">
            <label>
              <span>Hari</span>
              <input
                data-schedule-day="${index}"
                value="${esc(item.day)}"
                placeholder="Sabtu"
              >
            </label>

            <label>
              <span>Waktu / Tempat</span>
              <input
                data-schedule-info="${index}"
                value="${esc(item.info)}"
                placeholder="15.30 - 17.30 • Lapangan..."
              >
            </label>

            <button
              type="button"
              class="remove-btn"
              data-remove-schedule="${index}"
            >
              Hapus
            </button>
          </div>
        `
      ).join('');

    list
      .querySelectorAll('[data-remove-schedule]')
      .forEach(btn => {
        btn.addEventListener('click', () => {
          const index = Number(
            btn.getAttribute('data-remove-schedule')
          );

          content.schedule.splice(index, 1);
          renderSchedules();
        });
      });
  }

  function renderTournaments() {
    const list = $('tournamentList');

    list.innerHTML =
      (content.tournaments || []).map(
        (item: any, index: number) => `
          <div class="repeat-item">
            <label>
              <span>Nama Turnamen</span>
              <input
                data-tournament-name="${index}"
                value="${esc(item.name)}"
              >
            </label>

            <label>
              <span>Tanggal / Lokasi</span>
              <input
                data-tournament-info="${index}"
                value="${esc(item.info)}"
              >
            </label>

            <button
              type="button"
              class="remove-btn"
              data-remove-tournament="${index}"
            >
              Hapus
            </button>
          </div>
        `
      ).join('');

    list
      .querySelectorAll('[data-remove-tournament]')
      .forEach(btn => {
        btn.addEventListener('click', () => {
          const index = Number(
            btn.getAttribute('data-remove-tournament')
          );

          content.tournaments.splice(index, 1);
          renderTournaments();
        });
      });
  }

  function renderGallery() {
    const list = $('galleryList');

    list.innerHTML =
      (content.gallery || []).map(
        (item: any, index: number) => `
          <div class="gallery-item">

            <div
              class="gallery-preview"
              ${item.image ? '' : 'hidden'}
            >
              ${
                item.image
                  ? `<img src="${esc(item.image)}" alt="${esc(item.title || 'Foto galeri')}">`
                  : ''
              }
            </div>

            <label>
              <span>Judul Foto</span>
              <input
                data-gallery-title="${index}"
                value="${esc(item.title)}"
                placeholder="Contoh: Latihan Sore"
              >
            </label>

            <label>
              <span>Foto</span>

              <label class="upload-btn gallery-upload">
                ${
                  item.image
                    ? 'Ganti Foto'
                    : 'Pilih Foto'
                }

                <input
                  type="file"
                  accept="image/jpeg,image/png,image/webp,image/avif"
                  data-gallery-file="${index}"
                >
              </label>

              <input
                type="hidden"
                data-gallery-image="${index}"
                value="${esc(item.image)}"
              >

              <small
                class="upload-status"
                data-gallery-status="${index}"
              >
                ${
                  item.image
                    ? '✓ Foto sudah dipilih'
                    : 'Belum ada foto'
                }
              </small>
            </label>

            <button
              type="button"
              class="remove-btn"
              data-remove-gallery="${index}"
            >
              Hapus Foto
            </button>

          </div>
        `
      ).join('');

    if (!(content.gallery || []).length) {
      list.innerHTML =
        '<div class="photo-note">Belum ada foto galeri.</div>';
    }

    list
      .querySelectorAll('[data-remove-gallery]')
      .forEach(btn => {
        btn.addEventListener('click', () => {
          const index = Number(
            btn.getAttribute('data-remove-gallery')
          );

          content.gallery.splice(index, 1);
          renderGallery();
        });
      });
  }

  function renderAnnouncements() {
    const list = $('announcementList');

    list.innerHTML =
      (content.announcements || []).map(
        (item: any, index: number) => `
          <div class="repeat-item">
            <label>
              <span>Judul</span>
              <input
                data-announcement-title="${index}"
                value="${esc(item.title)}"
              >
            </label>

            <label>
              <span>Isi</span>
              <input
                data-announcement-text="${index}"
                value="${esc(item.text)}"
              >
            </label>

            <button
              type="button"
              class="remove-btn"
              data-remove-announcement="${index}"
            >
              Hapus
            </button>
          </div>
        `
      ).join('');
  }


  async function uploadPhoto(
    file: File,
    type: 'hero' | 'gallery'
  ) {
    const form = new FormData();

    form.append('file', file);
    form.append('type', type);

    const response = await fetch(
      '/api/admin/content/upload',
      {
        method: 'POST',
        body: form
      }
    );

    const result = await response.json();

    if (!response.ok || !result.success) {
      throw new Error(
        result.message || 'Upload foto gagal.'
      );
    }

    return result;
  }

  async function handleHeroUpload(file: File) {
    const status = $('heroUploadStatus');

    status.textContent = '⏳ Mengunggah foto...';

    try {
      const result =
        await uploadPhoto(file, 'hero');

      content.hero.image = result.url;

      const preview =
        $('heroPreview') as HTMLElement;

      const image =
        $('heroPreviewImage') as HTMLImageElement;

      image.src = result.url;
      preview.hidden = false;

      status.textContent =
        `✓ ${result.original_name} siap digunakan`;

    } catch (error) {
      status.textContent =
        error instanceof Error
          ? error.message
          : 'Upload gagal.';
    }
  }

  async function handleGalleryUpload(
    index: number,
    file: File
  ) {
    const status =
      document.querySelector(
        `[data-gallery-status="${index}"]`
      ) as HTMLElement;

    if (status) {
      status.textContent =
        '⏳ Mengunggah foto...';
    }

    try {
      const result =
        await uploadPhoto(file, 'gallery');

      content.gallery[index].image =
        result.url;

      renderGallery();

      showMessage(
        `✓ Foto galeri berhasil diunggah.`
      );

    } catch (error) {
      if (status) {
        status.textContent =
          error instanceof Error
            ? error.message
            : 'Upload gagal.';
      }
    }
  }

  function collectForm() {
    content.hero = {
      title:
        ( $('heroTitle') as HTMLInputElement ).value.trim(),

      subtitle:
        ( $('heroSubtitle') as HTMLInputElement ).value.trim(),

      buttonText:
        ( $('heroButtonText') as HTMLInputElement ).value.trim(),

      buttonLink:
        ( $('heroButtonLink') as HTMLInputElement ).value.trim(),

      image:
        content.hero?.image || ''
    };

    content.vision = {
      title: 'Visi',
      text:
        ( $('visionText') as HTMLTextAreaElement ).value.trim()
    };

    content.mission = {
      title: 'Misi',
      items:
        ( $('missionItems') as HTMLTextAreaElement )
          .value
          .split('\n')
          .map(x => x.trim())
          .filter(Boolean)
    };

    content.contact = {
      whatsapp:
        ( $('whatsapp') as HTMLInputElement ).value.trim(),

      instagram:
        ( $('instagram') as HTMLInputElement ).value.trim(),

      address:
        ( $('address') as HTMLTextAreaElement ).value.trim()
    };

    content.schedule =
      (content.schedule || []).map(
        (_item: any, index: number) => ({
          day:
            (
              document.querySelector(
                `[data-schedule-day="${index}"]`
              ) as HTMLInputElement
            )?.value || '',

          info:
            (
              document.querySelector(
                `[data-schedule-info="${index}"]`
              ) as HTMLInputElement
            )?.value || ''
        })
      );

    content.tournaments =
      (content.tournaments || []).map(
        (_item: any, index: number) => ({
          name:
            (
              document.querySelector(
                `[data-tournament-name="${index}"]`
              ) as HTMLInputElement
            )?.value || '',

          info:
            (
              document.querySelector(
                `[data-tournament-info="${index}"]`
              ) as HTMLInputElement
            )?.value || ''
        })
      );

    content.gallery =
      (content.gallery || []).map(
        (_item: any, index: number) => ({
          title:
            (
              document.querySelector(
                `[data-gallery-title="${index}"]`
              ) as HTMLInputElement
            )?.value || '',

          image:
            (
              document.querySelector(
                `[data-gallery-image="${index}"]`
              ) as HTMLInputElement
            )?.value || ''
        })
      );

    content.announcements =
      (content.announcements || []).map(
        (_item: any, index: number) => ({
          title:
            (
              document.querySelector(
                `[data-announcement-title="${index}"]`
              ) as HTMLInputElement
            )?.value || '',

          text:
            (
              document.querySelector(
                `[data-announcement-text="${index}"]`
              ) as HTMLInputElement
            )?.value || ''
        })
      );
  }

  async function saveContent() {
    collectForm();

    const button =
      $('saveBtn') as HTMLButtonElement;

    button.disabled = true;
    button.textContent = 'Menyimpan...';

    try {
      const response = await fetch(
        '/api/admin/content',
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(content)
        }
      );

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(
          result.message ||
          'Gagal menyimpan konten.'
        );
      }

      content = result.data;

      showMessage(
        '✓ Konten berhasil disimpan.'
      );

    } catch (error) {
      showMessage(
        error instanceof Error
          ? error.message
          : 'Gagal menyimpan konten.',
        true
      );
    } finally {
      button.disabled = false;
      button.textContent = 'Simpan Konten';
    }
  }

  function addSchedule() {
    content.schedule.push({
      day: '',
      info: ''
    });

    renderSchedules();
  }

  function addTournament() {
    content.tournaments.push({
      name: '',
      info: ''
    });

    renderTournaments();
  }

  function addGallery() {
    content.gallery.push({
      title: '',
      image: ''
    });

    renderGallery();
  }

  function addAnnouncement() {
    content.announcements.push({
      title: '',
      text: ''
    });

    renderAnnouncements();
  }

  function esc(value: any) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function showMessage(
    text: string,
    error = false
  ) {
    const box = $('message');

    box.textContent = text;
    box.hidden = false;

    if (error) {
      box.style.color = '#ff9b9b';
      box.style.borderColor = '#6e3838';
    } else {
      box.style.color = '#9ed7a9';
      box.style.borderColor = '#31543f';
    }

    setTimeout(() => {
      box.hidden = true;
    }, 4000);
  }

  $('addSchedule')
    .addEventListener('click', addSchedule);

  $('addTournament')
    .addEventListener('click', addTournament);

  $('addGallery')
    .addEventListener('click', addGallery);

  $('addAnnouncement')
    .addEventListener('click', addAnnouncement);

  $('heroFile')
    .addEventListener('change', async (event) => {
      const input =
        event.target as HTMLInputElement;

      const file = input.files?.[0];

      if (!file) return;

      await handleHeroUpload(file);
      input.value = '';
    });

  $('galleryList')
    .addEventListener('change', async (event) => {
      const input =
        event.target as HTMLInputElement;

      if (!input.matches('[data-gallery-file]')) {
        return;
      }

      const index = Number(
        input.getAttribute('data-gallery-file')
      );

      const file = input.files?.[0];

      if (!file) return;

      await handleGalleryUpload(index, file);
      input.value = '';
    });

  $('saveBtn')
    .addEventListener('click', saveContent);

  loadContent();
</script>

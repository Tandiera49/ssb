---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { getUserBySession } from '../../lib/authStore';
const token = Astro.cookies.get('ssb_session')?.value || '';
const user = token ? await getUserBySession(Astro.locals, token) : null;
if (!user || user.role !== 'admin') return Astro.redirect('/login?redirect=/admin/finance');
---
<Layout title="Finance Desk — SSB Bhayangkara Junior 2018">
  <AdminNav />
  <main class="finance" id="main-content">
    <header class="page-header"><div><div class="crumb">OPERATIONS / FINANCE DESK</div><h1>Keuangan</h1><p>Tagihan, pembayaran manual, dan laporan arus kas peserta.</p></div><button class="ghost" id="refresh">↻ Refresh data</button></header>
    <section class="finance-summary"><div class="summary-card dark"><span>OUTSTANDING</span><strong id="outstanding">Rp0</strong><small>Total tagihan belum lunas</small></div><div class="summary-card"><span>TERCATAT BULAN INI</span><strong id="paidCount">0</strong><small>Invoice dengan status lunas</small></div><div class="summary-card"><span>PERLU DITINDAK</span><strong id="attention">0</strong><small>Belum lunas atau tunggakan</small></div><div class="summary-card"><span>ESTIMASI KAS BULAN INI</span><strong id="monthly">Rp0</strong><small>Berdasarkan SPP aktif</small></div></section>
    <div id="notice" class="notice" hidden></div>
    <section class="finance-layout"><article class="invoice-panel"><div class="panel-top"><div><div class="eyebrow">INVOICE REGISTER</div><h2>Daftar tagihan peserta</h2></div><div class="filters"><input id="search" type="search" placeholder="Cari siswa / wali" /><select id="filter"><option value="all">Semua invoice</option><option value="unpaid">Belum lunas</option><option value="overdue">Tunggakan</option><option value="paid">Sudah lunas</option></select></div></div><div class="table-wrap"><table><thead><tr><th>PESERTA</th><th>INVOICE AKTIF</th><th>NOMINAL</th><th>STATUS</th><th></th></tr></thead><tbody id="rows"><tr><td colspan="5" class="empty">Memuat data peserta...</td></tr></tbody></table></div><div id="pagination" class="pagination"></div></article><aside class="settings-panel"><div class="eyebrow">BILLING SETTINGS</div><h2>Aturan tagihan</h2><p>Nominal ini dipakai untuk membentuk invoice baru. Pembayaran dicatat manual oleh Admin.</p><form id="configForm"><label>Administrasi<input name="administration" type="number" min="0" /></label><label>Jersey & perlengkapan<input name="jersey" type="number" min="0" /></label><label>SPP awal<input name="initialTuition" type="number" min="0" /></label><label>SPP bulanan<input name="monthlyTuition" type="number" min="0" /></label><label>Jatuh tempo setiap tanggal<input name="dueDay" type="number" min="1" max="28" /></label><div class="config-total"><span>Total biaya awal</span><strong id="initialTotal">Rp0</strong></div><button class="save" type="submit">Simpan aturan</button></form><div class="finance-rule"><b>Catatan operasional</b><p>Website tidak memproses pembayaran. Setelah menerima pembayaran offline, tandai invoice sebagai lunas dan cetak tanda terima jika diperlukan.</p></div></aside></section>
  </main>
</Layout>
<script is:inline>
const $=id=>document.getElementById(id);let records=[],config={};const money=n=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(Number(n||0));const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));const month=()=>{const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`};
function show(text,error=false){$('notice').hidden=!text;$('notice').textContent=text;$('notice').className=`notice ${error?'error':''}`}
function setConfig(){['administration','jersey','initialTuition','monthlyTuition','dueDay'].forEach(k=>{const el=document.querySelector(`[name=${k}]`);if(el)el.value=config[k]??0});$('initialTotal').textContent=money(+config.administration+(+config.jersey)+(+config.initialTuition))}
function activeInvoice(row){
  const initial=row.finance.invoices.find(x=>x.month==='initial');
  if(initial && initial.status!=='paid') return initial;
  const current=row.finance.invoices.find(x=>x.month===month());
  if(current) return current;
  return row.finance.invoices.find(x=>x.month!=='initial' && x.status!=='paid')||initial||row.finance.invoices[0];
}
let currentPage=1;
const pageSize=5;

function renderPagination(total){
  const el=$('pagination');
  if(!el)return;

  const totalPages=Math.max(1,Math.ceil(total/pageSize));

  if(total<=pageSize){
    el.innerHTML='';
    return;
  }

  if(currentPage>totalPages)currentPage=totalPages;

  let startPage=Math.max(1,currentPage-2);
  let endPage=Math.min(totalPages,startPage+4);

  if(endPage-startPage<4){
    startPage=Math.max(1,endPage-4);
  }

  let html='';

  html+=`<button class="page-btn" data-page="${currentPage-1}" ${currentPage===1?'disabled':''}>‹</button>`;

  for(let page=startPage;page<=endPage;page++){
    html+=`<button class="page-btn ${page===currentPage?'active':''}" data-page="${page}">${page}</button>`;
  }

  html+=`<button class="page-btn" data-page="${currentPage+1}" ${currentPage===totalPages?'disabled':''}>›</button>`;

  el.innerHTML=html;

  el.querySelectorAll('[data-page]').forEach(btn=>{
    btn.onclick=()=>{
      const page=Number(btn.dataset.page);
      if(!page||page<1||page>totalPages)return;
      currentPage=page;
      draw();
    };
  });
}

function draw(){
  const q=$('search').value.toLowerCase().trim();
  const f=$('filter').value;

  const list=records.filter(r=>{
    const i=activeInvoice(r);
    return `${r.playerName} ${r.parentName} ${r.playerId}`.toLowerCase().includes(q)
      &&(f==='all'||i.status===f);
  });

  const totalPages=Math.max(1,Math.ceil(list.length/pageSize));
  if(currentPage>totalPages)currentPage=totalPages;

  const startIndex=(currentPage-1)*pageSize;
  const visible=list.slice(startIndex,startIndex+pageSize);

  $('rows').innerHTML=visible.length
    ?visible.map(r=>{
      const i=activeInvoice(r);
      return `<tr>
        <td>
          <div class="person">
            <span>
              <b>${esc(r.playerName)}</b>
              <small>${esc(r.playerId)}</small>
            </span>
          </div>
        </td>
        <td>
          <b>${esc(i.label)}</b>
          <small>Jatuh tempo ${esc(i.dueDate||'Saat pendaftaran')}</small>
        </td>
        <td><strong>${money(i.amount)}</strong></td>
        <td>
          <span class="status ${i.status}">
            ${i.status==='paid'?'Lunas':i.status==='overdue'?'Tunggakan':i.status==='unpaid'?'Belum lunas':'Akan datang'}
          </span>
        </td>
        <td>
          <button class="row-action"
            data-player="${esc(r.playerId)}"
            data-month="${esc(i.month)}"
            data-months="${esc(JSON.stringify(r.finance.invoices.filter(x=>x.month!=='initial'&&x.status!=='paid').map(x=>x.month)))}"
            data-paid="${i.status==='paid'?'false':'true'}">
            ${i.status==='paid'?'Batalkan':'Catat pembayaran'}
          </button>
          ${i.status==='paid'
            ?`<a class="receipt" href="/api/admin/finance/receipt?playerId=${encodeURIComponent(r.playerId)}&month=${encodeURIComponent(i.month)}">PDF</a>`
            :''}
        </td>
      </tr>`;
    }).join('')
    :'<tr><td colspan="5" class="empty">Tidak ada invoice sesuai filter.</td></tr>';

  renderPagination(list.length);

  document.querySelectorAll('[data-player]').forEach(b=>{
    b.onclick=async()=>{
      const paid=b.dataset.paid==='true';
      const playerId=b.dataset.player||'';
      const currentMonth=b.dataset.month||'';
      const cell=b.closest('td');

      if(!paid){
        if(!confirm('Batalkan pembayaran untuk invoice ini?')) return;

        b.disabled=true;

        const res=await fetch('/api/admin/finance',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({
            action:'payment',
            playerId,
            month:currentMonth,
            months:[currentMonth],
            paid:false,
            note:''
          })
        });

        const d=await res.json();

        if(!d.success){
          show(d.message||'Gagal membatalkan pembayaran',true);
          b.disabled=false;
          return;
        }

        show('Pembayaran berhasil dibatalkan.');
        load();
        return;
      }

      if(currentMonth==='initial'){
        if(!confirm('Catat pembayaran awal sebesar '+money(
          Number(b.closest('tr')?.querySelector('td:nth-child(3)')?.textContent?.replace(/[^0-9]/g,'')||0)
        )+'?')) return;

        b.disabled=true;

        const res=await fetch('/api/admin/finance',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({
            action:'payment',
            playerId,
            month:'initial',
            paid:true,
            note:'Pembayaran diterima Admin'
          })
        });

        const d=await res.json();

        if(!d.success){
          show(d.message||'Gagal menyimpan pembayaran',true);
          b.disabled=false;
          return;
        }

        show('Pembayaran awal berhasil dicatat.');
        load();
        return;
      }

      const existing=cell?.querySelector('.payment-picker');
      if(existing){
        existing.remove();
        b.disabled=false;
        return;
      }

      let available=[];
      try{
        available=JSON.parse(b.dataset.months||'[]');
      }catch{
        available=[];
      }

      available=Array.from(new Set(
        available.filter(v=>/^\d{4}-\d{2}$/.test(v))
      ));

      if(!available.length){
        show('Tidak ada bulan SPP yang belum lunas.',true);
        return;
      }

      const picker=document.createElement('div');
      picker.className='payment-picker';

      picker.innerHTML=`
        <div class="payment-picker-title">Pilih bulan pembayaran</div>
        <div class="payment-picker-sub">
          Centang semua bulan yang sudah dibayar oleh peserta.
        </div>
        <div class="payment-months">
          ${available.map(m=>`
            <label class="payment-month">
              <input type="checkbox" value="${esc(m)}" ${m===currentMonth?'checked':''}>
              <span>SPP ${esc(m)}</span>
              <strong>${money(config.monthlyTuition)}</strong>
            </label>
          `).join('')}
        </div>
        <div class="payment-total">
          <span>Total pembayaran</span>
          <strong class="payment-total-value">${money(config.monthlyTuition)}</strong>
        </div>
        <label class="payment-note">
          <span>Catatan pembayaran <em>opsional</em></span>
          <input type="text" class="payment-note-input"
            value="Pembayaran diterima Admin"
            placeholder="Contoh: Tunai / Transfer">
        </label>
        <div class="payment-picker-actions">
          <button type="button" class="payment-cancel">Batal</button>
          <button type="button" class="payment-submit">Catat pembayaran</button>
        </div>
      `;

      cell?.appendChild(picker);
      b.disabled=true;

      const checks=[...picker.querySelectorAll('input[type="checkbox"]')];
      const totalEl=picker.querySelector('.payment-total-value');

      const updateTotal=()=>{
        const total=checks.filter(x=>x.checked).length*
          Number(config.monthlyTuition||0);
        totalEl.textContent=money(total);
      };

      checks.forEach(x=>x.addEventListener('change',updateTotal));
      updateTotal();

      picker.querySelector('.payment-cancel').onclick=()=>{
        picker.remove();
        b.disabled=false;
      };

      picker.querySelector('.payment-submit').onclick=async()=>{
        const months=checks.filter(x=>x.checked).map(x=>x.value);

        if(!months.length){
          show('Pilih minimal satu bulan pembayaran.',true);
          return;
        }

        const submit=picker.querySelector('.payment-submit');
        const note=picker.querySelector('.payment-note-input')?.value||'';

        submit.disabled=true;

        try{
          const res=await fetch('/api/admin/finance',{
            method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({
              action:'payment',
              playerId,
              month:months[0],
              months,
              paid:true,
              note
            })
          });

          const d=await res.json();

          if(!d.success){
            show(d.message||'Gagal menyimpan pembayaran',true);
            submit.disabled=false;
            return;
          }

          show(
            `${months.length} bulan berhasil dicatat. Total pemasukan ${money(Number(d.total||0))}.`
          );

          load();
        }catch{
          show('Tidak dapat terhubung ke server.',true);
          submit.disabled=false;
        }
      };
    };
  });
function metrics(){let out=0,attention=0,paid=0,monthly=0;records.forEach(r=>{out+=r.finance.summary.outstanding;const i=r.finance.invoices.find(x=>x.month===month());if(i?.status==='paid'){paid++;monthly+=i.amount}if(r.finance.invoices.some(x=>x.status==='unpaid'||x.status==='overdue'))attention++});$('outstanding').textContent=money(out);$('paidCount').textContent=paid;$('attention').textContent=attention;$('monthly').textContent=money(monthly)}
async function load(){const res=await fetch('/api/admin/finance',{cache:'no-store'}),d=await res.json();if(!d.success)return show(d.message||'Gagal memuat finance',true);records=d.data;config=d.config;setConfig();metrics();draw()}$('configForm').onsubmit=async e=>{e.preventDefault();const res=await fetch('/api/admin/finance',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'config',config:Object.fromEntries(new FormData(e.currentTarget))})}),d=await res.json();show(d.success?'Aturan tagihan berhasil disimpan.':d.message,!d.success);if(d.success){config=d.config;setConfig();load()}};$('refresh').onclick=load;
$('search').oninput=()=>{
  currentPage=1;
  draw();
};
$('filter').onchange=()=>{
  currentPage=1;
  draw();
};
load();
</script>
<style>
:global(body){background:#f3f6f4}.finance{margin-left:278px;min-height:100vh;padding:42px 52px 80px;background:#f3f6f4;color:#15251e}.page-header{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:32px}.crumb,.eyebrow{color:#71857a;font-size:10px;font-weight:900;letter-spacing:.16em}.page-header h1{margin:12px 0 6px;color:#0d2b1e;font-size:54px;letter-spacing:-.06em}.page-header p{margin:0;color:#71857a}.ghost{padding:11px 15px;border:1px solid #d3dfd7;border-radius:9px;background:#fff;color:#315145;font-weight:900;cursor:pointer}.finance-summary{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:12px;margin-bottom:18px}.summary-card{padding:22px;border:1px solid #e0e9e3;border-radius:14px;background:#fff}.summary-card.dark{background:#083c29;color:#fff;border-color:#083c29}.summary-card span{display:block;color:#73867c;font-size:10px;font-weight:900;letter-spacing:.12em}.summary-card.dark span{color:#b8d7c7}.summary-card strong{display:block;margin:12px 0 4px;color:#123c29;font-size:27px;letter-spacing:-.05em}.summary-card.dark strong{color:#ffd866}.summary-card small{color:#94a49b;font-size:11px}.notice{margin:12px 0;padding:12px 15px;border-radius:9px;background:#e5f5e9;color:#217448;font-weight:800;font-size:13px}.notice.error{background:#fff0ef;color:#b54843}.finance-layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:18px}.invoice-panel,.settings-panel{border:1px solid #e0e9e3;border-radius:14px;background:#fff}.invoice-panel{padding:25px}.panel-top{display:flex;justify-content:space-between;align-items:end;gap:18px}.panel-top h2,.settings-panel h2{margin:8px 0 20px;font-size:22px;letter-spacing:-.04em}.filters{display:flex;gap:8px}.filters input,.filters select,.settings-panel input{padding:11px;border:1px solid #d6e1da;border-radius:8px;background:#fbfdfb;color:#173e2c;font:inherit;font-size:12px}.filters input{width:180px}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:700px}th,td{padding:15px 8px;text-align:left;border-bottom:1px solid #e7eee9}th{color:#819189;font-size:10px;letter-spacing:.11em}td{font-size:13px}td small{display:block;margin-top:5px;color:#8d9d95;font-size:11px}.person{display:flex;align-items:center;gap:10px}.avatar{width:31px;height:31px;display:grid;place-items:center;border-radius:9px;background:#e7f2eb;color:#1a7148;font-weight:900}.status{display:inline-flex;padding:6px 8px;border-radius:999px;font-size:10px;font-weight:900}.status.paid{background:#e1f5e9;color:#197443}.status.unpaid{background:#fff4d1;color:#98730c}.status.overdue{background:#ffe7e5;color:#b14b45}.status.upcoming{background:#e7effc;color:#4772ad}.row-action{padding:8px 10px;border:1px solid #bfd5c7;border-radius:7px;background:#fff;color:#286247;font-size:11px;font-weight:900;cursor:pointer}.row-action:hover{border-color:#dcae24}
.payment-picker{
  margin-top:10px;
  padding:14px;
  border:1px solid #d9e6de;
  border-radius:10px;
  background:#f8fbf9;
  min-width:260px;
  box-sizing:border-box;
}
.payment-picker-title{
  font-size:12px;
  font-weight:900;
  color:#123c29;
}
.payment-picker-sub{
  margin-top:4px;
  color:#819189;
  font-size:10px;
  line-height:1.45;
}
.payment-months{
  display:grid;
  gap:6px;
  margin-top:10px;
}
.payment-month{
  display:grid;
  grid-template-columns:18px 1fr auto;
  align-items:center;
  gap:7px;
  padding:9px;
  border:1px solid #e0e9e3;
  border-radius:7px;
  background:#fff;
  color:#315145;
  font-size:11px;
  cursor:pointer;
}
.payment-month input{
  width:16px;
  height:16px;
  accent-color:#0d5a3c;
}
.payment-month strong{
  font-size:10px;
  color:#123c29;
}
.payment-total{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-top:10px;
  padding-top:10px;
  border-top:1px solid #dce7e0;
  color:#71857a;
  font-size:11px;
}
.payment-total strong{
  color:#123c29;
  font-size:14px;
}
.payment-note{
  display:grid;
  gap:5px;
  margin-top:10px;
  color:#62766b;
  font-size:10px;
  font-weight:900;
}
.payment-note em{
  font-style:normal;
  font-weight:500;
  color:#94a49b;
}
.payment-note-input{
  width:100%;
  box-sizing:border-box;
  padding:8px;
  border:1px solid #d6e1da;
  border-radius:7px;
  background:#fff;
  color:#173e2c;
  font:inherit;
  font-size:11px;
}
.payment-picker-actions{
  display:flex;
  gap:7px;
  margin-top:10px;
}
.payment-picker-actions button{
  flex:1;
  padding:9px;
  border-radius:7px;
  font-size:10px;
  font-weight:900;
  cursor:pointer;
}
.payment-cancel{
  border:1px solid #d1ddd5;
  background:#fff;
  color:#62766b;
}
.payment-submit{
  border:0;
  background:#0d5a3c;
  color:#fff;
}
.payment-picker-actions button:disabled{
  opacity:.55;
  cursor:wait;
}

.settings-panel{padding:25px}.settings-panel p{color:#819189;line-height:1.6;font-size:12px}.settings-panel form{display:grid;gap:12px}.settings-panel label{display:grid;gap:6px;color:#62766b;font-size:11px;font-weight:900}.config-total{display:flex;justify-content:space-between;margin:5px 0;padding-top:15px;border-top:1px solid #e4ece7;color:#71857a;font-size:12px}.config-total strong{color:#123c29;font-size:15px}.save{padding:12px;border:0;border-radius:8px;background:#dcae24;color:#192a1e;font-weight:900;cursor:pointer}.finance-rule{margin-top:22px;padding:13px;border-radius:9px;background:#f1f6f2}.finance-rule b{font-size:11px}.finance-rule p{margin:5px 0 0;font-size:11px}.empty{padding:35px;text-align:center;color:#8a9a92}@media(max-width:1100px){.finance-summary{grid-template-columns:repeat(2,1fr)}.finance-layout{grid-template-columns:1fr}}@media(max-width:800px){.finance{margin-left:0;padding:86px 18px 50px}.page-header{display:block}.ghost{margin-top:18px}.panel-top{display:block}.filters{margin-bottom:16px}.filters input{flex:1}.filters select{flex:1}}@media(max-width:500px){.finance-summary{grid-template-columns:1fr}.page-header h1{font-size:44px}.filters{display:grid;grid-template-columns:1fr}}
</style>

<style>
@media(max-width:800px){
  html,
  body{
    max-width:100%;
    overflow-x:hidden;
  }

  .finance{
    width:100%;
    max-width:100vw;
    min-width:0;
    margin-left:0;
    padding:86px 16px 50px;
    box-sizing:border-box;
    overflow-x:hidden;
  }

  .finance *,
  .finance-layout,
  .invoice-panel,
  .settings-panel,
  .settings-panel form,
  .filters{
    min-width:0;
    max-width:100%;
    box-sizing:border-box;
  }

  .finance-layout{
    display:block;
    width:100%;
  }

  .invoice-panel,
  .settings-panel{
    width:100%;
  }

  .settings-panel{
    margin-top:18px;
    overflow:hidden;
  }

  .invoice-panel{
    padding:18px;
    overflow:hidden;
  }

  .panel-top{
    display:block;
    width:100%;
  }

  .panel-top h2{
    margin-bottom:16px;
  }

  .filters{
    display:grid;
    grid-template-columns:minmax(0,1fr);
    width:100%;
  }

  .filters input,
  .filters select,
  .settings-panel input,
  .settings-panel button{
    width:100%;
    max-width:100%;
    min-width:0;
    box-sizing:border-box;
  }

  .table-wrap{
    width:100%;
    max-width:100%;
    overflow:hidden;
  }

  table{
    width:100%;
    max-width:100%;
    min-width:0;
  }

  thead{
    display:none;
  }

  tbody,
  tr,
  td{
    display:block;
    width:100%;
    max-width:100%;
    min-width:0;
    box-sizing:border-box;
  }

  tr{
    padding:16px 0;
    border-bottom:1px solid #e7eee9;
    overflow:hidden;
  }

  td{
    border:0;
    padding:5px 0;
    overflow:hidden;
  }

  td:first-child{
    padding-bottom:12px;
  }

  td:nth-child(2),
  td:nth-child(3),
  td:nth-child(4){
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;

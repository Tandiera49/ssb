---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { getUserBySession } from '../../lib/authStore';
const token = Astro.cookies.get('ssb_session')?.value || '';
const user = token ? await getUserBySession(Astro.locals, token) : null;
if (!user || user.role !== 'admin') return Astro.redirect('/login?redirect=/admin/finance');
---
<Layout title="Finance Desk — SSB Bhayangkara Junior 2018">
  <AdminNav />
  <main class="finance" id="main-content">
    <header class="page-header"><div><div class="crumb">OPERATIONS / FINANCE DESK</div><h1>Keuangan</h1><p>Tagihan, pembayaran manual, dan laporan arus kas peserta.</p></div><button class="ghost" id="refresh">↻ Refresh data</button></header>
    <section class="finance-summary"><div class="summary-card dark"><span>OUTSTANDING</span><strong id="outstanding">Rp0</strong><small>Total tagihan belum lunas</small></div><div class="summary-card"><span>TERCATAT BULAN INI</span><strong id="paidCount">0</strong><small>Invoice dengan status lunas</small></div><div class="summary-card"><span>PERLU DITINDAK</span><strong id="attention">0</strong><small>Belum lunas atau tunggakan</small></div><div class="summary-card"><span>ESTIMASI KAS BULAN INI</span><strong id="monthly">Rp0</strong><small>Berdasarkan SPP aktif</small></div></section>
    <div id="notice" class="notice" hidden></div>
    <section class="finance-layout"><article class="invoice-panel"><div class="panel-top"><div><div class="eyebrow">INVOICE REGISTER</div><h2>Daftar tagihan peserta</h2></div><div class="filters"><input id="search" type="search" placeholder="Cari siswa / wali" /><select id="filter"><option value="all">Semua invoice</option><option value="unpaid">Belum lunas</option><option value="overdue">Tunggakan</option><option value="paid">Sudah lunas</option></select></div></div><div class="table-wrap"><table><thead><tr><th>PESERTA</th><th>INVOICE AKTIF</th><th>NOMINAL</th><th>STATUS</th><th></th></tr></thead><tbody id="rows"><tr><td colspan="5" class="empty">Memuat data peserta...</td></tr></tbody></table></div><div id="pagination" class="pagination"></div></article><aside class="settings-panel"><div class="eyebrow">BILLING SETTINGS</div><h2>Aturan tagihan</h2><p>Nominal ini dipakai untuk membentuk invoice baru. Pembayaran dicatat manual oleh Admin.</p><form id="configForm"><label>Administrasi<input name="administration" type="number" min="0" /></label><label>Jersey & perlengkapan<input name="jersey" type="number" min="0" /></label><label>SPP awal<input name="initialTuition" type="number" min="0" /></label><label>SPP bulanan<input name="monthlyTuition" type="number" min="0" /></label><label>Jatuh tempo setiap tanggal<input name="dueDay" type="number" min="1" max="28" /></label><div class="config-total"><span>Total biaya awal</span><strong id="initialTotal">Rp0</strong></div><button class="save" type="submit">Simpan aturan</button></form><div class="finance-rule"><b>Catatan operasional</b><p>Website tidak memproses pembayaran. Setelah menerima pembayaran offline, tandai invoice sebagai lunas dan cetak tanda terima jika diperlukan.</p></div></aside></section>
  </main>
</Layout>
<script is:inline>
const $=id=>document.getElementById(id);let records=[],config={};const money=n=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(Number(n||0));const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));const month=()=>{const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`};
function show(text,error=false){$('notice').hidden=!text;$('notice').textContent=text;$('notice').className=`notice ${error?'error':''}`}
function setConfig(){['administration','jersey','initialTuition','monthlyTuition','dueDay'].forEach(k=>{const el=document.querySelector(`[name=${k}]`);if(el)el.value=config[k]??0});$('initialTotal').textContent=money(+config.administration+(+config.jersey)+(+config.initialTuition))}
function activeInvoice(row){
  const initial=row.finance.invoices.find(x=>x.month==='initial');
  if(initial && initial.status!=='paid') return initial;
  const current=row.finance.invoices.find(x=>x.month===month());
  if(current) return current;
  return row.finance.invoices.find(x=>x.month!=='initial' && x.status!=='paid')||initial||row.finance.invoices[0];
}
let currentPage=1;
const pageSize=5;

function renderPagination(total){
  const el=$('pagination');
  if(!el)return;

  const totalPages=Math.max(1,Math.ceil(total/pageSize));

  if(total<=pageSize){
    el.innerHTML='';
    return;
  }

  if(currentPage>totalPages)currentPage=totalPages;

  let startPage=Math.max(1,currentPage-2);
  let endPage=Math.min(totalPages,startPage+4);

  if(endPage-startPage<4){
    startPage=Math.max(1,endPage-4);
  }

  let html='';

  html+=`<button class="page-btn" data-page="${currentPage-1}" ${currentPage===1?'disabled':''}>‹</button>`;

  for(let page=startPage;page<=endPage;page++){
    html+=`<button class="page-btn ${page===currentPage?'active':''}" data-page="${page}">${page}</button>`;
  }

  html+=`<button class="page-btn" data-page="${currentPage+1}" ${currentPage===totalPages?'disabled':''}>›</button>`;

  el.innerHTML=html;

  el.querySelectorAll('[data-page]').forEach(btn=>{
    btn.onclick=()=>{
      const page=Number(btn.dataset.page);
      if(!page||page<1||page>totalPages)return;
      currentPage=page;
      draw();
    };
  });
}

function draw(){
  const q=$('search').value.toLowerCase().trim();
  const f=$('filter').value;

  const list=records.filter(r=>{
    const i=activeInvoice(r);
    return `${r.playerName} ${r.parentName} ${r.playerId}`.toLowerCase().includes(q)
      &&(f==='all'||i.status===f);
  });

  const totalPages=Math.max(1,Math.ceil(list.length/pageSize));
  if(currentPage>totalPages)currentPage=totalPages;

  const startIndex=(currentPage-1)*pageSize;
  const visible=list.slice(startIndex,startIndex+pageSize);

  $('rows').innerHTML=visible.length
    ?visible.map(r=>{
      const i=activeInvoice(r);

      const unpaidMonths=r.finance.invoices.filter(
        x=>x.month!=='initial'&&x.status!=='paid'
      );

      const paymentChecks=i.status!=='paid'&&unpaidMonths.length
        ?`
          <div class="payment-checks">
            <div class="payment-check-title">Pilih bulan yang dibayar</div>
            ${unpaidMonths.map(x=>`
              <label>
                <input
                  type="checkbox"
                  class="payment-month"
                  value="${esc(x.month)}"
                  ${x.month===i.month?'checked':''}
                >
                <span>${esc(x.label)}</span>
              </label>
            `).join('')}
          </div>
        `
        :'';

      return `<tr>
        <td>
          <div class="person">
            <span>
              <b>${esc(r.playerName)}</b>
              <small>${esc(r.playerId)}</small>
            </span>
          </div>
        </td>

        <td>
          <b>${esc(i.label)}</b>
          <small>Jatuh tempo ${esc(i.dueDate||'Saat pendaftaran')}</small>
        </td>

        <td><strong>${money(i.amount)}</strong></td>

        <td>
          <span class="status ${i.status}">
            ${i.status==='paid'
              ?'Lunas'
              :i.status==='overdue'
                ?'Tunggakan'
                :i.status==='unpaid'
                  ?'Belum lunas'
                  :'Akan datang'}
          </span>
        </td>

        <td>
          ${paymentChecks}

          <button
            class="row-action"
            data-player="${esc(r.playerId)}"
            data-month="${esc(i.month)}"
            data-paid="${i.status==='paid'?'true':'false'}">
            ${i.status==='paid'?'Batalkan':'Catat pembayaran'}
          </button>

          ${i.status==='paid'
            ?`<a class="receipt" href="/api/admin/finance/receipt?playerId=${encodeURIComponent(r.playerId)}&month=${encodeURIComponent(i.month)}">PDF</a>`
            :''}
        </td>
      </tr>`;
    }).join('')
    :'<tr><td colspan="5" class="empty">Tidak ada invoice sesuai filter.</td></tr>';

  renderPagination(list.length);

  document.querySelectorAll('[data-player]').forEach(b=>{
    b.onclick=async()=>{
      b.disabled=true;

      const paid=b.dataset.paid==='true';
      const cell=b.closest('td');

      if(paid){
        const confirmed=confirm(
          `Batalkan pembayaran ${b.dataset.month}?`
        );

        if(!confirmed){
          b.disabled=false;
          return;
        }
      }

      const months=paid
        ?[b.dataset.month]
        :[...cell.querySelectorAll('.payment-month:checked')]
          .map(input=>input.value);

      if(!months.length){
        show('Pilih minimal satu bulan SPP.',true);
        b.disabled=false;
        return;
      }

      try{
        const res=await fetch('/api/admin/finance',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({
            action:'payment',
            playerId:b.dataset.player,
            month:months[0],
            months,
            paid,
            note:'Pembayaran diterima Admin'
          })
        });

        const d=await res.json();

        if(!d.success){
          show(d.message||'Gagal menyimpan pembayaran',true);
          b.disabled=false;
          return;
        }

        const total=Number(d.total||0);

        show(
          paid
            ?'Pembayaran dibatalkan.'
            :`${months.length} bulan berhasil dicatat. Total pemasukan ${money(total)}.`
        );

        await load();
      }catch{
        show('Tidak dapat terhubung ke server.',true);
        b.disabled=false;
      }
    };
  });
}

function metrics(){let out=0,attention=0,paid=0,monthly=0;records.forEach(r=>{out+=r.finance.summary.outstanding;const i=r.finance.invoices.find(x=>x.month===month());if(i?.status==='paid'){paid++;monthly+=i.amount}if(r.finance.invoices.some(x=>x.status==='unpaid'||x.status==='overdue'))attention++});$('outstanding').textContent=money(out);$('paidCount').textContent=paid;$('attention').textContent=attention;$('monthly').textContent=money(monthly)}
async function load(){const res=await fetch('/api/admin/finance',{cache:'no-store'}),d=await res.json();if(!d.success)return show(d.message||'Gagal memuat finance',true);records=d.data;config=d.config;setConfig();metrics();draw()}$('configForm').onsubmit=async e=>{e.preventDefault();const res=await fetch('/api/admin/finance',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'config',config:Object.fromEntries(new FormData(e.currentTarget))})}),d=await res.json();show(d.success?'Aturan tagihan berhasil disimpan.':d.message,!d.success);if(d.success){config=d.config;setConfig();load()}};$('refresh').onclick=load;
$('search').oninput=()=>{
  currentPage=1;
  draw();
};
$('filter').onchange=()=>{
  currentPage=1;
  draw();
};
load();
</script>
<style>

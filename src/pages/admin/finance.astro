.row-action{padding:8px 10px;border:1px solid #bfd5c7;border-radius:7px;background:#fff;color:#286247;font-size:11px;font-weight:900;cursor:pointer}.row-action:hover{border-color:#dcae24}.settings-panel{padding:25px}.settings-panel p{color:#819189;line-height:1.6;font-size:12px}.settings-panel form{display:grid;gap:12px}.settings-panel label{display:grid;gap:6px;color:#62766b;font-size:11px;font-weight:900}.config-total{display:flex;justify-content:space-between;margin:5px 0;padding-top:15px;border-top:1px solid #e4ece7;color:#71857a;font-size:12px}.config-total strong{color:#123c29;font-size:15px}.save{padding:12px;border:0;border-radius:8px;background:#dcae24;color:#192a1e;font-weight:900;cursor:pointer}.finance-rule{margin-top:22px;padding:13px;border-radius:9px;background:#f1f6f2}.finance-rule b{font-size:11px}.finance-rule p{margin:5px 0 0;font-size:11px}.empty{padding:35px;text-align:center;color:#8a9a92}@media(max-width:1100px){.finance-summary{grid-template-columns:repeat(2,1fr)}.finance-layout{grid-template-columns:1fr}}@media(max-width:800px){.finance{margin-left:0;padding:86px 18px 50px}.page-header{display:block}.ghost{margin-top:18px}.panel-top{display:block}.filters{margin-bottom:16px}.filters input{flex:1}.filters select{flex:1}}@media(max-width:500px){.finance-summary{grid-template-columns:1fr}.page-header h1{font-size:44px}.filters{display:grid;grid-template-columns:1fr}}
</style>


th,td{padding:15px 8px;text-align:left;border-bottom:1px solid #e7eee9}th{color:#819189;font-size:10px;letter-spacing:.11em}td{font-size:13px}td small{display:block;margin-top:5px;color:#8d9d95;font-size:11px}.person{display:flex;align-items:center;gap:10px}.avatar{width:31px;height:31px;display:grid;place-items:center;border-radius:9px;background:#e7f2eb;color:#1a7148;font-weight:900}.status{display:inline-flex;padding:6px 8px;border-radius:999px;font-size:10px;font-weight:900}.status.paid{background:#e1f5e9;color:#197443}.status.unpaid{background:#fff4d1;color:#98730c}.status.overdue{background:#ffe7e5;color:#b14b45}.status.upcoming{background:#e7effc;color:#4772ad}.payment-checks{
  display:grid;

<style is:global>
/* FINANCE MOBILE - clean invoice cards */
@media (max-width: 500px) {
  .invoice-panel {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .invoice-panel .table-wrap {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .invoice-panel table {
    width: 100%;
    min-width: 0 !important;
    max-width: 100%;
    table-layout: fixed;
  }

  .invoice-panel thead {
    display: none;
  }

  .invoice-panel tbody {
    display: block;
    width: 100%;
  }

  .invoice-panel tbody tr {
    display: block;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 18px 0;
    border-bottom: 1px solid #e7eee9;
  }

  .invoice-panel tbody td {
    display: block !important;
    width: 100% !important;
    max-width: 100%;
    min-width: 0 !important;
    box-sizing: border-box;
    padding: 5px 0;
    border: 0;
    overflow: hidden;
  }

  /* Identitas anak */
  .invoice-panel tbody td:first-child {
    margin-bottom: 8px;
  }

  .invoice-panel tbody td:first-child .person {
    display: flex;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    align-items: flex-start;
    gap: 10px;
  }

  .invoice-panel tbody td:first-child .person > span:last-child {
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
  }

  .invoice-panel tbody td:first-child .person b {
    display: block;
    font-size: 16px;
    line-height: 1.3;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .invoice-panel tbody td:first-child .person small {
    display: block;
    margin-top: 4px;
    font-size: 10px;
    line-height: 1.35;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  /* Invoice */
  .invoice-panel tbody td:nth-child(2) {
    padding: 6px 0;
  }

  .invoice-panel tbody td:nth-child(2) b,
  .invoice-panel tbody td:nth-child(2) small {
    display: block;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .invoice-panel tbody td:nth-child(2) b {
    font-size: 14px;
    line-height: 1.35;
  }

  /* Nominal */
  .invoice-panel tbody td:nth-child(3) {
    display: flex !important;
    width: 100% !important;

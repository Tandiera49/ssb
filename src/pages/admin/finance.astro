---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { getUserBySession } from '../../lib/authStore';

const token = Astro.cookies.get('ssb_session')?.value || '';
const user = token ? await getUserBySession(Astro.locals, token) : null;

if (!user || user.role !== 'admin') {
  return Astro.redirect('/login?redirect=/admin/finance');
}
---

<Layout title="Finance Desk — SSB Bhayangkara Junior 2018">
  <AdminNav />
  <main class="finance" id="main-content">
    <header class="page-header">
      <div>
        <div class="crumb">OPERATIONS / FINANCE DESK</div>
        <h1>Keuangan</h1>
        <p>Tagihan, pembayaran manual, dan laporan arus kas peserta.</p>
      </div>
      <button class="ghost" id="refresh">↻ Refresh data</button>
    </header>

    <section class="finance-summary">
      <div class="summary-card dark">
        <span>OUTSTANDING</span>
        <strong id="outstanding">Rp0</strong>
        <small>Total tagihan belum lunas</small>
      </div>
      <div class="summary-card">
        <span>TERCATAT BULAN INI</span>
        <strong id="paidCount">0</strong>
        <small>Invoice dengan status lunas</small>
      </div>
      <div class="summary-card">
        <span>PERLU DITINDAK</span>
        <strong id="attention">0</strong>
        <small>Belum lunas atau tunggakan</small>
      </div>
      <div class="summary-card">
        <span>ESTIMASI KAS BULAN INI</span>
        <strong id="monthly">Rp0</strong>
        <small>Berdasarkan SPP aktif</small>
      </div>
    </section>

    <div id="notice" class="notice" hidden></div>

    <section class="finance-layout">
      <article class="invoice-panel">
        <div class="panel-top">
          <div>
            <div class="eyebrow">INVOICE REGISTER</div>
            <h2>Daftar tagihan peserta</h2>
          </div>
          <div class="filters">
            <input id="search" type="search" placeholder="Cari siswa / wali" />
            <select id="filter">
              <option value="all">Semua invoice</option>
              <option value="unpaid">Belum lunas</option>
              <option value="overdue">Tunggakan</option>
              <option value="paid">Sudah lunas</option>
            </select>
          </div>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>PESERTA</th>
                <th>INVOICE AKTIF</th>
                <th>NOMINAL</th>
                <th>STATUS</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="rows">
              <tr>
                <td colspan="5" class="empty">Memuat data peserta...</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div id="pagination" class="pagination"></div>
      </article>

      <aside class="settings-panel">
        <div class="eyebrow">BILLING SETTINGS</div>
        <h2>Aturan tagihan</h2>
        <p>Nominal ini dipakai untuk membentuk invoice baru. Pembayaran dicatat manual oleh Admin.</p>
        <form id="configForm">
          <label>Administrasi<input name="administration" type="number" min="0" /></label>
          <label>Jersey & perlengkapan<input name="jersey" type="number" min="0" /></label>
          <label>SPP awal<input name="initialTuition" type="number" min="0" /></label>
          <label>SPP bulanan<input name="monthlyTuition" type="number" min="0" /></label>
          <label>Jatuh tempo setiap tanggal<input name="dueDay" type="number" min="1" max="28" /></label>
          <div class="config-total">
            <span>Total biaya awal</span>
            <strong id="initialTotal">Rp0</strong>
          </div>
          <button class="save" type="submit">Simpan aturan</button>
        </form>
        <div class="finance-rule">
          <b>Catatan operasional</b>
          <p>Website tidak memproses pembayaran. Setelah menerima pembayaran offline, tandai invoice sebagai lunas dan cetak tanda terima jika diperlukan.</p>
        </div>
      </aside>
    </section>
  </main>
</Layout>

<script is:inline>
  const $ = id => document.getElementById(id);
  let records = [], config = {};

  const money = n => new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    maximumFractionDigits: 0
  }).format(Number(n || 0));

  const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
  }[c]));

  const month = () => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  };

  function show(text, error = false) {
    $('notice').hidden = !text;
    $('notice').textContent = text;
    $('notice').className = `notice ${error ? 'error' : ''}`;
  }

  function setConfig() {
    ['administration', 'jersey', 'initialTuition', 'monthlyTuition', 'dueDay'].forEach(k => {
      const el = document.querySelector(`[name=${k}]`);
      if (el) el.value = config[k] ?? 0;
    });

    const admin = Number(config.administration || 0);
    const jersey = Number(config.jersey || 0);
    const initT = Number(config.initialTuition || 0);
    $('initialTotal').textContent = money(admin + jersey + initT);
  }

  function activeInvoice(row) {
    const initial = row.finance.invoices.find(x => x.month === 'initial');
    if (initial && initial.status !== 'paid') return initial;

    const current = row.finance.invoices.find(x => x.month === month());
    if (current) return current;

    return row.finance.invoices.find(x => x.month !== 'initial' && x.status !== 'paid') || initial || row.finance.invoices[0];
  }

  let currentPage = 1;
  const pageSize = 5;

  function renderPagination(total) {
    const el = $('pagination');
    if (!el) return;

    const totalPages = Math.max(1, Math.ceil(total / pageSize));
    if (total <= pageSize) {
      el.innerHTML = '';
      return;
    }

    if (currentPage > totalPages) currentPage = totalPages;

    let startPage = Math.max(1, currentPage - 2);
    let endPage = Math.min(totalPages, startPage + 4);

    if (endPage - startPage < 4) {
      startPage = Math.max(1, endPage - 4);
    }

    let html = '';
    html += `<button class="page-btn" data-page="${currentPage - 1}" ${currentPage === 1 ? 'disabled' : ''}>‹</button>`;

    for (let page = startPage; page <= endPage; page++) {
      html += `<button class="page-btn ${page === currentPage ? 'active' : ''}" data-page="${page}">${page}</button>`;
    }

    html += `<button class="page-btn" data-page="${currentPage + 1}" ${currentPage === totalPages ? 'disabled' : ''}>›</button>`;
    el.innerHTML = html;

    el.querySelectorAll('[data-page]').forEach(btn => {
      btn.onclick = () => {
        const page = Number(btn.dataset.page);
        if (!page || page < 1 || page > totalPages) return;
        currentPage = page;
        draw();
      };
    });
  }

  function draw() {
    const q = $('search').value.toLowerCase().trim();
    const f = $('filter').value;

    const list = records.filter(r => {
      const i = activeInvoice(r);
      return `${r.playerName} ${r.parentName} ${r.playerId}`.toLowerCase().includes(q) &&
             (f === 'all' || i.status === f);
    });

    const totalPages = Math.max(1, Math.ceil(list.length / pageSize));
    if (currentPage > totalPages) currentPage = totalPages || 1;

    const startIndex = (currentPage - 1) * pageSize;
    const visible = list.slice(startIndex, startIndex + pageSize);

    $('rows').innerHTML = visible.length ? visible.map(r => {
      const i = activeInvoice(r);

      // Ambil seluruh bulan selain tagihan awal yang belum lunas
      const unpaidMonths = r.finance.invoices.filter(
  x => x.month !== 'initial' && ['unpaid', 'overdue', 'upcoming'].includes(x.status)
);

      // 1. Checklist SPP
      const paymentChecks = unpaidMonths.length ? `
        <div class="payment-checks">
          <div class="payment-check-title">Pilih bulan SPP yang dibayar</div>
          ${unpaidMonths.map((x, index) => `
            <label>
              <input type="checkbox" class="payment-month" value="${esc(x.month)}" ${index === 0 ? 'checked' : ''}>
              <span>${esc(x.label)}</span>
            </label>
          `).join('')}
        </div>
      ` : '';

      // 2. Tombol Catat Pembayaran
      let submitButton = '';
      if (i.month === 'initial' && i.status !== 'paid') {
        submitButton = `
          <button class="row-action action-btn payment-submit" data-player="${esc(r.playerId)}" data-month="initial" data-paid="false">
            Catat pembayaran
          </button>
        `;
      } else if (unpaidMonths.length > 0) {
        submitButton = `
          <button class="row-action action-btn payment-submit" data-player="${esc(r.playerId)}" data-month="${esc(unpaidMonths[0].month)}" data-paid="false">
            Catat pembayaran
          </button>
        `;
      }

      // 3. Tombol Batalkan dan Download PDF (Muncul jika tagihan utama lunas)
      const cancelButton = i.status === 'paid' ? `
        <button class="row-action action-btn" data-player="${esc(r.playerId)}" data-month="${esc(i.month)}" data-paid="true">
          Batalkan
        </button>
      ` : '';

      const pdfLink = i.status === 'paid' ? `
        <a class="receipt" href="/api/admin/finance/receipt?playerId=${encodeURIComponent(r.playerId)}&month=${encodeURIComponent(i.month)}">PDF</a>
      ` : '';

      const statusText = i.status === 'paid' ? 'Lunas' : i.status === 'overdue' ? 'Tunggakan' : i.status === 'unpaid' ? 'Belum lunas' : 'Akan datang';

      // 4. Render Row
      return `
        <tr>
          <td>
            <div class="person">
              <span>
                <b>${esc(r.playerName)}</b>
                <small>${esc(r.playerId)}</small>
              </span>
            </div>
          </td>
          <td>
            <b>${esc(i.label)}</b>
            <small>Jatuh tempo ${esc(i.dueDate || 'Saat pendaftaran')}</small>
          </td>
          <td><strong>${money(i.amount)}</strong></td>
          <td>
            <span class="status ${i.status}">
              ${statusText}
            </span>
          </td>
          <td>
            <div class="payment-actions">
              ${paymentChecks}
              ${submitButton}
              ${(cancelButton || pdfLink) ? `
                <div class="payment-links">
                  ${cancelButton}
                  ${pdfLink}
                </div>
              ` : ''}
            </div>
          </td>
        </tr>
      `;
    }).join('') : '<tr><td colspan="5" class="empty">Tidak ada invoice sesuai filter.</td></tr>';

    renderPagination(list.length);

    document.querySelectorAll('.action-btn').forEach(b => {
      b.onclick = async () => {
        b.disabled = true;
        const paid = b.dataset.paid === 'true';
        const cell = b.closest('td');

        if (paid) {
          const confirmed = confirm(`Batalkan pembayaran ${b.dataset.month}?`);
          if (!confirmed) {
            b.disabled = false;
            return;
          }
        }

        let months = [b.dataset.month];
        if (!paid && b.dataset.month !== 'initial') {
          months = [...cell.querySelectorAll('.payment-month:checked')].map(input => input.value).filter(Boolean);
          months = Array.from(new Set(months));

          if (!months.length) {
            show('Pilih minimal satu bulan SPP.', true);
            b.disabled = false;
            return;
          }
        }

        const note = prompt('Catatan pembayaran (opsional):', 'Pembayaran diterima Admin');
        if (note === null) {
          b.disabled = false;
          return;
        }

        try {
          const res = await fetch('/api/admin/finance', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'payment',
              playerId: b.dataset.player,
              month: months[0],
              months,
              paid,
              note
            })
          });

          const d = await res.json();
          if (!d.success) {
            show(d.message || 'Gagal menyimpan pembayaran', true);
            b.disabled = false;
            return;
          }

          const total = Number(d.total || 0);
          show(paid ? 'Pembayaran dibatalkan.' : `${months.length} bulan berhasil dicatat. Total pemasukan ${money(total)}.`);
          await load();
        } catch {
          show('Tidak dapat terhubung ke server.', true);
          b.disabled = false;
        }
      };
    });
  }

  function metrics() {
    let out = 0, attention = 0, paid = 0, monthly = 0;
    records.forEach(r => {
      out += r.finance.summary.outstanding;
      const i = r.finance.invoices.find(x => x.month === month());
      if (i?.status === 'paid') {
        paid++;
        monthly += i.amount;
      }
      if (r.finance.invoices.some(x => x.status === 'unpaid' || x.status === 'overdue')) attention++;
    });

    $('outstanding').textContent = money(out);
    $('paidCount').textContent = paid;
    $('attention').textContent = attention;
    $('monthly').textContent = money(monthly);
  }

  async function load() {
    try {
      const res = await fetch('/api/admin/finance', { cache: 'no-store' });
      const d = await res.json();
      if (!d.success) return show(d.message || 'Gagal memuat finance', true);

      records = d.data;
      config = d.config;
      setConfig();
      metrics();
      draw();
    } catch(e) {
      show('Gagal menghubungi server.', true);
    }
  }

  $('configForm').onsubmit = async e => {
    e.preventDefault();
    const btn = e.currentTarget.querySelector('button[type="submit"]');
    btn.disabled = true;
    try {
      const res = await fetch('/api/admin/finance', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'config',
          config: Object.fromEntries(new FormData(e.currentTarget))
        })
      });
      const d = await res.json();
      show(d.success ? 'Aturan tagihan berhasil disimpan.' : d.message, !d.success);
      if (d.success) {
        config = d.config;
        setConfig();
        await load();
      }
    } catch(err) {
      show('Gagal menyimpan aturan.', true);
    }
    btn.disabled = false;
  };

  $('refresh').onclick = load;
  $('search').oninput = () => { currentPage = 1; draw(); };
  $('filter').onchange = () => { currentPage = 1; draw(); };

  load();
</script>

<style is:global>
  /* GLOBAL LAYOUT */
  body { background: #f3f6f4; }
  .finance {
    margin-left: 278px;
    min-height: 100vh;
    padding: 42px 52px 80px;
    background: #f3f6f4;
    color: #15251e;
  }

  /* HEADER */
  .page-header { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 32px; }
  .crumb, .eyebrow { color: #71857a; font-size: 10px; font-weight: 900; letter-spacing: .16em; }
  .page-header h1 { margin: 12px 0 6px; color: #0d2b1e; font-size: 54px; letter-spacing: -.06em; }
  .page-header p { margin: 0; color: #71857a; }
  .ghost { padding: 11px 15px; border: 1px solid #d3dfd7; border-radius: 9px; background: #fff; color: #315145; font-weight: 900; cursor: pointer; }

  /* SUMMARY METRICS */
  .finance-summary { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); gap: 12px; margin-bottom: 18px; }
  .summary-card { padding: 22px; border: 1px solid #e0e9e3; border-radius: 14px; background: #fff; }
  .summary-card.dark { background: #083c29; color: #fff; border-color: #083c29; }
  .summary-card span { display: block; color: #73867c; font-size: 10px; font-weight: 900; letter-spacing: .12em; }
  .summary-card.dark span { color: #b8d7c7; }
  .summary-card strong { display: block; margin: 12px 0 4px; color: #123c29; font-size: 27px; letter-spacing: -.05em; }
  .summary-card.dark strong { color: #ffd866; }
  .summary-card small { color: #94a49b; font-size: 11px; }

  /* NOTICES */
  .notice { margin: 12px 0; padding: 12px 15px; border-radius: 9px; background: #e5f5e9; color: #217448; font-weight: 800; font-size: 13px; }
  .notice.error { background: #fff0ef; color: #b54843; }

  /* MAIN LAYOUT (DESKTOP) */
  .finance-layout { display: grid; grid-template-columns: minmax(0, 1fr) 310px; gap: 18px; }
  .invoice-panel, .settings-panel { border: 1px solid #e0e9e3; border-radius: 14px; background: #fff; }
  .invoice-panel { padding: 25px; overflow: hidden; }
  .panel-top { display: flex; justify-content: space-between; align-items: end; gap: 18px; width: 100%; }
  .panel-top h2, .settings-panel h2 { margin: 8px 0 20px; font-size: 22px; letter-spacing: -.04em; }

  /* FILTERS */
  .filters { display: flex; gap: 8px; }
  .filters input, .filters select, .settings-panel input { padding: 11px; border: 1px solid #d6e1da; border-radius: 8px; background: #fbfdfb; color: #173e2c; font: inherit; font-size: 12px; }
  .filters input { width: 180px; }

  /* TABLES & DYNAMIC ROWS */
  .table-wrap { overflow: auto; width: 100%; max-width: 100%; }
  table { width: 100%; border-collapse: collapse; min-width: 700px; }
  th, td { padding: 15px 8px; text-align: left; border-bottom: 1px solid #e7eee9; }
  th { color: #819189; font-size: 10px; letter-spacing: .11em; }
  td { font-size: 13px; overflow: hidden; vertical-align: top; }
  td small { display: block; margin-top: 5px; color: #8d9d95; font-size: 11px; }

  .person { display: flex; align-items: center; gap: 10px; }
  .person b { display: block; line-height: 1.3; overflow-wrap: anywhere; word-break: break-word; }

  .status { display: inline-flex; padding: 6px 8px; border-radius: 999px; font-size: 10px; font-weight: 900; }
  .status.paid { background: #e1f5e9; color: #197443; }
  .status.unpaid { background: #fff4d1; color: #98730c; }
  .status.overdue { background: #ffe7e5; color: #b14b45; }
  .status.upcoming { background: #e7effc; color: #4772ad; }

  /* PAYMENT CONTROLS */
  .payment-checks { display: grid; gap: 5px; margin-bottom: 8px; width: 100%; }
  .payment-check-title { margin-bottom: 2px; color: #71857a; font-size: 9px; font-weight: 900; letter-spacing: .04em; }
  .payment-checks label { display: flex; align-items: center; gap: 7px; padding: 6px 8px; border: 1px solid #dbe6df; border-radius: 7px; background: #f8fbf9; color: #52685d; font-size: 10px; font-weight: 800; cursor: pointer; }
  .payment-checks label:hover { border-color: #bfd5c7; background: #f3f8f4; }
  .payment-checks input { margin: 0; accent-color: #286247; }

  .payment-actions { display: flex !important; flex-direction: column !important; align-items: stretch; gap: 10px; min-width: 170px; width: 100% !important; }

  .row-action { padding: 8px 10px; border: 1px solid #bfd5c7; border-radius: 7px; background: #fff; color: #286247; font-size: 11px; font-weight: 900; cursor: pointer; width: 100%; box-sizing: border-box; min-height: 38px; }
  .row-action:hover { border-color: #dcae24; }
  .row-action:disabled { opacity: 0.5; cursor: not-allowed; }

  /* TOMBOL KHUSUS CATAT PEMBAYARAN */
  .payment-submit { background: #083c29 !important; color: #ffd866 !important; border: 1px solid #083c29 !important; font-weight: 900; padding: 12px; border-radius: 8px; text-align: center; }
  .payment-submit:hover { background: #0d5239 !important; border-color: #0d5239 !important; color: #fff !important; }

  .payment-links { display: flex; align-items: center; gap: 7px; width: 100%; }
  .payment-links .row-action { flex: 1; }
  .payment-links .receipt { display: inline-flex; align-items: center; justify-content: center; min-height: 38px; padding: 0 10px; border: 1px solid #d6e1da; border-radius: 7px; background: #fff; color: #286247; font-size: 11px; font-weight: 900; text-decoration: none; box-sizing: border-box; }
  .payment-links .receipt:hover { border-color: #dcae24; }
  .empty { padding: 35px; text-align: center; color: #8a9a92; }

  /* PAGINATION */
  .pagination { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 18px 0 2px; flex-wrap: wrap; }
  .page-btn { min-width: 34px; height: 34px; padding: 0 9px; border: 1px solid #d3dfd7; border-radius: 8px; background: #fff; color: #315145; font-size: 12px; font-weight: 900; cursor: pointer; }
  .page-btn:hover:not(:disabled) { border-color: #dcae24; }
  .page-btn.active { background: #083c29; border-color: #083c29; color: #ffd866; }
  .page-btn:disabled { opacity: .4; cursor: not-allowed; }

  /* SETTINGS PANEL */
  .settings-panel { padding: 25px; }
  .settings-panel p { color: #819189; line-height: 1.6; font-size: 12px; max-width: 100%; overflow-wrap: anywhere; }
  .settings-panel form { display: grid; gap: 12px; }
  .settings-panel label { display: grid; gap: 6px; color: #62766b; font-size: 11px; font-weight: 900; }
  .config-total { display: flex; justify-content: space-between; margin: 5px 0; padding-top: 15px; border-top: 1px solid #e4ece7; color: #71857a; font-size: 12px; min-width: 0; }
  .config-total strong { color: #123c29; font-size: 15px; text-align: right; }
  .save { padding: 12px; border: 0; border-radius: 8px; background: #dcae24; color: #192a1e; font-weight: 900; cursor: pointer; }
  .finance-rule { margin-top: 22px; padding: 13px; border-radius: 9px; background: #f1f6f2; }
  .finance-rule b { font-size: 11px; }
  .finance-rule p { margin: 5px 0 0; font-size: 11px; }

  /* RESPONSIVE LAYOUT (1100px & 800px) */
  @media(max-width: 1100px) {
    .finance-summary { grid-template-columns: repeat(2, 1fr); }
    .finance-layout { grid-template-columns: 1fr; }
  }

  @media(max-width: 800px) {
    html, body { max-width: 100%; overflow-x: hidden; }
    .finance { margin-left: 0; padding: 86px 16px 50px; width: 100%; box-sizing: border-box; }
    .page-header { display: block; }
    .ghost { margin-top: 18px; }

    .invoice-panel, .settings-panel { margin-top: 18px; padding: 18px; }
    .panel-top { display: block; }
    .panel-top h2 { margin-bottom: 16px; }

    .filters { display: grid; grid-template-columns: 1fr; margin-bottom: 16px; }
    .filters input, .filters select, .settings-panel input, .settings-panel button { width: 100%; box-sizing: border-box; }

    .invoice-panel tbody td:nth-child(5) { display: block; width: 100%; }
    .payment-links { width: 100%; min-width: 0; }
  }

  /* RESPONSIVE MOBILE - CLEAN INVOICE CARDS (500px) */
  @media(max-width: 500px) {
    .finance { padding-left: 14px; padding-right: 14px; }
    .page-header h1 { font-size: 40px; }
    .summary-card, .invoice-panel, .settings-panel { border-radius: 13px; }
    .summary-card { padding: 18px; }
    .summary-card strong { font-size: 25px; }

    .invoice-panel table { table-layout: fixed; min-width: 0 !important; }
    .invoice-panel thead { display: none; }

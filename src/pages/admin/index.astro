---
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
import { getUserBySession, listUsers } from '../../lib/authStore';
import { listRegistrations } from '../../lib/registrationStore';
import { getContent } from '../../lib/contentStore';
const token = Astro.cookies.get('ssb_session')?.value || '';
const user = token ? await getUserBySession(Astro.locals, token) : null;
if (!user || user.role !== 'admin') return Astro.redirect('/login?redirect=/admin');
const [registrations, users, content] = await Promise.all([listRegistrations(), listUsers(Astro.locals), getContent()]);
const count = (status: string) => registrations.filter((item: any) => item.status === status).length;
const recent = registrations.slice(0, 6);
const accepted = count('diterima');
---
<Layout title="Command Center — SSB Bhayangkara Junior 2018">
  <AdminNav />
  <main class="command" id="main-content">
    <header class="command-header"><div><div class="overline"><span class="live-dot"></span> OPERASIONAL SSB <span class="date">{new Intl.DateTimeFormat('id-ID',{dateStyle:'full'}).format(new Date())}</span></div><h1>Command Center</h1><p>Selamat datang kembali, {user.name || 'Administrator'}. Ini ringkasan yang perlu diperhatikan hari ini.</p></div><div class="header-actions"><a class="outline" href="/" target="_blank">Lihat website <span>↗</span></a><a class="gold" href="/admin/pendaftaran">+ Pendaftaran</a></div></header>
    <section class="hero-strip"><div><span class="overline gold-text">FOCUS HARI INI</span><h2>{count('baru') > 0 ? `${count('baru')} pendaftaran menunggu review` : 'Semua pendaftaran sudah tertangani'}</h2><p>{count('baru') > 0 ? 'Buka daftar pendaftar untuk memeriksa dokumen dan menentukan status berikutnya.' : 'Pantau agenda latihan, CMS, dan laporan keuangan dari workspace ini.'}</p></div><a href="/admin/pendaftaran" class="hero-link">Buka inbox pendaftaran <span>→</span></a></section>
    <section class="metric-grid"><article class="metric accent"><span>Pendaftar baru</span><strong>{count('baru')}</strong><small>Menunggu verifikasi</small><a href="/admin/pendaftaran?status=baru">Tinjau →</a></article><article class="metric"><span>Dalam proses</span><strong>{count('diproses')}</strong><small>Perlu keputusan admin</small><a href="/admin/pendaftaran?status=diproses">Lihat →</a></article><article class="metric"><span>Peserta aktif</span><strong>{accepted}</strong><small>Status diterima</small><a href="/admin/pendaftaran?status=diterima">Buka daftar →</a></article><article class="metric"><span>Pengguna sistem</span><strong>{users.length}</strong><small>Semua role akun</small><a href="/admin/users">Kelola →</a></article></section>
    <section class="workspace-grid"><article class="workspace-card registrations"><div class="card-heading"><div><span class="overline">INBOX TERBARU</span><h2>Pendaftaran terbaru</h2></div><a href="/admin/pendaftaran">Lihat semua →</a></div>{recent.length ? <div class="registration-list">{recent.map((item: any) => <a class="registration-row" href="/admin/pendaftaran"><div class="avatar">{String(item.nama_siswa || 'P').slice(0,1).toUpperCase()}</div><div class="person"><strong>{item.nama_siswa || 'Nama belum diisi'}</strong><small>{item.nomor_pendaftaran || '-'} · {item.posisi || 'Posisi belum diisi'}</small></div><span class:list={['pill', item.status]}>{item.status || 'baru'}</span><span class="row-arrow">→</span></a>)}</div> : <div class="empty">Belum ada pendaftaran masuk.</div>}</article><article class="workspace-card overview"><div class="card-heading"><div><span class="overline">KONDISI SISTEM</span><h2>Ringkasan SSB</h2></div></div><div class="health"><div><span class="health-icon green">✓</span><span><strong>Website publik</strong><small>CMS aktif dan dapat diakses</small></span></div><div><span class="health-icon blue">◷</span><span><strong>{content.schedule?.length || 0} jadwal latihan</strong><small>{content.tournaments?.length || 0} agenda kompetisi</small></span></div><div><span class="health-icon gold">!</span><span><strong>{content.announcements?.length || 0} pengumuman</strong><small>Konten terbaru di CMS</small></span></div></div><a class="manage-link" href="/admin/content">Buka Content Studio <span>→</span></a></article></section>
    <section class="quick-section"><div class="section-heading"><div><span class="overline">WORKSPACE</span><h2>Akses cepat</h2></div><span class="muted">Kelola area kerja utama SSB</span></div><div class="quick-grid"><a href="/admin/pendaftaran"><span class="quick-no">01</span><strong>Admissions</strong><small>Pendaftaran, verifikasi, PDF, dan dokumen</small><b>→</b></a><a href="/admin/finance"><span class="quick-no">02</span><strong>Finance desk</strong><small>Invoice, pembayaran manual, dan laporan</small><b>→</b></a><a href="/admin/users"><span class="quick-no">03</span><strong>People & access</strong><small>Akun pelatih, siswa, orang tua, dan admin</small><b>→</b></a><a href="/admin/content"><span class="quick-no">04</span><strong>Content studio</strong><small>Homepage, agenda, gallery, dan pengumuman</small><b>→</b></a></div></section>
  </main>
</Layout>
<style>
:global(body){background:#f3f6f4}.command{margin-left:278px;min-height:100vh;padding:42px 52px 80px;background:#f3f6f4;color:#15251e}.command-header{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:36px}.overline{display:flex;align-items:center;gap:8px;color:#72857b;font-size:11px;font-weight:900;letter-spacing:.14em}.date{font-weight:600;letter-spacing:0;color:#97a69e}.live-dot{width:7px;height:7px;border-radius:50%;background:#28b46b;box-shadow:0 0 0 4px rgba(40,180,107,.12)}h1{font-size:clamp(34px,5vw,58px);letter-spacing:-.06em;margin:13px 0 8px;color:#0d2b1e}.command-header p{margin:0;color:#72857b;font-size:15px}.header-actions{display:flex;gap:10px}.outline,.gold{padding:12px 16px;border-radius:9px;font-size:13px;font-weight:900}.outline{border:1px solid #cfdbd4;color:#315145;background:#fff}.gold{background:#dcae24;color:#1b2a1e}.hero-strip{display:flex;justify-content:space-between;align-items:end;gap:24px;padding:28px 30px;border-radius:16px;background:#083c29;color:#fff;box-shadow:0 16px 36px rgba(8,60,41,.12)}.gold-text{color:#f6cf52}.hero-strip h2{font-size:27px;margin:10px 0 7px;letter-spacing:-.035em}.hero-strip p{margin:0;color:#b7cbc0}.hero-link{white-space:nowrap;color:#ffd966;font-size:13px;font-weight:900}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin:18px 0}.metric{position:relative;padding:22px;background:#fff;border:1px solid #e0e9e3;border-radius:14px}.metric.accent{border-top:3px solid #dcae24}.metric span{color:#718379;font-size:12px;font-weight:800}.metric strong{display:block;margin:13px 0 3px;font-size:42px;letter-spacing:-.06em;color:#123c29}.metric small{color:#94a49b}.metric a{display:block;margin-top:20px;color:#39745a;font-size:12px;font-weight:900}.workspace-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:18px}.workspace-card,.quick-section{padding:25px;border:1px solid #e0e9e3;border-radius:14px;background:#fff}.card-heading,.section-heading{display:flex;justify-content:space-between;align-items:start;gap:20px}.card-heading h2,.section-heading h2{font-size:22px;letter-spacing:-.04em;margin:8px 0 20px}.card-heading a{color:#39745a;font-size:12px;font-weight:900}.registration-list{border-top:1px solid #e6eee9}.registration-row{display:flex;align-items:center;gap:12px;padding:14px 2px;border-bottom:1px solid #e6eee9}.avatar{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:#e8f1eb;color:#176342;font-weight:900}.person{flex:1}.person strong,.person small{display:block}.person strong{font-size:14px}.person small{margin-top:4px;color:#8a9a92;font-size:11px}.pill{padding:5px 8px;border-radius:999px;font-size:10px;font-weight:900;text-transform:capitalize}.pill.baru{background:#fff4cc;color:#936f08}.pill.diproses{background:#e7f0ff;color:#2862a2}.pill.diterima{background:#e1f5e9;color:#197443}.row-arrow{color:#9aae9f}.health{display:grid;gap:15px;border-top:1px solid #e6eee9;padding-top:4px}.health>div{display:flex;align-items:center;gap:12px}.health-icon{width:30px;height:30px;display:grid;place-items:center;border-radius:9px;font-weight:900}.health-icon.green{background:#e3f5e9;color:#1f9d5a}.health-icon.blue{background:#e5efff;color:#4076bd}.health-icon.gold{background:#fff3cf;color:#a77c11}.health strong,.health small{display:block}.health strong{font-size:13px}.health small{margin-top:3px;color:#8a9a92;font-size:11px}.manage-link{display:flex;justify-content:space-between;margin-top:25px;padding-top:16px;border-top:1px solid #e6eee9;color:#39745a;font-weight:900;font-size:12px}.quick-section{margin-top:18px}.muted{color:#8a9a92;font-size:12px}.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.quick-grid a{position:relative;padding:20px;border:1px solid #e2ebe5;border-radius:11px;color:#173e2c;transition:.2s}.quick-grid a:hover{border-color:#dcae24;transform:translateY(-2px)}.quick-no{display:block;color:#b68b18;font-size:11px;font-weight:900;margin-bottom:25px}.quick-grid strong,.quick-grid small{display:block}.quick-grid strong{font-size:15px}.quick-grid small{min-height:34px;margin-top:7px;color:#7a8d83;font-size:11px;line-height:1.5}.quick-grid b{display:block;margin-top:15px;color:#39745a}.empty{padding:35px 0;color:#8a9a92;text-align:center}@media(max-width:1100px){.metric-grid,.quick-grid{grid-template-columns:repeat(2,1fr)}.workspace-grid{grid-template-columns:1fr}}@media(max-width:800px){.command{margin-left:0;padding:88px 18px 50px}.command-header{display:block}.header-actions{margin-top:20px}.hero-strip{display:block}.hero-link{display:inline-block;margin-top:22px}.metric-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.metric-grid,.quick-grid{grid-template-columns:1fr}.card-heading,.section-heading{display:block}.date{display:none}.command-header h1{font-size:42px}}
</style>

    font-size: 12px;
    font-weight: 700;
  }

  .table-wrap {
    width: 100%;
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 760px;
  }

  th {
    color: #8fa69a;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
    text-align: left;
    padding: 16px 18px;
    border-bottom: 1px solid #16472f;
  }

  td {
    padding: 18px;
    border-bottom: 1px solid #103b28;
    vertical-align: middle;
  }

  tr:last-child td {
    border-bottom: 0;
  }

  .registration-number {
    color: #e6bd35;
    font-weight: 800;
    font-size: 13px;
  }

  .student-name {
    font-weight: 800;
  }

  .muted {
    color: #8fa69a;
    font-size: 13px;
  }

  .status {
    display: inline-flex;
    border-radius: 999px;
    padding: 7px 12px;

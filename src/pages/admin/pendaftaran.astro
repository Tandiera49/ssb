    text-transform: uppercase;
  }

  .status-baru {
    background: rgba(230, 189, 53, .15);
    color: #e6bd35;
    border: 1px solid rgba(230, 189, 53, .35);
  }

  .status-diproses {
    background: rgba(100, 170, 125, .15);
    color: #9ed7a9;
    border: 1px solid rgba(100, 170, 125, .35);
  }

  .status-diterima {
    background: rgba(70, 190, 110, .15);
    color: #75e49a;
    border: 1px solid rgba(70, 190, 110, .35);
  }

  .status-ditolak {
    background: rgba(210, 80, 80, .15);
    color: #ff9696;
    border: 1px solid rgba(210, 80, 80, .35);
  }

  .detail-btn {
    border: 0;
    border-radius: 9px;
    background: #e6bd35;
    color: #102116;
    padding: 9px 14px;
    font-weight: 900;
  }

  .detail-btn:hover {
    transform: translateY(-1px);
  }

  .empty {
    padding: 40px 24px;
    color: #8fa69a;
    text-align: center;
  }

  .error-box {
    margin: 18px 24px;
    padding: 13px 15px;
    border: 1px solid #8d3838;
    border-radius: 10px;
    background: rgba(150, 40, 40, .15);
    color: #ffaaaa;
  }

  .detail-panel {
    padding: 0;
    overflow: hidden;
  }

  .detail-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    padding: 24px;
    border-bottom: 1px solid #16472f;
  }

  .detail-head h2 {
    margin: 0;
    color: #f4f8f4;
    font-size: 30px;
    line-height: 1.15;
  }

  .detail-number {
    margin: 7px 0 0;
    color: #e6bd35;
    font-size: 13px;
    font-weight: 800;
  }

  .close-btn {
    min-height: 40px;
    border: 1px solid #31543f;
    border-radius: 10px;
    background: #09291b;
    color: #f4f8f4;
    padding: 9px 14px;
    font-weight: 800;
    cursor: pointer;
  }

  .close-btn:hover {
    border-color: #e6bd35;
    color: #e6bd35;
  }

  #detailContent {
    padding: 22px 24px 28px;
  }

  .status-card,
  .participant-account-card {
    margin: 0 0 16px;
    border: 1px solid #2a6849;
    border-radius: 14px;
    background: #09291b;
    box-sizing: border-box;
  }

  .status-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 15px 16px;
    background:
      linear-gradient(135deg, rgba(230,189,53,.08), rgba(9,41,27,.98));
  }

  .status-info,
  .participant-account-head > div {
    min-width: 0;
  }

  .status-card small,
  .participant-account-card small,
  .detail-section-label {
    display: block;
    margin-bottom: 6px;
    color: #8fa69a;
    font-size: 11px;
    line-height: 1.35;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .06em;
  }

  .status-card .status-value {
    color: #e6bd35;
    font-size: 17px;
    font-weight: 900;
    text-transform: capitalize;
  }

  .status-control {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 8px;
    flex: 0 0 auto;
  }

  .status-control select {
    min-height: 40px;
    border: 1px solid #31543f;
    border-radius: 9px;
    background: #061a12;
    color: #f4f8f4;
    padding: 8px 12px;
    font-weight: 700;
    outline: none;
  }

  .status-control select:focus {
    border-color: #e6bd35;
  }

  .save-status {
    min-height: 40px;
    border: 0;
    border-radius: 9px;
    background: #e6bd35;
    color: #102116;
    padding: 8px 13px;
    font-weight: 900;
    cursor: pointer;
  }

  .save-status:hover:not(:disabled) {
    filter: brightness(1.05);
  }

  .save-status:disabled {
    opacity: .55;
    cursor: wait;
  }

  #statusMessage {
    color: #9ed7a9;
    font-size: 12px;
    font-weight: 800;
  }

  .participant-account-card {
    padding: 16px;
    background:
      linear-gradient(145deg, rgba(230,189,53,.07), rgba(6,31,20,.98));
  }

  .participant-account-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .participant-account-head strong {
    display: block;
    color: #f4f8f4;
    font-size: 17px;
    line-height: 1.3;
  }

  .participant-account-button {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .participant-account-message {
    margin-top: 12px;
    color: #b7c9bf;
    font-size: 13px;
    line-height: 1.5;
  }

  #accountCredentials {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 13px;
  }

  .credential-card {
    min-width: 0;
    padding: 14px;
    border: 1px solid #31543f;
    border-radius: 12px;
    background: #061f14;
  }

  .credential-card > strong {
    display: block;
    margin-bottom: 10px;
    color: #e6bd35;
    font-size: 14px;
  }

  .credential-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 0;
    border-top: 1px solid rgba(49,84,63,.55);
  }

  .credential-row:first-of-type {
    border-top: 0;
  }

  .credential-row span {
    color: #8fa69a;
    font-size: 12px;
  }

  .credential-row strong {
    min-width: 0;
    color: #f4f8f4;
    font-size: 13px;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .detail-sections {
    display: grid;
    gap: 14px;
    margin-top: 4px;
  }

  .detail-section {
    min-width: 0;
    border: 1px solid #1c5a40;
    border-radius: 14px;
    background: #09291b;
    overflow: hidden;
  }

  .detail-section-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 16px;
    border-bottom: 1px solid #16472f;
    background: rgba(6,31,20,.72);
  }

  .detail-section-head::before {
    content: "";
    width: 4px;
    height: 18px;
    flex: 0 0 4px;
    border-radius: 999px;
    background: #e6bd35;
  }

  .detail-section-head strong {
    color: #f4f8f4;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .detail-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
  }

  .detail-field {
    min-width: 0;
    padding: 13px 16px;
    border-bottom: 1px solid #103b28;
  }

  .detail-field:nth-child(odd) {
    border-right: 1px solid #103b28;
  }

  .detail-field:nth-last-child(-n + 2) {
    border-bottom: 0;
  }

  .detail-field.full {
    grid-column: 1 / -1;
    border-right: 0;
  }

  .detail-field small {
    display: block;
    margin-bottom: 5px;
    color: #8fa69a;
    font-size: 11px;
    line-height: 1.3;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .detail-field strong {
    display: block;
    color: #f4f8f4;
    font-size: 14px;
    line-height: 1.45;
    font-weight: 800;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .detail-section.docs-section {
    padding-bottom: 14px;
  }

  .detail-section.docs-section .detail-section-head {
    margin-bottom: 0;
  }

  .docs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding: 14px 16px 0;
  }

  .doc {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid #31543f;
    border-radius: 11px;
    background: #061f14;
    padding: 11px;
  }

  .doc-main {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
  }

  .doc-icon {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #e6bd35;
    color: #102116;
    font-size: 13px;
    font-weight: 900;
  }

  .doc strong {
    display: block;
    color: #e6bd35;
    font-size: 13px;
  }

  .doc small {
    display: block;
    margin-top: 3px;
    color: #8fa69a;
    font-size: 11px;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .doc-actions {
    display: flex;
    gap: 6px;
    flex: 0 0 auto;
  }

  .doc-view,
  .doc-download {
    display: inline-block;
    border-radius: 8px;
    padding: 7px 9px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 900;
  }

  .doc-view {
    border: 1px solid #31543f;
    background: #123521;
    color: #f4f8f4;
  }

  .doc-download {
    border: 1px solid #e6bd35;
    background: #e6bd35;
    color: #102116;
  }

  .doc-view:hover {
    border-color: #e6bd35;
    color: #e6bd35;
  }

  .doc-empty {
    grid-column: 1 / -1;
    padding: 14px;
    border: 1px dashed #31543f;
    border-radius: 10px;
    color: #8fa69a;
  }

  @media (max-width: 900px) {
    .admin-page {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 86px 14px 100px;
    }

    .admin-head {
      align-items: flex-start;
      gap: 16px;
    }

    .admin-head > div {
      min-width: 0;
      flex: 1 1 auto;
    }

    .refresh-btn {
      flex: 0 0 auto;
      margin: 0;
      white-space: nowrap;
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .stat-card {
      min-width: 0;
      padding: 18px;
      min-height: 108px;
    }

    .stat-card strong {
      font-size: 34px;
    }

    .panel {
      width: 100%;
      min-width: 0;
    }

    .panel-head {
      padding: 20px 18px;
    }

    .filters {
      flex-direction: column;
      padding: 16px 18px 8px;
    }

    .search-box,
    .filter-select {
      width: 100%;
      min-width: 0;
    }

    .filter-result {
      padding: 5px 18px 14px;
    }
  }

  @media (max-width: 560px) {
    .admin-page {
      padding: 82px 12px 90px;
    }

    .admin-head {
      flex-direction: column;
      gap: 14px;
      margin-bottom: 22px;
    }

    .admin-head h1 {
      font-size: clamp(34px, 11vw, 46px);
    }

    .subtitle {
      line-height: 1.45;
    }

    .refresh-btn {
      width: 100%;
      justify-content: center;
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin-bottom: 18px;
    }

    .stat-card {
      padding: 16px;
      border-radius: 17px;
      min-height: 100px;
    }

    .stat-card span {
      font-size: 13px;
    }

    .stat-card strong {
      margin-top: 9px;
      font-size: 32px;
    }

    .panel {
      border-radius: 18px;
    }

    .panel-head {
      padding: 18px 16px;
    }

    .panel-head h2 {
      font-size: 25px;
    }

    .filters {
      padding: 14px 16px 6px;
    }

    .filter-result {
      padding: 5px 16px 12px;
    }
  }

  @media (max-width: 800px) {
    .detail-head {
      padding: 18px;
    }

    #detailContent {
      padding: 16px;
    }

    .status-card {
      align-items: stretch;
      flex-direction: column;
      gap: 12px;
    }

    .status-control {
      width: 100%;
      justify-content: stretch;
    }

    .status-control select,
    .status-control .save-status {
      flex: 1 1 0;
      min-width: 0;
    }

    .participant-account-head {
      align-items: stretch;
      flex-direction: column;
    }

    .participant-account-button {
      width: 100%;
      white-space: normal;
    }

    #accountCredentials {
      grid-template-columns: 1fr;
    }

    .docs {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .detail-head {
      flex-direction: column;
      gap: 13px;
    }

    .detail-head h2 {
      font-size: 23px;
    }

    .close-btn {
      width: 100%;
    }

    .detail-fields {
      grid-template-columns: 1fr;
    }

    .detail-field,
    .detail-field:nth-child(odd),
    .detail-field:nth-last-child(-n + 2) {
      border-right: 0;
      border-bottom: 1px solid #103b28;
    }

    .detail-field:last-child {
      border-bottom: 0;
    }

    .detail-field.full {
      grid-column: auto;
    }

    .doc {
      align-items: flex-start;
      flex-direction: column;
    }

    .doc-actions {
      width: 100%;
    }

    .doc-view,
    .doc-download {
      flex: 1;
      text-align: center;
    }
  }

  @media (max-width: 430px) {
    .detail-section-head {
      padding: 12px 13px;
    }

    .detail-field {
      padding: 12px 13px;
    }

    .detail-field strong {
      font-size: 13px;
    }

    .status-card,
    .participant-account-card {
      padding: 13px;
    }
  }

</style>

<script>
  type Registration = Record<string, any>;

  let registrations: Registration[] = [];

  const $ = (id: string) =>
    document.getElementById(id) as HTMLElement;

  function esc(value: any) {
    return String(value ?? '-')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function formatDate(value: any) {
    if (!value) return '-';

    try {
      return new Date(value).toLocaleDateString(
        'id-ID',
        {
          day: '2-digit',
          month: '2-digit',
          year: 'numeric'
        }
      );
    } catch {
      return String(value);
    }
  }

  function statusClass(status: string) {
    return `status-${status || 'baru'}`;
  }

  function renderStats() {
    $('total').textContent =
      String(registrations.length);

    $('baru').textContent =
      String(
        registrations.filter(
          x => x.status === 'baru'
        ).length
      );

    $('diterima').textContent =
      String(
        registrations.filter(
          x => x.status === 'diterima'
        ).length
      );

    $('diproses').textContent =
      String(
        registrations.filter(
          x => x.status === 'diproses'
        ).length
      );
  }

  function renderRows() {
    const tbody = $('registrationRows');

    const searchInput =
      document.getElementById('searchInput') as HTMLInputElement;

    const statusFilter =
      document.getElementById('statusFilter') as HTMLSelectElement;

    const keyword =
      (searchInput?.value || '').trim().toLowerCase();

    const selectedStatus =
      statusFilter?.value || 'semua';

    const filtered = registrations.filter(item => {
      const nama =
        String(item.nama_siswa || '').toLowerCase();

      const nomor =
        String(item.nomor_pendaftaran || '').toLowerCase();

      const status =
        String(item.status || 'baru').toLowerCase();

      const matchSearch =
        !keyword ||
        nama.includes(keyword) ||
        nomor.includes(keyword);

      const matchStatus =
        selectedStatus === 'semua' ||
        status === selectedStatus;

      return matchSearch && matchStatus;
    });

    $('resultCount').textContent =
      `${filtered.length} dari ${registrations.length} data`;

    if (!filtered.length) {
      tbody.innerHTML = '';
      $('emptyState').hidden = false;
      $('emptyState').textContent =
        registrations.length
          ? 'Tidak ada data yang sesuai pencarian/filter.'
          : 'Belum ada data pendaftaran.';
      return;
    }

    $('emptyState').hidden = true;

    tbody.innerHTML = filtered.map(item => {
      const originalIndex =
        registrations.indexOf(item);

      const status =
        item.status || 'baru';

      return `
        <tr>
          <td>
            <span class="registration-number">
              ${esc(item.nomor_pendaftaran)}
            </span>
          </td>

          <td>
            <span class="student-name">
              ${esc(item.nama_siswa)}
            </span>
          </td>

          <td class="muted">
            ${esc(formatDate(item.tanggal_pendaftaran))}
          </td>

          <td>
            ${esc(item.posisi || '-')}
          </td>

          <td>
            <span class="status ${statusClass(status)}">
              ${esc(status)}
            </span>
          </td>

          <td>
            <button
              class="detail-btn"
              type="button"
              data-detail-index="${originalIndex}"
            >
              Detail
            </button>
          </td>
        </tr>
      `;
    }).join('');

    tbody
      .querySelectorAll('[data-detail-index]')
      .forEach(button => {
        button.addEventListener('click', () => {
          const index = Number(
            button.getAttribute('data-detail-index')
          );

          showDetail(index);
        });
      });
  }

  function showDetail(index: number) {
    const item = registrations[index];

    if (!item) return;

    $('detail').hidden = false;

    $('detailName').textContent =
      item.nama_siswa || 'Pendaftar';

    $('detailNumber').textContent =
      item.nomor_pendaftaran || '';

    const downloadPdfBtn =
      $('downloadPdfBtn') as HTMLAnchorElement | null;

    if (downloadPdfBtn) {
      downloadPdfBtn.href =
        `/api/admin/pendaftaran/pdf?nomor=${encodeURIComponent(
          item.nomor_pendaftaran || ''
        )}`;
    }

    let files: Record<string, any> = {};

    if (typeof item.files === 'string') {
      try {
        files = JSON.parse(item.files);
      } catch {
        files = {};
      }
    } else if (
      item.files &&
      typeof item.files === 'object'
    ) {
      files = item.files;
    }

    const labels: Record<string, string> = {
      pas_foto: 'Pas Foto',
      akta: 'Akta Kelahiran',
      kk: 'Kartu Keluarga',
      rapor: 'Rapor'
    };

    const documentHtml = Object.entries(files)
      .map(([key, file]) => {
        const filename =
          file?.original_name ||
          file?.stored_name ||
          '-';

        const base =
          `/api/admin/dokumen/${encodeURIComponent(
            item.nomor_pendaftaran
          )}/${encodeURIComponent(key)}`;

        return `
          <div class="doc">
            <div class="doc-main">
              <span class="doc-icon">✓</span>
              <div>
                <strong>${esc(labels[key] || key)}</strong>
                <small>${esc(filename)}</small>
              </div>
            </div>

            <div class="doc-actions">
              <a
                class="doc-view"
                href="${base}"
                target="_blank"
                rel="noopener"
              >
                Lihat
              </a>

              <a
                class="doc-download"
                href="${base}?download=1"
              >
                Download
              </a>
            </div>
          </div>
        `;
      })
      .join('');

    const field = (
      label: string,
      value: any,
      full = false
    ) => `
      <div class="detail-field${full ? ' full' : ''}">
        <small>${esc(label)}</small>
        <strong>${esc(value || '-')}</strong>
      </div>
    `;

    $('detailContent').innerHTML = `
      <div class="status-card">
        <div class="status-info">
          <small>Status Pendaftaran</small>
          <span id="currentStatus" class="status-value">
            ${esc(item.status || 'baru')}
          </span>
        </div>

        <div class="status-control">
          <select id="statusSelect">
            <option value="baru" ${item.status === 'baru' ? 'selected' : ''}>
              Baru
            </option>
            <option value="diproses" ${item.status === 'diproses' ? 'selected' : ''}>
              Diproses
            </option>
            <option value="diterima" ${item.status === 'diterima' ? 'selected' : ''}>
              Diterima
            </option>
            <option value="ditolak" ${item.status === 'ditolak' ? 'selected' : ''}>
              Ditolak
            </option>
          </select>

          <button
            id="saveStatus"
            class="save-status"
            type="button"
          >
            Simpan Status
          </button>

          <span id="statusMessage"></span>
        </div>
      </div>

      <div class="participant-account-card">
        <div class="participant-account-head">
          <div>
            <small>Akun Peserta</small>
            <strong>Siswa & Orang Tua/Wali</strong>
          </div>

          <button
            id="generateAccounts"
            class="save-status participant-account-button"
            type="button"
            ${item.status !== 'diterima' ? 'disabled' : ''}
          >
            Buat Akun Siswa & Orang Tua
          </button>
        </div>

        <div
          id="accountMessage"
          class="participant-account-message"
        >
          ${
            item.status === 'diterima'
              ? 'Akun dapat dibuat karena status pendaftaran sudah Diterima.'
              : 'Akun peserta tersedia setelah status pendaftaran menjadi Diterima.'
          }
        </div>

        <div id="accountCredentials"></div>
      </div>

      <div class="detail-sections">

        <section class="detail-section">
          <div class="detail-section-head">
            <strong>Data Siswa</strong>
          </div>

          <div class="detail-fields">
            ${field('No. Pendaftaran', item.nomor_pendaftaran)}
            ${field('Tanggal Pendaftaran', formatDate(item.tanggal_pendaftaran))}
            ${field('Tempat Lahir', item.tempat_lahir)}
            ${field('Tanggal Lahir', item.tanggal_lahir)}
            ${field('NISN', item.nisn)}
            ${field('Alamat', item.alamat, true)}
          </div>
        </section>

        <section class="detail-section">
          <div class="detail-section-head">
            <strong>Orang Tua / Wali</strong>
          </div>

          <div class="detail-fields">
            ${field('Nama Ayah', item.nama_ayah)}
            ${field('HP Ayah', item.hp_ayah)}
            ${field('Pekerjaan Ayah', item.pekerjaan_ayah)}
            ${field('Nama Ibu', item.nama_ibu)}
            ${field('HP Ibu', item.hp_ibu)}
            ${field('Pekerjaan Ibu', item.pekerjaan_ibu)}
            ${field('Nama Wali', item.nama_wali)}
          </div>
        </section>

        <section class="detail-section">
          <div class="detail-section-head">
            <strong>Profil Sepak Bola</strong>
          </div>

          <div class="detail-fields">
            ${field('Posisi', item.posisi)}
            ${field('SSB Sebelumnya', item.ssb_sebelumnya)}
            ${field('Prestasi', item.prestasi)}
            ${field('Tinggi', item.tinggi)}
            ${field('Berat', item.berat)}
            ${field('Golongan Darah', item.golongan_darah)}
          </div>
        </section>

        <section class="detail-section">
          <div class="detail-section-head">
            <strong>Kesehatan</strong>
          </div>

          <div class="detail-fields">
            ${field('Penyakit / Alergi', item.penyakit_alergi, true)}
            ${field('Riwayat Cedera', item.riwayat_cedera, true)}
          </div>
        </section>

        <section class="detail-section">
          <div class="detail-section-head">
            <strong>Persetujuan</strong>
          </div>

          <div class="detail-fields">
            ${field(
              'Persetujuan',
              item.persetujuan ? 'Disetujui' : '-'
            )}
          </div>
        </section>

        <section class="detail-section docs-section">
          <div class="detail-section-head">
            <strong>Dokumen Terdaftar</strong>
          </div>

          <div class="docs">
            ${
              documentHtml ||
              '<div class="doc-empty">Tidak ada dokumen.</div>'
            }
          </div>
        </section>

      </div>
    `;

    const saveButton =
      document.getElementById('saveStatus') as HTMLButtonElement;

    const statusSelect =
      document.getElementById('statusSelect') as HTMLSelectElement;

    const statusMessage =
      document.getElementById('statusMessage') as HTMLElement;

    const generateAccounts =
      document.getElementById('generateAccounts') as HTMLButtonElement | null;

    const accountMessage =
      document.getElementById('accountMessage') as HTMLElement | null;

    const accountCredentials =
      document.getElementById('accountCredentials') as HTMLElement | null;

    const updateAccountButtonState = () => {
      if (!generateAccounts) return;

      generateAccounts.disabled =
        item.status !== 'diterima';

      if (accountMessage && item.status !== 'diterima') {
        accountMessage.textContent =
          'Akun peserta tersedia setelah status pendaftaran menjadi Diterima.';
      }
    };

    generateAccounts?.addEventListener('click', async () => {
      if (item.status !== 'diterima') {
        if (accountMessage) {
          accountMessage.textContent =
            'Status harus Diterima sebelum akun peserta dibuat.';
        }
        return;
      }

      generateAccounts.disabled = true;
      generateAccounts.textContent = 'Membuat akun...';

      if (accountMessage) {
        accountMessage.textContent = '';
      }

      if (accountCredentials) {
        accountCredentials.innerHTML = '';
      }

      try {
        const response = await fetch(
          '/api/admin/pendaftaran/akun',
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              nomor: item.nomor_pendaftaran
            })
          }
        );

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(
            result.message ||
            'Gagal membuat akun peserta.'
          );
        }

        const accounts =
          Array.isArray(result.data?.accounts)
            ? result.data.accounts
            : [];

        const created =
          result.data?.created === true;

        if (accountMessage) {
          accountMessage.textContent = created
            ? '✓ Dua akun peserta berhasil dibuat.'
            : '✓ Akun peserta sudah tersedia. Tidak ada akun duplikat yang dibuat.';
        }

        if (accountCredentials && accounts.length) {
          accountCredentials.innerHTML = accounts.map((account: any) => {
            const role =
              account.role === 'siswa'
                ? 'Akun Siswa'
                : 'Akun Orang Tua/Wali';

            const password =
              account.temporaryPassword
                ? `
                  <div class="credential-row">
                    <span>Password sementara</span>
                    <strong>${esc(account.temporaryPassword)}</strong>
                  </div>
                `
                : `
                  <div class="credential-row">
                    <span>Password</span>
                    <strong>Tersimpan</strong>
                  </div>
                `;

            return `
              <div class="credential-card">
                <strong>${esc(role)}</strong>

                <div class="credential-row">
                  <span>Username</span>
                  <strong>${esc(account.username || '-')}</strong>
                </div>

                ${password}
              </div>
            `;
          }).join('');
        }

        generateAccounts.textContent =
          'Akun Sudah Dibuat';

      } catch (error) {
        if (accountMessage) {
          accountMessage.textContent =
            error instanceof Error
              ? error.message
              : 'Gagal membuat akun peserta.';
        }

        generateAccounts.disabled = false;
        generateAccounts.textContent =
          'Buat Akun Siswa & Orang Tua';
      }
    });

    saveButton.addEventListener('click', async () => {
      saveButton.disabled = true;
      saveButton.textContent = 'Menyimpan...';
      statusMessage.textContent = '';

      try {
        const response = await fetch(
          '/api/admin/status',
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              nomor: item.nomor_pendaftaran,
              status: statusSelect.value
            })
          }
        );

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(
            result.message ||
            'Gagal menyimpan status.'
          );
        }

        item.status = statusSelect.value;

        const currentStatus =
          document.getElementById('currentStatus');

        if (currentStatus) {
          currentStatus.textContent =
            item.status;
        }

        updateAccountButtonState();

        if (accountMessage) {
          accountMessage.textContent =
            item.status === 'diterima'
              ? 'Akun dapat dibuat karena status pendaftaran sudah Diterima.'
              : 'Akun peserta tersedia setelah status pendaftaran menjadi Diterima.';
        }

        if (accountCredentials) {
          accountCredentials.innerHTML = '';
        }

        if (generateAccounts) {
          generateAccounts.textContent =
            'Buat Akun Siswa & Orang Tua';
        }

        statusMessage.textContent =
          '✓ Status berhasil disimpan';

        renderStats();
        renderRows();

      } catch (error) {
        statusMessage.textContent =
          error instanceof Error
            ? error.message
            : 'Gagal menyimpan status.';
      } finally {
        saveButton.disabled = false;
        saveButton.textContent =
          'Simpan Status';
      }
    });

    updateAccountButtonState();

    $('detail').scrollIntoView({
      behavior: 'smooth',
      block: 'start'
    });
  }

  async function loadRegistrations() {
    const loading = $('loadingText');
    const errorBox = $('errorBox');

    loading.textContent =
      'Memuat data...';

    errorBox.hidden = true;

    try {
      const response = await fetch(
        '/api/admin/pendaftaran',
        {
          cache: 'no-store'
        }
      );

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(
          result.message ||
          'Gagal mengambil data.'
        );
      }

      registrations =
        Array.isArray(result.data)
          ? result.data
          : [];

      renderStats();
      renderRows();

      loading.textContent =
        `${registrations.length} pendaftar tersimpan.`;

    } catch (error) {
      registrations = [];

      renderStats();
      renderRows();

      errorBox.textContent =
        error instanceof Error
          ? error.message
          : 'Gagal mengambil data pendaftaran.';

      errorBox.hidden = false;

      loading.textContent =
        'Gagal memuat data.';
    }
  }

  document
    .getElementById('refreshBtn')
    ?.addEventListener(
      'click',
      loadRegistrations
    );

  document
    .getElementById('searchInput')
    ?.addEventListener(
      'input',
      renderRows
    );

  document
    .getElementById('statusFilter')
    ?.addEventListener(
      'change',
      renderRows
    );

  document
    .getElementById('closeDetail')
    ?.addEventListener(
      'click',
      () => {
        $('detail').hidden = true;
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      }
    );

  loadRegistrations();
</script>

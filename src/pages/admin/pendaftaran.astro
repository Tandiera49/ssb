---
import { getUserBySession } from '../../lib/authStore';

const sessionToken = Astro.cookies.get('ssb_session')?.value || '';
const currentUser = sessionToken
  ? await getUserBySession(Astro.locals, sessionToken)
  : null;

if (!currentUser || currentUser.role !== 'admin') {
  return Astro.redirect(
    '/login?redirect=' + encodeURIComponent(Astro.url.pathname)
  );
}

export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import AdminNav from '../../components/AdminNav.astro';
---

<Layout title="Admin Pendaftaran - SSB Bhayangkara Junior 2018">
  <AdminNav />

<main class="admin-page">

    <section class="admin-head">
      <div>
        <p class="eyebrow">ADMINISTRATOR</p>
        <h1>Data Pendaftaran</h1>
        <p class="subtitle">
          Kelola data calon peserta didik SSB Bhayangkara Junior 2018.
        </p>
      </div>

      <button id="refreshBtn" class="refresh-btn" type="button">
        ↻ <span>Refresh</span>
      </button>
    </section>

    <section class="stats">
      <div class="stat-card">
        <span>Total Pendaftar</span>
        <strong id="total">0</strong>
      </div>

      <div class="stat-card">
        <span>Status Baru</span>
        <strong id="baru">0</strong>
      </div>

      <div class="stat-card">
        <span>Diterima</span>
        <strong id="diterima">0</strong>
      </div>

      <div class="stat-card">
        <span>Diproses</span>
        <strong id="diproses">0</strong>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head">
        <div>
          <h2>Daftar Pendaftar</h2>
          <p id="loadingText">Memuat data...</p>
        </div>
      </div>

      <div id="errorBox" class="error-box" hidden></div>

      <div class="filters">
        <div class="search-box">
          <span>⌕</span>
          <input
            id="searchInput"
            type="search"
            placeholder="Cari nama atau nomor pendaftaran..."
            autocomplete="off"
          />
        </div>

        <select id="statusFilter" class="filter-select">
          <option value="semua">Semua Status</option>
          <option value="baru">Baru</option>
          <option value="diproses">Diproses</option>
          <option value="diterima">Diterima</option>
          <option value="ditolak">Ditolak</option>
        </select>
      </div>

      <div class="filter-result">
        <span id="resultCount">0 data</span>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>No. Pendaftaran</th>
              <th>Nama Siswa</th>
              <th>Tanggal</th>
              <th>Posisi</th>
              <th>Status</th>
              <th>Aksi</th>
            </tr>
          </thead>

          <tbody id="registrationRows"></tbody>
        </table>
      </div>

      <div id="emptyState" class="empty" hidden>
        Belum ada data pendaftaran.
      </div>
    </section>

    <section id="detail" class="panel detail-panel" hidden>
      <div class="detail-head">
        <div>
          <p class="eyebrow">DETAIL PENDAFTAR</p>
          <h2 id="detailName">-</h2>
          <p id="detailNumber" class="detail-number">-</p>
        </div>

        <button id="closeDetail" class="close-btn" type="button">
          Tutup
        </button>
      </div>

      <div class="detail-actions">
        <a
          id="downloadPdfBtn"
          class="pdf-download-btn"
          href="#"
          download
        >
          ↓ Download PDF Lengkap
        </a>
      </div>

      <div id="detailContent"></div>
    </section>

  </main>
</Layout>

<style>
  :global(body) {
    background: #031c12;
  }

  .admin-page {
    width: min(1180px, calc(100% - 28px));
    margin: 0 auto;
    padding: 90px 0 120px;
    color: #f4f8f4;
  }

  .admin-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .eyebrow {
    margin: 0 0 7px;
    color: #e6bd35;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .14em;
  }

  h1 {
    margin: 0;
    font-size: clamp(32px, 6vw, 52px);
    line-height: 1;
  }

  .subtitle {
    margin: 12px 0 0;
    color: #9eb1a5;
  }

  button {
    font: inherit;
  }

  .refresh-btn,
  .close-btn,
  .save-status,
  .detail-actions {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 18px;
  }

  .pdf-download-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 10px;
    background: #e6bd35;
    color: #102116;
    text-decoration: none;
    font-weight: 900;
    border: 1px solid #e6bd35;
  }

  .pdf-download-btn:hover {
    filter: brightness(1.06);
  }

  .detail-btn,
  .doc-view,
  .doc-download {
    cursor: pointer;
  }

  .refresh-btn {
    border: 1px solid #31543f;
    border-radius: 12px;
    background: #09291b;
    color: #f4f8f4;
    padding: 13px 18px;
    font-weight: 800;
  }

  .refresh-btn:hover {
    border-color: #e6bd35;
    color: #e6bd35;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .stat-card {
    border: 1px solid #1c5a40;
    border-radius: 20px;
    background: #03291a;
    padding: 25px;
    min-height: 120px;
  }

  .stat-card span {
    display: block;
    color: #9eb1a5;
    font-size: 14px;
    font-weight: 700;
  }

  .stat-card strong {
    display: block;
    margin-top: 12px;
    color: #e6bd35;
    font-size: 40px;
    line-height: 1;
  }

  .panel {
    border: 1px solid #1c5a40;
    border-radius: 22px;
    background: #03291a;
    overflow: hidden;
    margin-bottom: 24px;
  }

  .panel-head {
    padding: 24px;
    border-bottom: 1px solid #16472f;
  }

  .panel-head h2 {
    margin: 0;
    font-size: 28px;
  }

  .panel-head p {
    margin: 7px 0 0;
    color: #8fa69a;
  }

  .filters {
    display: flex;
    gap: 10px;
    padding: 18px 24px 8px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: 1;
    min-height: 44px;
    border: 1px solid #31543f;
    border-radius: 11px;
    background: #061f14;
    padding: 0 13px;
  }

  .search-box span {
    color: #e6bd35;
    font-size: 22px;
    line-height: 1;
  }

  .search-box input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: #f4f8f4;
    font: inherit;
  }

  .search-box input::placeholder {
    color: #6f8b7c;
  }

  .filter-select {
    min-width: 155px;
    min-height: 44px;
    border: 1px solid #31543f;
    border-radius: 11px;
    background: #061f14;
    color: #f4f8f4;
    padding: 0 12px;
    outline: none;
  }

  .filter-select:focus,
  .search-box:focus-within {
    border-color: #e6bd35;
  }

  .filter-result {
    padding: 5px 24px 14px;
    color: #6f8b7c;
    font-size: 12px;
    font-weight: 700;
  }


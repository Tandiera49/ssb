---
import Layout from '../layouts/Layout.astro';
import PublicNav from '../components/PublicNav.astro';
import PublicFooter from '../components/PublicFooter.astro';
import { getContent } from '../lib/contentStore';
const content = await getContent(Astro.locals);
const announcements = Array.isArray(content.announcements) ? content.announcements : [];
const tournaments = Array.isArray(content.tournaments) ? content.tournaments : [];
const gallery = Array.isArray(content.gallery) ? content.gallery : [];
---
<Layout title="Berita, Agenda & Prestasi SSB Bhayangkara Junior 2018">
  <PublicNav active="berita" />
  <main id="main-content" class="news-page">
    <section class="news-hero"><div class="pro-wrap"><span class="eyebrow">Berita & Prestasi</span><h1>Setiap latihan punya<br /><span>cerita untuk dibagikan.</span></h1><p>Ikuti agenda, pengumuman, dan momen perjalanan SSB Bhayangkara Junior 2018.</p></div></section>
    <section class="news-section"><div class="pro-wrap"><div class="section-title"><span class="eyebrow">Terbaru</span><h2>Kabar dari <span>lapangan.</span></h2></div><div class="news-grid">{announcements.length ? announcements.map((item: any, i: number) => <article class:list={{ featured: i === 0 }}><span class="news-tag">Pengumuman</span><h3>{item.title || 'Info SSB Bhayangkara Junior'}</h3><p>{item.text || item.info || 'Informasi terbaru dari tim kami.'}</p><small>SSB Bhayangkara Junior 2018</small></article>) : <article class="empty"><h3>Belum ada pengumuman baru</h3><p>Informasi terbaru akan dibagikan melalui halaman ini.</p></article>}</div></div></section>
    <section class="agenda-section"><div class="pro-wrap"><div class="section-title"><span class="eyebrow">Agenda Kompetisi</span><h2>Terus belajar melalui <span>pertandingan.</span></h2></div><div class="agenda-grid">{tournaments.length ? tournaments.map((item: any) => <article><span class="news-tag">Agenda</span><h3>{item.name || 'Turnamen SSB'}</h3><p>{item.info || 'Detail agenda akan diperbarui.'}</p></article>) : <article class="empty"><h3>Agenda akan segera diperbarui</h3><p>Hubungi admin untuk mendapatkan jadwal kompetisi terbaru.</p></article>}</div></div></section>
    <section class="moments-section"><div class="pro-wrap"><div class="section-title"><span class="eyebrow">Dokumentasi</span><h2>Momen yang <span>berarti.</span></h2></div><div class="moment-grid">{gallery.slice(0, 6).map((item: any) => <figure><img src={item.image || item.src || '/images/gallery-1.svg'} alt={item.title || 'Kegiatan SSB Bhayangkara Junior'} loading="lazy" /><figcaption>{item.title || 'Kegiatan SSB Bhayangkara Junior 2018'}</figcaption></figure>)}</div></div></section>
  </main>
  <PublicFooter />
</Layout>
<style>
.news-page{background:#f4f8f5;color:#123126}.pro-wrap{width:min(1180px,calc(100% - 36px));margin:auto}.news-hero{padding:110px 0 100px;background:linear-gradient(120deg,#032b1d,#075d39);color:#fff}.eyebrow{color:#b78b15;font-size:12px;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.news-hero .eyebrow{color:#ffd84f}.news-hero h1{font-size:clamp(48px,7vw,86px);line-height:.95;letter-spacing:-.06em;margin:18px 0}.news-hero h1 span,h2 span{color:#ffd84f}.news-hero p{color:#d5e5dc;font-size:19px;line-height:1.6}.news-section,.moments-section{padding:92px 0}.section-title h2{font-size:clamp(36px,5vw,58px);line-height:.98;letter-spacing:-.05em;margin:12px 0 34px}.news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.news-grid article,.agenda-grid article{min-height:230px;padding:28px;border-radius:20px;background:#fff;border:1px solid #d5e5dc}.news-grid article.featured{grid-column:span 2;background:#075d39;color:#fff}.news-tag{display:inline-flex;padding:7px 10px;border-radius:999px;background:rgba(244,197,45,.14);color:#a47706;font-weight:900;font-size:11px}.featured .news-tag{color:#ffd84f}.news-grid h3,.agenda-grid h3{font-size:25px;margin:32px 0 10px}.news-grid p,.agenda-grid p{color:#587066;line-height:1.7}.featured p{color:#c8ddd2}.news-grid small{color:#8aa197}.agenda-section{padding:92px 0;background:#032b1d;color:#fff}.agenda-section .eyebrow{color:#ffd84f}.agenda-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.agenda-grid article{background:rgba(255,255,255,.06);border-color:rgba(255,216,79,.24)}.agenda-grid p{color:#bcd0c5}.moments-section{background:#fff}.moment-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.moment-grid figure{margin:0;border-radius:18px;overflow:hidden;background:#eaf2ed}.moment-grid img{display:block;width:100%;aspect-ratio:1.2;object-fit:cover}.moment-grid figcaption{padding:14px;color:#456255;font-size:13px;font-weight:800}.empty{display:block!important;grid-column:1/-1;min-height:auto!important}@media(max-width:760px){.news-grid,.agenda-grid,.moment-grid{grid-template-columns:1fr}.news-grid article.featured{grid-column:auto}}
</style>

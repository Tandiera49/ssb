---
import Layout from '../layouts/Layout.astro';
import { getContent } from '../lib/contentStore';
const content = await getContent();
const schedules = Array.isArray(content.schedule) ? content.schedule : [];
const tournaments = Array.isArray(content.tournaments) ? content.tournaments : [];
const gallery = Array.isArray(content.gallery) ? content.gallery.slice(0, 6) : [];
const wa = String(content.contact?.whatsapp || '').replace(/\D/g,'');
---
<Layout title="SSB Bhayangkara Junior 2018 | Football Academy Tangerang Selatan">
  <header class="site-nav"><div class="nav-wrap"><a class="brand" href="/"><img src="/icons/logo.svg" alt="" /><span><b>BHAYANGKARA</b><small>JUNIOR 2018 · FOOTBALL ACADEMY</small></span></a><nav><a href="#academy">Academy</a><a href="#program">Program</a><a href="#journey">Perjalanan</a><a href="#contact">Kontak</a><a class="nav-apply" href="/pendaftaran">Daftar anak <span>↗</span></a></nav><button class="nav-menu" data-menu>☰</button></div><div class="mobile-nav" data-mobile><a href="#academy">Academy</a><a href="#program">Program</a><a href="#journey">Perjalanan</a><a href="#contact">Kontak</a><a href="/pendaftaran">Daftar anak ↗</a></div></header>
  <main id="main-content">
    <section class="hero"><div class="hero-grid"><div class="hero-copy"><div class="eyebrow"><span></span> Football academy · Pamulang</div><h1>Build the player.<br /><i>Build the person.</i></h1><p>Tempat anak-anak bertumbuh melalui sepak bola yang terarah, lingkungan yang positif, dan pembinaan karakter yang konsisten.</p><div class="hero-actions"><a class="button gold" href="/pendaftaran">Mulai perjalanan <span>↗</span></a><a class="button text-button" href="#academy">Kenali academy <span>↓</span></a></div><div class="hero-trust"><div><strong>2018</strong><small>Tahun berdiri</small></div><div><strong>U-8 — U-12+</strong><small>Kelompok pembinaan</small></div><div><strong>100%</strong><small>Character first</small></div></div></div><div class="hero-visual"><div class="visual-orbit"></div><div class="visual-number">01</div><div class="visual-caption"><span>TRAIN WITH PURPOSE</span><b>Next generation<br />starts here.</b></div><div class="visual-ball">⚽</div></div></div><div class="hero-bottom"><span>SSB BHAYANGKARA JUNIOR 2018</span><span>SPORTS · EDUCATION · CHARACTER</span></div></section>
    <section class="marquee"><div>DISCIPLINE <span>✦</span> TEAMWORK <span>✦</span> RESPECT <span>✦</span> COURAGE <span>✦</span> DISCIPLINE <span>✦</span> TEAMWORK <span>✦</span></div></section>
    <section class="academy section" id="academy"><div class="section-label">01 / THE ACADEMY</div><div class="academy-head"><h2>Football is the<br /><em>medium.</em> Character<br />is the mission.</h2><div><p>{content.vision?.text || 'Membentuk generasi muda yang berprestasi, berkarakter, disiplin, dan menjunjung tinggi sportivitas melalui sepak bola.'}</p><a class="inline-link" href="/tentang">Tentang kami <span>→</span></a></div></div><div class="principles"><article><span>01</span><h3>Foundation</h3><p>Teknik dasar, koordinasi, dan pemahaman permainan dibangun dengan latihan yang sesuai tahap usia.</p></article><article><span>02</span><h3>Character</h3><p>Disiplin, sportivitas, rasa hormat, dan tanggung jawab hadir di setiap sesi latihan.</p></article><article><span>03</span><h3>Belonging</h3><p>Lingkungan yang membuat anak merasa aman untuk mencoba, berkembang, dan menjadi bagian dari tim.</p></article></div></section>
    <section class="program section" id="program"><div class="section-label light">02 / DEVELOPMENT PATH</div><div class="program-head"><div><h2>Program yang tumbuh<br /><em>bersama anak.</em></h2></div><p>Setiap kelompok memiliki fokus berbeda. Satu hal yang sama: anak dilatih untuk menikmati proses dan berani berkembang.</p></div><div class="program-list"><article><div class="program-age">U-08</div><div><h3>Play & discover</h3><p>Koordinasi, keberanian, motorik, dan kecintaan pada bola.</p></div><span>01</span></article><article><div class="program-age">U-10</div><div><h3>Learn & connect</h3><p>Teknik, kerja sama, komunikasi, dan pemahaman ruang.</p></div><span>02</span></article><article><div class="program-age">U-12+</div><div><h3>Compete & grow</h3><p>Keputusan permainan, mental bertanding, fisik, dan tanggung jawab.</p></div><span>03</span></article></div><a class="button light-button" href="/program">Lihat detail program <span>→</span></a></section>
    <section class="schedule section" id="journey"><div class="section-label">03 / WEEKLY RHYTHM</div><div class="schedule-grid"><div><h2>Small steps.<br /><em>Every week.</em></h2><p>Rutinitas yang konsisten adalah tempat perkembangan nyata dimulai.</p><a class="inline-link" href="/program">Lihat seluruh program <span>→</span></a></div><div class="schedule-cards">{schedules.length ? schedules.map((item: any, i: number) => <div class="schedule-card"><span>0{i+1}</span><strong>{item.day || 'Sesi latihan'}</strong><p>{item.info || 'Jadwal akan diperbarui.'}</p></div>) : <div class="schedule-card"><span>01</span><strong>Latihan mingguan</strong><p>Hubungi admin untuk slot terbaru.</p></div>}{tournaments[0] && <div class="schedule-card featured"><span>GAME DAY</span><strong>{tournaments[0].name}</strong><p>{tournaments[0].info}</p></div>}</div></div></section>
    <section class="gallery section"><div class="gallery-head"><div><div class="section-label">04 / MOMENTS</div><h2>The work behind<br /><em>the game.</em></h2></div><a class="inline-link" href="/berita">Lihat berita & prestasi <span>→</span></a></div><div class="gallery-grid">{gallery.length ? gallery.map((item: any, i: number) => <figure class:list={{wide:i===0}}><img src={item.image || item.src || '/images/gallery-1.svg'} alt={item.title || 'Kegiatan SSB Bhayangkara Junior'} loading="lazy" /><figcaption>{item.title || 'Bhayangkara Junior 2018'} <span>0{i+1}</span></figcaption></figure>) : <div class="gallery-empty">Dokumentasi kegiatan akan tampil di sini.</div>}</div></section>
    <section class="cta" id="contact"><div class="cta-inner"><div><div class="eyebrow"><span></span> Start the journey</div><h2>One session can<br /><em>change everything.</em></h2><p>Kenali program kami dan mulai percakapan dengan tim SSB Bhayangkara Junior.</p></div><div class="cta-actions"><a class="button gold" href="/pendaftaran">Daftar siswa baru <span>↗</span></a>{wa && <a class="whatsapp" href={`https://wa.me/${wa}`} target="_blank" rel="noopener">Chat WhatsApp <span>↗</span></a>}</div></div></section>
  </main>
  <footer class="footer"><div><a class="brand" href="/"><img src="/icons/logo.svg" alt="" /><span><b>BHAYANGKARA</b><small>JUNIOR 2018 · FOOTBALL ACADEMY</small></span></a><p>Developing players with purpose, character, and joy.</p></div><div class="footer-links"><a href="/tentang">Tentang</a><a href="/program">Program</a><a href="/berita">Berita</a><a href="/kontak">Kontak</a><a href="/login">Login anggota</a></div><small>© 2018—2026 SSB Bhayangkara Junior</small></footer>
</Layout>
<script is:inline>const menu=document.querySelector('[data-menu]'),mobile=document.querySelector('[data-mobile]');menu?.addEventListener('click',()=>mobile?.classList.toggle('open'));</script>
<style>
:global(body){background:#f7f8f4;color:#17362a;font-family:Inter,system-ui,sans-serif}.site-nav{position:absolute;z-index:10;top:0;left:0;right:0;border-bottom:1px solid rgba(255,255,255,.12);color:#fff}.nav-wrap{width:min(1240px,calc(100% - 48px));height:86px;margin:auto;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;align-items:center;gap:10px;color:inherit}.brand img{width:38px;height:48px;object-fit:contain}.brand b,.brand small{display:block}.brand b{font-size:13px;letter-spacing:.12em}.brand small{margin-top:4px;color:#a7c9b7;font-size:8px;letter-spacing:.16em}.site-nav nav{display:flex;align-items:center;gap:27px;font-size:12px;font-weight:800}.site-nav nav a:hover{color:#ffd65b}.nav-apply{padding:12px 15px;border:1px solid rgba(255,214,91,.7);border-radius:5px;color:#ffd65b}.nav-menu,.mobile-nav{display:none}.hero{position:relative;min-height:740px;background:#063a27;color:#fff;overflow:hidden}.hero:before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 72% 40%,rgba(32,149,91,.45),transparent 34%),linear-gradient(110deg,#031a11,#075a37)}.hero-grid{position:relative;z-index:1;width:min(1240px,calc(100% - 48px));min-height:680px;margin:auto;display:grid;grid-template-columns:1fr 1fr;align-items:center}.hero-copy{padding-top:70px}.eyebrow{display:flex;gap:10px;align-items:center;color:#ffd65b;font-size:11px;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.eyebrow span{width:7px;height:7px;border-radius:50%;background:#ffd65b}.hero h1{font-size:clamp(54px,7vw,94px);line-height:.9;letter-spacing:-.075em;margin:22px 0}.hero h1 i,h2 em{font-style:normal;color:#ffd65b}.hero-copy>p{max-width:530px;color:#c4dbce;line-height:1.75;font-size:17px}.hero-actions{display:flex;align-items:center;gap:22px;margin-top:28px}.button{display:inline-flex;align-items:center;gap:14px;padding:14px 19px;border-radius:4px;font-size:12px;font-weight:900}.gold{background:#ffd65b;color:#10271c}.text-button{padding-left:0;color:#d7e7dd}.hero-trust{display:flex;gap:36px;margin-top:65px;padding-top:20px;border-top:1px solid rgba(255,255,255,.18)}.hero-trust strong,.hero-trust small{display:block}.hero-trust strong{font-size:15px;color:#f6d66e}.hero-trust small{margin-top:5px;color:#91b3a0;font-size:10px}.hero-visual{position:relative;height:500px}.visual-orbit{position:absolute;width:390px;height:390px;right:8%;top:50%;transform:translateY(-50%);border:1px solid rgba(255,214,91,.42);border-radius:50%;box-shadow:0 0 0 45px rgba(255,214,91,.025),0 0 100px rgba(41,170,105,.32)}.visual-orbit:before{content:'BJ';position:absolute;inset:22px;display:grid;place-items:center;border-radius:50%;color:rgba(255,255,255,.08);font-size:190px;font-weight:1000;letter-spacing:-.12em}.visual-number{position:absolute;right:8%;top:15%;font-size:13px;color:#ffd65b;font-weight:900}.visual-caption{position:absolute;right:5%;bottom:10%;text-align:right}.visual-caption span,.visual-caption b{display:block}.visual-caption span{color:#8eb5a0;font-size:9px;letter-spacing:.18em}.visual-caption b{margin-top:8px;font-size:22px;line-height:1;color:#fff}.visual-ball{position:absolute;right:33%;bottom:25%;font-size:80px;filter:drop-shadow(0 15px 20px rgba(0,0,0,.3))}.hero-bottom{position:absolute;bottom:0;left:0;right:0;display:flex;justify-content:space-between;padding:15px max(24px,calc((100% - 1240px)/2));border-top:1px solid rgba(255,255,255,.13);color:#87aa96;font-size:9px;letter-spacing:.16em}.marquee{overflow:hidden;padding:14px 0;background:#ffd65b;color:#17362a;font-size:11px;font-weight:1000;letter-spacing:.16em;white-space:nowrap}.marquee div{word-spacing:22px}.marquee span{font-size:8px}.section{width:min(1120px,calc(100% - 48px));margin:auto;padding:110px 0}.section-label{color:#b08a20;font-size:10px;font-weight:900;letter-spacing:.16em}.section-label.light{color:#9fc9b3}.academy-head,.program-head,.schedule-grid,.gallery-head{display:grid;grid-template-columns:1.1fr .9fr;gap:70px;align-items:end;margin-top:28px}.section h2{font-size:clamp(42px,6vw,72px);line-height:.93;letter-spacing:-.07em;margin:0}.section h2 em{color:#c09319}.academy-head p,.program-head>p,.schedule-grid p{max-width:420px;color:#71877a;line-height:1.75;font-size:16px}.inline-link{display:inline-flex;gap:16px;margin-top:18px;color:#17613f;font-size:12px;font-weight:900;border-bottom:1px solid #b6cdbf;padding-bottom:8px}.principles{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:70px;background:#d6e2da}.principles article{padding:28px;background:#f7f8f4}.principles span{color:#b08a20;font-size:11px;font-weight:900}.principles h3{font-size:25px;margin:35px 0 10px}.principles p{margin:0;color:#71877a;line-height:1.7;font-size:14px}.program{width:100%;padding-left:max(24px,calc((100% - 1120px)/2));padding-right:max(24px,calc((100% - 1120px)/2));background:#083c29;color:#fff}.program-head>p{color:#abc9b7}.program h2 em{color:#ffd65b}.program-list{margin:60px 0 30px;border-top:1px solid rgba(255,255,255,.16)}.program-list article{display:grid;grid-template-columns:120px 1fr 40px;align-items:center;gap:28px;padding:24px 0;border-bottom:1px solid rgba(255,255,255,.16)}.program-age{color:#ffd65b;font-size:22px;font-weight:900}.program-list h3{margin:0;font-size:21px}.program-list p{margin:6px 0 0;color:#a7c8b6;font-size:14px}.program-list article>span{color:#7fa994;text-align:right}.light-button{border:1px solid #81a994;color:#d5e8dc}.schedule{background:#eef3ee;max-width:none;padding-left:max(24px,calc((100% - 1120px)/2));padding-right:max(24px,calc((100% - 1120px)/2))}.schedule h2{color:#173b2b}.schedule-cards{display:grid;grid-template-columns:1fr 1fr;gap:10px}.schedule-card{padding:22px;background:#fff;border:1px solid #dce7df}.schedule-card>span{color:#b08a20;font-size:10px;font-weight:900}.schedule-card strong{display:block;margin:30px 0 5px;font-size:18px}.schedule-card p{margin:0;font-size:13px}.schedule-card.featured{grid-column:span 2;background:#083c29;color:#fff}.schedule-card.featured p{color:#a7c8b6}.gallery{padding-bottom:120px}.gallery-head{align-items:end;margin-bottom:38px}.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.gallery-grid figure{position:relative;margin:0;aspect-ratio:1.1;overflow:hidden;background:#dce8df}.gallery-grid figure.wide{grid-column:span 2;aspect-ratio:2.25}.gallery-grid img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.8);transition:.35s}.gallery-grid figure:hover img{transform:scale(1.04);filter:saturate(1)}.gallery-grid figcaption{position:absolute;bottom:0;left:0;right:0;padding:14px;color:#fff;font-size:11px;font-weight:800;background:linear-gradient(transparent,rgba(0,0,0,.7))}.gallery-grid figcaption span{float:right;color:#ffd65b}.gallery-empty{grid-column:1/-1;padding:60px;text-align:center;background:#eef3ee;color:#71877a}.cta{padding:100px 24px;background:#ffd65b;color:#17362a}.cta-inner{width:min(1120px,100%);margin:auto;display:flex;justify-content:space-between;align-items:end;gap:30px}.cta h2{font-size:clamp(45px,6vw,75px);line-height:.92;letter-spacing:-.07em;margin:20px 0}.cta h2 em{color:#083c29}.cta p{color:#587362;max-width:390px;line-height:1.7}.cta .eyebrow{color:#587362}.cta .eyebrow span{background:#083c29}.cta-actions{display:grid;gap:12px}.cta .gold{background:#083c29;color:#ffd65b}.whatsapp{padding:14px 19px;border:1px solid #587362;color:#17362a;font-size:12px;font-weight:900}.footer{display:flex;align-items:end;justify-content:space-between;gap:30px;padding:42px max(24px,calc((100% - 1120px)/2));background:#031a11;color:#fff}.footer p{color:#88a895;font-size:12px}.footer-links{display:flex;gap:20px;color:#a8c8b6;font-size:11px;font-weight:800}.footer>small{color:#759281;font-size:10px}@media(max-width:800px){.nav-wrap{width:calc(100% - 32px);height:72px}.site-nav nav{display:none}.nav-menu{display:block;border:0;background:none;color:#ffd65b;font-size:25px}.mobile-nav{display:none;flex-direction:column;padding:8px 18px 15px;background:#063422}.mobile-nav.open{display:flex}.mobile-nav a{padding:12px;color:#d8e9df;font-weight:800}.hero{min-height:760px}.hero-grid{width:calc(100% - 32px);grid-template-columns:1fr;min-height:auto}.hero-copy{padding-top:145px}.hero-visual{height:210px;margin-top:10px}.visual-orbit{width:200px;height:200px;right:16%;top:42%}.visual-orbit:before{font-size:80px}.visual-ball{right:35%;bottom:12%;font-size:40px}.visual-caption{right:0;bottom:0}.visual-caption b{font-size:15px}.hero-trust{gap:16px;margin-top:45px}.hero-bottom{font-size:7px}.section{padding:75px 0}.academy-head,.program-head,.schedule-grid,.gallery-head{grid-template-columns:1fr;gap:25px}.principles{grid-template-columns:1fr;margin-top:42px}.program-list article{grid-template-columns:75px 1fr}.program-list article>span{display:none}.schedule-cards{grid-template-columns:1fr}.schedule-card.featured{grid-column:auto}.gallery-grid{grid-template-columns:1fr 1fr}.gallery-grid figure.wide{grid-column:span 2}.cta-inner{display:block}.cta-actions{margin-top:30px}.footer{display:block}.footer-links{flex-wrap:wrap;margin:30px 0}.footer>small{display:block}}@media(max-width:450px){.hero h1{font-size:52px}.hero-trust{display:grid;grid-template-columns:1fr 1fr}.hero-trust div:last-child{grid-column:span 2}.hero-bottom span:last-child{display:none}}
</style>

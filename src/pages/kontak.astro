---
import Layout from '../layouts/Layout.astro';
import PublicNav from '../components/PublicNav.astro';
import PublicFooter from '../components/PublicFooter.astro';
import { getContent } from '../lib/contentStore';
const content = await getContent();
const phone = String(content.contact?.whatsapp || '').replace(/\D/g, '');
const instagram = String(content.contact?.instagram || '').replace(/^@/, '');
---
<Layout title="Kontak SSB Bhayangkara Junior 2018 | Pendaftaran dan Lokasi">
  <PublicNav active="kontak" />
  <main id="main-content" class="contact-page">
    <section class="contact-hero"><div class="pro-wrap"><span class="eyebrow">Hubungi Kami</span><h1>Langkah pertama<br /><span>dimulai dari sini.</span></h1><p>Ingin mengetahui program, jadwal latihan, atau proses pendaftaran? Tim kami siap membantu orang tua menemukan informasi yang tepat.</p></div></section>
    <section class="contact-section"><div class="pro-wrap contact-grid"><div><span class="eyebrow">Informasi SSB</span><h2>Datang, bertanya,<br /><span>dan mulai mengenal.</span></h2><div class="contact-cards"><div><b>Lokasi Latihan</b><p>{content.contact?.address || 'Pamulang, Tangerang Selatan, Banten'}</p></div>{phone && <div><b>WhatsApp Admin</b><p><a href={`https://wa.me/${phone}`} target="_blank" rel="noopener">+{phone} <span>↗</span></a></p></div>}{instagram && <div><b>Instagram</b><p><a href={`https://instagram.com/${instagram}`} target="_blank" rel="noopener">@{instagram} <span>↗</span></a></p></div>}</div></div><div class="contact-panel"><span class="eyebrow">Pendaftaran Siswa Baru</span><h3>Siap melihat anak berkembang?</h3><p>Isi formulir pendaftaran untuk memulai proses bersama tim SSB Bhayangkara Junior 2018.</p><a class="primary" href="/pendaftaran">Isi Formulir Pendaftaran <span>→</span></a><div class="or"><span>atau</span></div>{phone && <a class="whatsapp" href={`https://wa.me/${phone}?text=${encodeURIComponent('Halo Admin SSB Bhayangkara Junior, saya ingin bertanya tentang pendaftaran siswa baru.')}`} target="_blank" rel="noopener">Chat melalui WhatsApp</a>}</div></div></section>
    <section class="faq-section"><div class="pro-wrap"><div class="section-title"><span class="eyebrow">Pertanyaan Umum</span><h2>Sebelum <span>bergabung.</span></h2></div><div class="faq-grid"><details open><summary>Apakah anak harus sudah bisa bermain?</summary><p>Tidak. Program kami terbuka untuk anak yang baru mulai maupun yang sudah memiliki pengalaman bermain.</p></details><details><summary>Bagaimana cara mengetahui jadwal latihan?</summary><p>Jadwal terbaru tersedia di halaman Program dan dapat dikonfirmasi melalui WhatsApp admin.</p></details><details><summary>Apakah ada kelompok berdasarkan usia?</summary><p>Ya. Pembinaan dikelompokkan berdasarkan tahap usia dan kebutuhan perkembangan anak.</p></details><details><summary>Apa yang perlu disiapkan saat mendaftar?</summary><p>Siapkan data anak, data orang tua/wali, dan dokumen pendukung sesuai petunjuk pada formulir.</p></details></div></div></section>
  </main>
  <PublicFooter />
</Layout>
<style>
.contact-page{background:#f4f8f5;color:#123126}.pro-wrap{width:min(1180px,calc(100% - 36px));margin:auto}.contact-hero{padding:110px 0 100px;background:linear-gradient(120deg,#032b1d,#075d39);color:#fff}.eyebrow{color:#b78b15;font-size:12px;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.contact-hero .eyebrow{color:#ffd84f}.contact-hero h1{font-size:clamp(48px,7vw,86px);line-height:.95;letter-spacing:-.06em;margin:18px 0}.contact-hero h1 span,h2 span{color:#ffd84f}.contact-hero p{max-width:630px;color:#d5e5dc;font-size:19px;line-height:1.65}.contact-section,.faq-section{padding:95px 0}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px}.contact-grid h2,.section-title h2{font-size:clamp(36px,5vw,58px);line-height:.98;letter-spacing:-.05em;margin:12px 0 34px}.contact-cards{display:grid;gap:12px}.contact-cards div{padding:18px 20px;border-left:3px solid #f4c52d;background:#fff}.contact-cards b{font-size:13px;text-transform:uppercase;letter-spacing:.08em}.contact-cards p{margin:7px 0 0;color:#587066;line-height:1.5}.contact-cards a{color:#075d39;font-weight:800}.contact-panel{padding:34px;border-radius:24px;background:#032b1d;color:#fff;box-shadow:0 20px 50px rgba(3,43,29,.13)}.contact-panel .eyebrow{color:#ffd84f}.contact-panel h3{font-size:32px;margin:15px 0 10px}.contact-panel p{color:#bcd0c5;line-height:1.7}.primary,.whatsapp{display:inline-flex;align-items:center;gap:10px;padding:14px 20px;border-radius:999px;font-weight:900}.primary{background:#f4c52d;color:#052217}.or{display:flex;align-items:center;gap:12px;margin:22px 0;color:#91ab9e}.or:before,.or:after{content:'';height:1px;background:rgba(255,255,255,.15);flex:1}.whatsapp{border:1px solid #36c979;color:#aaf1c3}.faq-section{background:#fff}.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.faq-grid details{padding:20px;border:1px solid #d5e5dc;border-radius:14px}.faq-grid summary{cursor:pointer;font-weight:900}.faq-grid p{color:#587066;line-height:1.7;margin:15px 0 0}@media(max-width:760px){.contact-grid,.faq-grid{grid-template-columns:1fr;gap:38px}}
</style>

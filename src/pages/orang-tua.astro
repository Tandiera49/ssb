---
export const prerender = false;
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#073b2a" />
  <title>Orang Tua · SSB Bhayangkara Junior 2018</title>

  <style>
    :root {
      --green: #073b2a;
      --green2: #0b5139;
      --green3: #0f6b4a;
      --gold: #d6ad3a;
      --cream: #f6f2e8;
      --white: #fff;
      --muted: #aebbb5;
      --line: rgba(255, 255, 255, 0.10);
      --card: rgba(255, 255, 255, 0.055);
      --danger: #e88989;
      --success: #77d59a;
      --info: #9dc4e8;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--white);
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: radial-gradient(circle at 85% 0%, rgba(214, 173, 58, 0.14), transparent 30%),
                  linear-gradient(145deg, var(--green), #031e16 75%);
    }

    button { font: inherit; }

    .wrap {
      width: min(1180px, calc(100% - 32px));
      margin: auto;
      padding: 20px 0 60px;
    }

    /* --- HEADER & HERO --- */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 8px 0 28px;
    }
    .brand {
      color: var(--gold);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .logout {
      border: 1px solid rgba(214, 173, 58, 0.45);
      background: rgba(0, 0, 0, 0.12);
      color: var(--gold);
      border-radius: 10px;
      padding: 9px 16px;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      transition: all 0.2s;
    }
    .logout:hover { background: rgba(214, 173, 58, 0.15); }

    .hero { padding: 16px 0 32px; }
    .eyebrow {
      color: var(--gold);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.16em;
    }
    h1 {
      margin: 10px 0 12px;
      font-size: clamp(32px, 6vw, 56px);
      line-height: 1.1;
    }
    .hero p {
      color: var(--muted);
      max-width: 650px;
      line-height: 1.6;
      margin: 0;
      font-size: 15px;
    }

    .notice {
      margin: 0 0 24px;
      padding: 16px 20px;
      border: 1px solid rgba(214, 173, 58, 0.3);
      border-radius: 14px;
      background: rgba(214, 173, 58, 0.07);
      color: #eee7d2;
      line-height: 1.5;
    }
    .notice strong { color: var(--gold); }

    /* --- STATS --- */
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 24px;
    }
    .stat, .panel {
      border: 1px solid var(--line);
      background: var(--card);
      border-radius: 16px;
    }
    .stat { padding: 20px; }
    .stat span.label {
      color: var(--muted);
      display: block;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 8px;
    }
    .stat strong {
      display: block;
      font-size: 26px;
      color: var(--gold);
      line-height: 1;
    }

    /* --- LAYOUT & PANELS --- */
    .layout {
      display: grid;
      grid-template-columns: 1.35fr 0.9fr;
      gap: 20px;
    }
    .panel { padding: 24px; }
    .panel.full { grid-column: 1 / -1; }
    
    .panel-title {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .panel-title h2 { font-size: 18px; margin: 0; color: var(--white); }
    .panel-title span {
      color: var(--gold);
      font-size: 11px;
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* --- PROFILE & GENERAL LISTS --- */
    .profile {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .field {
      padding: 14px 16px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
      background: rgba(0, 0, 0, 0.12);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .field span.label {
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .field strong {
      color: var(--white);
      font-size: 14px;
      line-height: 1.4;
      word-break: break-word;
    }

    .list { display: grid; gap: 10px; }
    .row {
      padding: 14px 16px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: rgba(0, 0, 0, 0.12);
    }
    .row strong { display: block; font-size: 14px; color: var(--white); line-height: 1.4; }
    .row span { display: block; color: var(--muted); font-size: 13px; margin-top: 6px; line-height: 1.5; }

    /* --- ATTENDANCE --- */
    .attendance-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 10px;
    }
    .att {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 14px 8px;
      text-align: center;
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
      background: rgba(0, 0, 0, 0.12);
    }
    .att span.label {
      color: var(--muted);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .att strong {
      color: var(--gold);
      font-size: 22px;
      line-height: 1;
      font-weight: 800;
    }

    /* --- EVALUATION (RADAR & METRICS) --- */
    .radar-wrap {
      display: flex;
      justify-content: center;
      padding: 10px;
      margin-bottom: 10px;
    }
    canvas {
      width: min(100%, 300px);
      height: auto;
      aspect-ratio: 1;
    }
    
    .eval-summary {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 16px;
    }
    .eval-meta {
      display: flex;
      flex-direction: column;
      gap: 6px;
      background: rgba(0, 0, 0, 0.15);
      padding: 12px;
      border-radius: 10px;
      text-align: center;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .eval-meta span.label {
      font-size: 10px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
      font-weight: 800;
    }
    .eval-meta strong {
      font-size: 13px;
      color: var(--white);
      line-height: 1.3;
    }
    
    .eval-average {
      display: flex;
      flex-direction: column;
      gap: 8px;
      text-align: center;
      padding: 20px;
      background: rgba(214, 173, 58, 0.08);
      border: 1px solid rgba(214, 173, 58, 0.2);
      border-radius: 12px;
      margin: 16px 0;
    }
    .eval-average span.label {
      color: var(--gold);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 800;
    }
    .eval-average strong {
      font-size: 28px;
      color: var(--gold);
      line-height: 1;
      font-weight: 900;
    }
    
    .eval-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .eval-item {
      background: rgba(0, 0, 0, 0.15);
      padding: 14px 16px;
      border-radius: 12px;
      border: 1px solid var(--line);
    }
    .eval-item-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }
    .eval-item-head strong { font-size: 14px; color: var(--white); }
    .eval-score { font-weight: 800; color: var(--gold); font-size: 13px; }
    .eval-bar {
      height: 6px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 4px;
      margin-bottom: 8px;
      overflow: hidden;
    }
    .eval-bar span {
      display: block;
      height: 100%;
      background: var(--gold);
      border-radius: 4px;
      transition: width 0.5s ease-in-out;
    }
    .eval-definition {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.5;
    }
    .eval-change {
      margin-top: 16px;
      padding: 14px;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 12px;
      border: 1px dashed var(--line);
      font-size: 13px;
      color: var(--muted);
      text-align: center;
      line-height: 1.6;
    }
    .eval-change strong { color: var(--white); font-weight: 700; }
    
    .eval-note {
      margin-top: 16px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.6;
      text-align: center;
    }

    /* --- FINANCE / INVOICES --- */
    .finance-summary {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 20px;
    }
    .finance-stat {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 16px;
      border: 1px solid rgba(214, 173, 58, 0.2);
      border-radius: 12px;
      background: rgba(214, 173, 58, 0.06);
    }
    .finance-stat span.label {
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .finance-stat strong {
      color: var(--gold);
      font-size: 18px;
      font-weight: 800;
    }
    
    .finance-invoices { display: grid; gap: 10px; }
    .invoice-row {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: center;
      padding: 16px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: rgba(0,0,0, 0.15);
    }
    .invoice-info { flex: 1; min-width: 0; }
    .invoice-info strong { 
      display: block; 
      font-size: 14px; 
      color: var(--white);
      line-height: 1.4; 
      margin-bottom: 6px;
    }
    .invoice-info span.label { 
      display: block; 
      color: var(--muted); 
      font-size: 12px; 
    }
    .invoice-amount { 
      text-align: right; 
      white-space: nowrap; 
    }
    .invoice-amount b { 
      display: block; 
      color: var(--gold); 
      font-size: 16px; 
      margin-bottom: 6px;
    }
    .invoice-status {
      display: inline-block;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 4px 10px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.1);
    }
    .invoice-status.paid { background: rgba(119, 213, 154, 0.15); color: var(--success); }
    .invoice-status.overdue { background: rgba(227, 141, 141, 0.15); color: var(--danger); }
    .invoice-status.upcoming { background: rgba(157, 196, 232, 0.15); color: var(--info); }
    
    .finance-note, .finance-empty {
      margin: 20px 0 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.6;
      text-align: center;
    }

    /* --- SECURITY FORM --- */
    .security-panel { margin-top: 20px; }
    .security-form {
      display: grid;
      gap: 16px;
      max-width: 620px;
    }
    .security-field { display: grid; gap: 8px; }
    .security-field label {
      color: var(--muted);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .security-field input {
      width: 100%;
      min-height: 48px;
      padding: 12px 16px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      outline: none;
      color: var(--white);
      background: rgba(0, 0, 0, 0.18);
      font: inherit;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .security-field input:focus {
      border-color: rgba(214, 173, 58, 0.65);
      box-shadow: 0 0 0 3px rgba(214, 173, 58, 0.1);
    }
    .security-actions {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-top: 8px;
    }
    .security-submit {
      border: 0;
      border-radius: 12px;
      padding: 14px 24px;
      color: #071b14;
      background: var(--gold);
      font-weight: 900;
      cursor: pointer;
      font-size: 14px;
      transition: opacity 0.2s;
    }
    .security-submit:hover { opacity: 0.9; }
    .security-submit:disabled { opacity: 0.55; cursor: not-allowed; }
    
    .security-message {
      min-height: 20px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.5;
    }
    .security-message.success { color: var(--success); }
    .security-message.error { color: var(--danger); }

    /* --- UTILITIES --- */
    .empty {
      padding: 24px 20px;
      text-align: center;
      color: var(--muted);
      border: 1px dashed var(--line);
      border-radius: 12px;
      font-size: 13px;
      line-height: 1.6;
    }

    /* --- RESPONSIVE DESIGN / MOBILE TWEAKS --- */
    @media(max-width: 900px) {
      .layout { grid-template-columns: 1fr; }
      .panel.full { grid-column: auto; }
    }

    @media(max-width: 768px) {
      .stats { grid-template-columns: repeat(2, 1fr); }
      .eval-summary { grid-template-columns: 1fr; gap: 8px; }
      .finance-summary { grid-template-columns: 1fr; gap: 10px; }
    }

    @media(max-width: 540px) {
      .wrap { width: calc(100% - 24px); padding: 16px 0 40px; }
      h1 { font-size: 28px; }
      .profile { grid-template-columns: 1fr; }
      
      .attendance-grid { 
        grid-template-columns: repeat(2, 1fr); 
      }
      .attendance-grid .att:last-child {
        grid-column: 1 / -1;
      }
      
      .panel { padding: 16px; }
      .stat { padding: 16px; }
      
      .invoice-row { 
        flex-direction: column; 
        align-items: flex-start; 
        gap: 12px; 
      }
      .invoice-amount { 
        width: 100%; 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        border-top: 1px dashed var(--line); 
        padding-top: 12px;
        text-align: left;
      }
      .invoice-amount b { margin-bottom: 0; }
      
      .security-actions { flex-direction: column; align-items: stretch; }
      .security-submit { width: 100%; }
    }
  </style>
</head>

<body>
  <div class="wrap">
    <header>
      <div class="brand">SSB Bhayangkara Junior 2018</div>
      <button id="logout" class="logout" type="button">Keluar</button>
    </header>

    <main>
      <section class="hero">
        <div class="eyebrow">ORANG TUA / WALI</div>
        <h1 id="welcome">Dashboard Orang Tua</h1>
        <p>Pantau perkembangan anak, kehadiran, jadwal latihan, evaluasi pelatih, dan informasi SSB dari satu tempat.</p>
      </section>

      <div id="notice" class="notice" hidden></div>

      <section class="stats">
        <div class="stat"><span class="label">Kehadiran</span><strong id="statHadir">0</strong></div>
        <div class="stat"><span class="label">Penilaian</span><strong id="statEval">0</strong></div>
        <div class="stat"><span class="label">Status</span><strong id="statStatus">-</strong></div>
        <div class="stat"><span class="label">Pembayaran</span><strong id="statPayment">-</strong></div>
      </section>

      <section class="layout">
        <article class="panel">
          <div class="panel-title">
            <h2>Profil Anak</h2>
            <span>Data siswa</span>
          </div>
          <div id="profile" class="profile"></div>
        </article>

        <article class="panel">
          <div class="panel-title">
            <h2>Ringkasan Kehadiran</h2>
            <span>Absensi</span>
          </div>
          <div id="attendance" class="attendance-grid"></div>
        </article>

        <article class="panel">
          <div class="panel-title">
            <h2>Evaluasi Perkembangan</h2>
            <span id="evalPeriod">Belum ada</span>
          </div>
          <div class="radar-wrap">
            <canvas id="radar" width="330" height="330"></canvas>
          </div>
          <div id="evalInfo">
             <div class="eval-note">Belum ada penilaian dari pelatih.</div>
          </div>
          <div class="eval-note">
            Nilai diberikan oleh pelatih berdasarkan perkembangan latihan dan pertandingan.
          </div>
        </article>

        <article class="panel">
          <div class="panel-title">
            <h2>Jadwal Latihan</h2>
            <span>Aktif</span>
          </div>
          <div id="schedules" class="list"></div>
        </article>

        <article class="panel full">
          <div class="panel-title">
            <h2>Catatan Pelatih</h2>
            <span>Evaluasi terbaru</span>
          </div>
          <div id="notes" class="list"></div>
        </article>

        <article class="panel">
          <div class="panel-title">
            <h2>Pengumuman</h2>
            <span>Informasi</span>
          </div>
          <div id="announcements" class="list"></div>
        </article>

        <article class="panel">
          <div class="panel-title">
            <h2>Turnamen</h2>
            <span>Agenda</span>
          </div>
          <div id="tournaments" class="list"></div>
        </article>

        <article class="panel full finance-panel">
          <div class="panel-title">
            <h2>Tagihan & Riwayat Pembayaran</h2>
            <span>Informasi pembayaran</span>
          </div>
          <div id="financeSummary" class="finance-summary"></div>
          <div id="financeInvoices" class="finance-invoices"></div>
          <p class="finance-note">Pembayaran dilakukan secara manual melalui Admin SSB. Website ini hanya menampilkan tagihan dan laporan pembayaran.</p>
        </article>
      </section>

      <article class="panel full security-panel">
        <div class="panel-title">
          <h2>Keamanan Akun</h2>
          <span>Password</span>
        </div>

        <div class="security-form">
          <div class="eval-note" style="text-align: left; margin-top: 0; margin-bottom: 8px;">
            Ganti password menggunakan password lama. Setelah berhasil, kamu akan diminta login kembali.
          </div>

          <div class="security-field">
            <label for="currentPassword">Password Lama</label>
            <input id="currentPassword" type="password" autocomplete="current-password" placeholder="Masukkan password lama">
          </div>

          <div class="security-field">
            <label for="newPassword">Password Baru</label>
            <input id="newPassword" type="password" autocomplete="new-password" minlength="8" placeholder="Minimal 8 karakter">
          </div>

          <div class="security-field">
            <label for="confirmPassword">Konfirmasi Password Baru</label>
            <input id="confirmPassword" type="password" autocomplete="new-password" minlength="8" placeholder="Ulangi password baru">
          </div>

          <div class="security-actions">
            <button id="changePasswordBtn" class="security-submit" type="button">
              Ganti Password
            </button>
            <div id="passwordMessage" class="security-message"></div>
          </div>
        </div>
      </article>

    </main>
  </div>

  <script is:inline>
    const $ = (id) => document.getElementById(id);

    function esc(value) {
      return String(value ?? '').replace(/[&<>"']/g, ch => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'
      }[ch]));
    }

    function empty(target, text) {
      $(target).innerHTML = `<div class="empty">${esc(text)}</div>`;
    }

    function field(label, value) {
      return `
        <div class="field">
          <span class="label">${esc(label)}</span>
          <strong>${esc(value || '-')}</strong>
        </div>
      `;
    }

    function drawRadar(evaluation) {
      const canvas = $('radar');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      const wrap = canvas.closest('.radar-wrap');

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (!evaluation) {
        if (wrap) {
          wrap.innerHTML = `
            <div class="empty">
              Belum ada evaluasi dari pelatih.<br>
              Nilai perkembangan akan tampil setelah pelatih mengisi penilaian.
            </div>
          `;
        }
        return;
      }

      if (wrap && !canvas.isConnected) return;

      const labels = ['Teknik','Taktik','Fisik','Mental','Kerja Sama'];
      const keys = ['technical','tactical','physical','mental','teamwork'];
      const values = keys.map(key => {
        const value = Number(evaluation?.[key]);
        return Number.isFinite(value) ? Math.max(0, Math.min(10, value)) : 0;
      });

      const rect = canvas.getBoundingClientRect();
      const size = Math.max(220, Math.min(330, Math.round(rect.width || 300)));
      const ratio = window.devicePixelRatio || 1;

      canvas.width = size * ratio;
      canvas.height = size * ratio;
      canvas.style.width = size + 'px';
      canvas.style.height = size + 'px';

      ctx.setTransform(ratio,0,0,ratio,0,0);

      const cx = size / 2;
      const cy = size / 2;
      const radius = size * .31;
      const levels = 5;
      const step = (Math.PI * 2) / labels.length;
      const startAngle = -Math.PI / 2;

      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(255,255,255,.12)';
      ctx.fillStyle = 'rgba(214,173,58,.18)';

      for(let level=1; level<=levels; level++){
        const r = radius * level / levels;
        ctx.beginPath();

        labels.forEach((_,i)=>{
          const a = startAngle + step * i;
          const x = cx + Math.cos(a) * r;
          const y = cy + Math.sin(a) * r;
          i === 0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);
        });

        ctx.closePath();
        ctx.stroke();
      }

      labels.forEach((label,i)=>{
        const a = startAngle + step * i;
        const x = cx + Math.cos(a) * radius;
        const y = cy + Math.sin(a) * radius;

        ctx.beginPath();
        ctx.moveTo(cx,cy);
        ctx.lineTo(x,y);
        ctx.stroke();

        ctx.fillStyle = 'rgba(214,173,58,.95)';
        ctx.font = '700 11px Arial';
        ctx.textAlign = x < cx - 8 ? 'right' : x > cx + 8 ? 'left' : 'center';
        ctx.textBaseline = y < cy - 8 ? 'bottom' : y > cy + 8 ? 'top' : 'middle';
        ctx.fillText(label,x + (x < cx ? -6 : x > cx ? 6 : 0),y + (y < cy ? -6 : y > cy ? 6 : 0));
      });

      ctx.beginPath();
      values.forEach((value,i)=>{
        const a = startAngle + step * i;
        const r = radius * value / 10;
        const x = cx + Math.cos(a) * r;
        const y = cy + Math.sin(a) * r;
        i === 0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);
      });
      ctx.closePath();

      ctx.fillStyle = 'rgba(214,173,58,.18)';
      ctx.fill();

      ctx.strokeStyle = 'rgba(214,173,58,.95)';
      ctx.lineWidth = 2;
      ctx.stroke();

      values.forEach((value,i)=>{
        const a = startAngle + step * i;
        const r = radius * value / 10;
        const x = cx + Math.cos(a) * r;
        const y = cy + Math.sin(a) * r;

        ctx.beginPath();
        ctx.arc(x,y,4,0,Math.PI*2);
        ctx.fillStyle = 'rgba(214,173,58,1)';
        ctx.fill();
      });
    }

    function render(data) {
      $('welcome').textContent = `Halo, ${data.user?.name || 'Orang Tua'}`;

      if (!data.linked) {
        $('notice').hidden = false;
        $('notice').innerHTML =
          '<strong>Akun belum terhubung.</strong> Data anak belum ditautkan ke akun ini oleh Admin.';
        empty('profile','Belum ada data anak yang terhubung.');
        empty('notes','Catatan akan tampil setelah akun terhubung dan pelatih memberikan evaluasi.');
      } else {
        $('notice').hidden = true;
        const p = data.player;

        $('profile').innerHTML =
          field('Nama',p.nama) +
          field('Nomor Pendaftaran',p.nomor) +
          field('Tempat / Tanggal Lahir',`${p.tempatLahir}${p.tanggalLahir ? ' / '+p.tanggalLahir : ''}`) +
          field('NISN',p.nisn) +
          field('Posisi',p.posisi) +
          field('Tinggi / Berat',`${p.tinggi || '-'} / ${p.berat || '-'}`) +
          field('Golongan Darah',p.golonganDarah) +
          field('Status Pendaftaran',p.status) +
          field('Status Pembayaran',p.paymentStatus);

        $('statStatus').textContent = p.status || '-';
        $('statPayment').textContent = p.paymentStatus || '-';
      }

      const finance = data.finance;
      if (finance) {
        $('financeSummary').innerHTML =
          `<div class="finance-stat"><span class="label">Bulan lunas</span><strong>${finance.summary.paidCount}</strong></div>` +
          `<div class="finance-stat"><span class="label">Outstanding</span><strong>Rp${Number(finance.summary.outstanding || 0).toLocaleString('id-ID')}</strong></div>` +
          `<div class="finance-stat"><span class="label">Status bulan ini</span><strong>${esc(finance.summary.currentStatus)}</strong></div>`;
        $('financeInvoices').innerHTML = (finance.invoices || []).map((invoice) =>
          `<div class="invoice-row">
             <div class="invoice-info">
               <strong>${esc(invoice.label)}</strong>
               <span class="label">Jatuh tempo ${esc(invoice.dueDate)}</span>
             </div>
             <div class="invoice-amount">
               <b>Rp${Number(invoice.amount || 0).toLocaleString('id-ID')}</b>
               <span class="invoice-status ${esc(invoice.status)}">${invoice.status === 'paid' ? 'Lunas' : invoice.status === 'overdue' ? 'Tunggakan' : invoice.status === 'unpaid' ? 'Belum lunas' : 'Belum jatuh tempo'}</span>
             </div>
           </div>`
        ).join('');
      } else {
        $('financeSummary').innerHTML = '<div class="finance-empty">Informasi tagihan hanya tersedia untuk akun Orang Tua/Wali.</div>';
        $('financeInvoices').innerHTML = '';
      }

      const summary = data.attendance?.summary || {};
      $('statHadir').textContent = summary.hadir || 0;

      // Diubah: Memastikan tag menggunakan class label untuk flexbox yang aman
      $('attendance').innerHTML =
        `<div class="att"><span class="label">Hadir</span><strong>${summary.hadir||0}</strong></div>` +
        `<div class="att"><span class="label">Izin</span><strong>${summary.izin||0}</strong></div>` +
        `<div class="att"><span class="label">Sakit</span><strong>${summary.sakit||0}</strong></div>` +
        `<div class="att"><span class="label">Alpa</span><strong>${summary.alpa||0}</strong></div>` +
        `<div class="att"><span class="label">Total</span><strong>${summary.total||0}</strong></div>`;

      const evals = data.evaluations || [];
      $('statEval').textContent = evals.length;

      const latest = data.latestEvaluation || null;
      const evaluationPeriod = latest?.period || latest?.month || 'Belum ada';
      $('evalPeriod').textContent = evaluationPeriod;

      if (latest) {
        drawRadar(latest);

        const aspects = [
          ['Teknik','technical','Passing, kontrol, dribbling, shooting, dan penguasaan bola.'],
          ['Taktik','tactical','Pemahaman posisi, pengambilan keputusan, dan membaca permainan.'],
          ['Fisik','physical','Kecepatan, daya tahan, koordinasi, dan kemampuan bergerak.'],
          ['Mental','mental','Kepercayaan diri, fokus, disiplin, dan respons saat bermain.'],
          ['Kerja Sama','teamwork','Komunikasi, kerja sama, sikap terhadap rekan, dan kontribusi tim.']
        ];

        const values = aspects.map(([label,key]) => {
          const n = Number(latest?.[key]);
          return {
            label,
            key,
            value: Number.isFinite(n) ? Math.max(0, Math.min(10,n)) : 0
          };
        });

        const average = values.length
          ? values.reduce((sum,item) => sum + item.value,0) / values.length
          : 0;

        const previous = (evals || []).find(item => item !== latest);

        let previousAverage = null;
        if (previous) {
          const previousValues = aspects.map(([,key]) => {
            const n = Number(previous?.[key]);
            return Number.isFinite(n) ? Math.max(0, Math.min(10,n)) : 0;
          });
          previousAverage = previousValues.reduce((sum,n)=>sum+n,0) / previousValues.length;
        }

        const changeText = previousAverage === null
          ? 'Belum ada pembanding'
          : `${(average - previousAverage) >= 0 ? '+' : ''}${(average - previousAverage).toFixed(1)} poin dari evaluasi sebelumnya`;

        const coachName =
          latest?.coachName ||
          latest?.coach ||
          latest?.namaPelatih ||
          latest?.pelatih ||
          'Pelatih';

        // Format Timestamp agar mudah dibaca dan ada spasinya
        let evalDateRaw = latest?.date || latest?.tanggal || latest?.createdAt || latest?.updatedAt || '';
        let evalDateFormatted = evalDateRaw;
        if (evalDateRaw && evalDateRaw.includes('T')) {
          const d = new Date(evalDateRaw);
          if (!isNaN(d.getTime())) {
            evalDateFormatted = d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
          }
        }

        const target = document.querySelector('#evalInfo');
        if (target) {
          // Catatan (notes) sudah dihapus dari HTML bawah evaluasi ini
          target.innerHTML = `
            <div class="eval-summary">
              <div class="eval-meta">
                <span class="label">Periode</span>
                <strong>${esc(evaluationPeriod)}</strong>
              </div>
              <div class="eval-meta">
                <span class="label">Pelatih</span>
                <strong>${esc(coachName)}</strong>
              </div>
              <div class="eval-meta">
                <span class="label">Tanggal</span>
                <strong>${esc(evalDateFormatted || '-')}</strong>
              </div>
            </div>

            <div class="eval-average">
              <span class="label">Rata-rata terbaru</span>
              <strong>${average.toFixed(1)} / 10</strong>
            </div>

            <div class="eval-list">
              ${values.map(item => `
                <div class="eval-item">
                  <div class="eval-item-head">
                    <strong>${esc(item.label)}</strong>
                    <span class="eval-score">${item.value.toFixed(0)} / 10</span>
                  </div>
                  <div class="eval-bar">
                    <span style="width:${item.value * 10}%"></span>
                  </div>
                  <div class="eval-definition">${esc(aspects.find(x=>x[1]===item.key)?.[2] || '')}</div>
                </div>
              `).join('')}
            </div>

            <div class="eval-change">
              Perubahan: <strong>${esc(changeText)}</strong>
            </div>
          `;
        }
      } else {
        const canvas = $('radar');
        const wrap = canvas?.closest('.radar-wrap');
        if (wrap) {
          wrap.innerHTML = `
            <div class="empty">
              Belum ada evaluasi dari pelatih.<br>
              Nilai perkembangan akan tampil setelah pelatih mengisi penilaian.
            </div>
          `;
        }
        $('evalInfo').innerHTML = '<div class="eval-note">Belum ada evaluasi dari pelatih.</div>';
      }

      const schedules = data.schedules || [];
      schedules.length
        ? $('schedules').innerHTML = schedules.map(x =>
            `<div class="row"><strong>${esc(x.day || 'Jadwal')}</strong><span>${esc(x.info || '-')}</span></div>`
          ).join('')
        : empty('schedules','Belum ada jadwal latihan.');

      const notes = evals.filter(x => x.notes);
      notes.length
        ? $('notes').innerHTML = notes.slice(0,8).map(x =>
            `<div class="row"><strong>${esc(x.period || 'Evaluasi')}</strong><span>${esc(x.notes)}</span></div>`
          ).join('')
        : $('notes').innerHTML = '<div class="empty">Belum ada catatan pelatih.</div>';

      const announcements = data.announcements || [];
      announcements.length
        ? $('announcements').innerHTML = announcements.slice(0,8).map(x =>
            `<div class="row"><strong>${esc(x.title || x.name || 'Pengumuman')}</strong><span>${esc(x.text || x.info || x.description || '')}</span></div>`
          ).join('')
        : empty('announcements','Belum ada pengumuman.');

      const tournaments = data.tournaments || [];
      tournaments.length
        ? $('tournaments').innerHTML = tournaments.map(x =>
            `<div class="row"><strong>${esc(x.name || 'Turnamen')}</strong><span>${esc(x.info || '-')}</span></div>`
          ).join('')
        : empty('tournaments','Belum ada agenda turnamen.');
    }

    async function changePassword(){
      const currentPassword=$('currentPassword').value;
      const newPassword=$('newPassword').value;
      const confirmPassword=$('confirmPassword').value;
      const message=$('passwordMessage');
      const button=$('changePasswordBtn');

      message.className='security-message';
      message.textContent='';

      if(!currentPassword||!newPassword||!confirmPassword){
        message.classList.add('error');
        message.textContent='Semua kolom password wajib diisi.';
        return;
      }

      if(newPassword.length<8){
        message.classList.add('error');
        message.textContent='Password baru minimal 8 karakter.';
        return;
      }

      if(newPassword!==confirmPassword){
        message.classList.add('error');
        message.textContent='Konfirmasi password baru tidak sama.';
        return;
      }

      button.disabled=true;
      button.textContent='Memproses...';

      try{
        const response=await fetch('/api/auth/change-password',{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({currentPassword,newPassword})
        });

        const data=await response.json().catch(()=>({}));

        if(!response.ok||!data.success){
          if(response.status===401){
            window.location.href='/login';
            return;
          }
          throw new Error(data.message||'Gagal mengganti password.');
        }

        message.classList.add('success');
        message.textContent='Password berhasil diganti. Mengarahkan ke login...';

        setTimeout(()=>{window.location.href='/login';},900);
      }catch(error){
        message.classList.add('error');
        message.textContent=error.message||'Gagal mengganti password.';
        button.disabled=false;
        button.textContent='Ganti Password';
      }
    }

    async function load() {
      try {
        const response = await fetch('/api/member/dashboard',{cache:'no-store'});
        const data = await response.json();

        if (!response.ok || !data.success) {
          if (response.status === 401) {
            window.location.href='/login';
            return;
          }
          throw new Error(data.message || 'Gagal memuat dashboard.');
        }

        if (data.role !== 'orang_tua') {
          const destinations = {
            admin:'/admin/pendaftaran',
            pelatih:'/pelatih',
            siswa:'/siswa'
          };
          window.location.href = destinations[data.role] || '/login';
          return;
        }

        render(data);
      } catch (error) {
        $('notice').hidden=false;
        $('notice').textContent=error.message || 'Gagal memuat data.';
      }
    }

    $('logout').addEventListener('click',async()=>{
      await fetch('/api/auth/logout',{method:'POST'});
      window.location.href='/login';
    });

    $('changePasswordBtn').addEventListener('click',changePassword);

    load();
  </script>
</body>
</html>

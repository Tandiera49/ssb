---
export const prerender = false;
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Pelatih · SSB Bhayangkara Junior 2018</title>

  <style>
    :root {
      --green: #063b2a;
      --green-dark: #021f16;
      --green-card: rgba(255,255,255,.055);
      --green-border: rgba(255,255,255,.10);
      --gold: #d6ad3a;
      --white: #fff;
      --muted: #aebbb5;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Inter, system-ui, sans-serif;
      color: var(--white);
      background:
        radial-gradient(circle at top right, rgba(214,173,58,.12), transparent 32%),
        linear-gradient(135deg, var(--green), var(--green-dark));
    }

    .wrap {
      width: min(1180px, calc(100% - 32px));
      margin: auto;
      padding: 28px 0 60px;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 65px;
    }

    .brand {
      color: var(--gold);
      font-weight: 800;
      font-size: 12px;
      letter-spacing: .10em;
      text-transform: uppercase;
    }

    button {
      font: inherit;
    }

    .logout {
      border: 1px solid rgba(214,173,58,.5);
      background: transparent;
      color: var(--gold);
      border-radius: 8px;
      padding: 10px 16px;
      cursor: pointer;
      font-weight: 700;
    }

    .eyebrow {
      color: var(--gold);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(38px, 7vw, 70px);
      line-height: .98;
      margin: 14px 0 16px;
    }

    .intro {
      color: var(--muted);
      font-size: 17px;
      line-height: 1.6;
      margin: 0;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-top: 42px;
    }

    .stat {
      border: 1px solid var(--green-border);
      background: var(--green-card);
      border-radius: 14px;
      padding: 22px;
    }

    .stat small {
      color: var(--muted);
      display: block;
      font-size: 12px;
      margin-bottom: 10px;
    }

    .stat strong {
      color: var(--gold);
      font-size: 34px;
    }

    .section {
      margin-top: 48px;
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 16px;
    }

    .section h2 {
      margin: 0;
      font-size: 24px;
    }

    .section-note {
      color: var(--muted);
      font-size: 13px;
    }

    .panel {
      border: 1px solid var(--green-border);
      background: rgba(255,255,255,.04);
      border-radius: 14px;
      overflow: hidden;
    }

    .schedule-row {
      display: grid;
      grid-template-columns: 150px 1fr;
      gap: 20px;
      padding: 18px 20px;
      border-bottom: 1px solid rgba(255,255,255,.07);
    }

    .schedule-row:last-child {
      border-bottom: 0;
    }

    .schedule-day {
      color: var(--gold);
      font-weight: 800;
    }

    .schedule-info {
      color: var(--white);
      line-height: 1.5;
    }

    .empty {
      padding: 28px 20px;
      color: var(--muted);
    }

    .players {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 600px;
    }

    th,
    td {
      text-align: left;
      padding: 15px 18px;
      border-bottom: 1px solid rgba(255,255,255,.07);
    }

    th {
      color: var(--gold);
      font-size: 11px;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    td {
      color: #edf3ef;
      font-size: 14px;
    }

    .status {
      display: inline-block;
      padding: 5px 9px;
      border-radius: 999px;
      color: var(--gold);
      background: rgba(214,173,58,.10);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .attendance-form {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      padding: 20px;
      border-bottom: 1px solid rgba(255,255,255,.07);
    }

    .attendance-form label {
      display: grid;
      gap: 7px;
    }

    .attendance-form label span {
      color: var(--gold);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .attendance-form input,
    .attendance-form select {
      width: 100%;
      min-height: 44px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 8px;
      background: rgba(0,0,0,.16);
      color: white;
      padding: 10px 12px;
      font: inherit;
      font-size: 16px;
    }

    .save-btn {
      align-self: end;
      min-height: 44px;
      border: 0;
      border-radius: 8px;
      background: var(--gold);
      color: #102d22;
      font-weight: 800;
      cursor: pointer;
      padding: 10px 16px;
    }

    #attendanceMessage {
      padding: 0 20px;
      color: var(--gold);
      font-size: 13px;
    }

    .attendance-table-wrap {
      overflow-x: auto;
    }

    .attendance-table-wrap table {
      min-width: 650px;
    }

    .attendance-status {
      display: inline-block;
      padding: 5px 9px;
      border-radius: 999px;
      background: rgba(214,173,58,.10);
      color: var(--gold);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .loading {
      color: var(--muted);
      padding: 20px 0;
    }

    .error {
      color: #ffb4a8;
      padding: 20px 0;
    }

    .evaluation-entry {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .evaluation-entry p {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
    }

    .evaluation-btn {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 11px 18px;
      border-radius: 8px;
      background: var(--gold);
      color: #10251c;
      text-decoration: none;
      font-weight: 800;
    }

    .evaluation-btn:hover {
      filter: brightness(1.05);
    }

    @media (max-width: 700px) {
      .wrap {
        width: min(100% - 24px, 1180px);
        padding-top: 20px;
      }

      header {
        margin-bottom: 36px;
      }

      .stats {
        grid-template-columns: 1fr;
        gap: 12px;
        margin-top: 30px;
      }

      .stat {
        padding: 17px 18px;
        border-radius: 12px;
      }

      .stat small {
        margin-bottom: 6px;
      }

      .stat strong {
        font-size: 30px;
      }

      .section {
        margin-top: 34px;
      }

      .section-head {
        align-items: flex-start;
        flex-direction: column;
        gap: 6px;
        margin-bottom: 12px;
      }

      .section h2 {
        font-size: 22px;
      }

      .schedule-row {
        grid-template-columns: 1fr;
        gap: 4px;
        padding: 14px 16px;
      }

      .attendance-form {
        grid-template-columns: 1fr;
        gap: 13px;
        padding: 16px;
      }

      .attendance-form label {
        width: 100%;
      }

      .attendance-form input,
      .attendance-form select {
        box-sizing: border-box;
        min-height: 46px;
      }

      .save-btn {
        width: 100%;
        min-height: 46px;
      }

      #attendanceMessage {
        padding: 0 16px;
      }

      .attendance-table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      .attendance-table-wrap table {
        min-width: 620px;
      }

      .players {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      table {
        min-width: 560px;
      }

      .evaluation-entry {
        flex-direction: column;
        align-items: stretch;
        gap: 14px;
      }

      .evaluation-btn {
        width: 100%;
      }
    }
  
    .attendance-player-picker {
      position: relative;
    }

    .attendance-player-picker input[type="search"] {
      width: 100%;
      box-sizing: border-box;
    }

    .attendance-player-picker .player-results {
      display: none;
      position: absolute;
      z-index: 100;
      left: 0;
      right: 0;
      top: calc(100% + 6px);
      max-height: 280px;
      overflow-y: auto;
      background: #063f2d;
      border: 1px solid rgba(230,180,20,.35);
      border-radius: 12px;
      box-shadow: 0 16px 36px rgba(0,0,0,.35);
    }

    .attendance-player-picker .player-results.show {
      display: block;
    }

    .attendance-player-picker .player-result {
      display: block;
      width: 100%;
      padding: 13px 15px;
      border: 0;
      border-bottom: 1px solid rgba(255,255,255,.08);
      background: transparent;
      color: #fff;
      text-align: left;
      cursor: pointer;
      font: inherit;
    }

    .attendance-player-picker .player-result:hover {
      background: rgba(230,180,20,.14);
    }

    .attendance-player-picker .player-result small {
      display: block;
      margin-top: 3px;
      color: rgba(255,255,255,.55);
      font-size: .75rem;
    }

    .attendance-player-picker .picker-empty {
      padding: 13px 15px;
      color: rgba(255,255,255,.65);
      font-size: .88rem;
    }

    .attendance-player-picker .picker-help {
      display: block;
      margin-top: 6px;
      color: rgba(255,255,255,.55);
      font-size: .75rem;
    }


/* ===== UI MOBILE/DESKTOP POLISH ===== */
.wrap {
  box-sizing: border-box;
}

.panel {
  box-sizing: border-box;
  width: 100%;
}

.schedule-row {
  box-sizing: border-box;
  width: 100%;
  align-items: start;
}

.schedule-info {
  min-width: 0;
  overflow-wrap: anywhere;
}

.attendance-form {
  box-sizing: border-box;
  width: 100%;
}

.attendance-form > label,
.attendance-player-picker {
  min-width: 0;
}

.attendance-form input,
.attendance-form select {
  box-sizing: border-box;
  min-width: 0;
}

.attendance-player-picker input[type="search"] {
  box-sizing: border-box;
}

.attendance-table-wrap {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.players {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

@media (max-width: 700px) {
  .wrap {
    width: calc(100% - 28px);
    max-width: none;
    margin: 0 auto;
    padding-top: 18px;
  }

  header {
    margin-bottom: 32px;
  }

  .brand {
    font-size: 13px;
  }

  .intro {
    font-size: 15px;
    line-height: 1.55;
  }

  .stats {
    gap: 12px;
    margin-top: 28px;
  }

  .stat {
    padding: 18px;
    border-radius: 16px;
  }

  .stat small {
    font-size: 12px;
    margin-bottom: 8px;
  }

  .stat strong {
    font-size: 32px;
  }

  .section {
    margin-top: 34px;
  }

  .section-head {
    display: block;
    margin-bottom: 12px;
  }

  .section h2 {
    font-size: 25px;
    line-height: 1.15;
    margin-bottom: 6px;
  }

  .section-note {
    display: block;
    font-size: 13px;
    line-height: 1.45;
  }

  .panel {
    border-radius: 16px;
  }

  .schedule-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 5px;
    padding: 16px 18px;
  }

  .schedule-day {
    font-size: 16px;
    line-height: 1.3;
  }

  .schedule-info {
    font-size: 15px;
    line-height: 1.45;
  }

  .attendance-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    padding: 18px;
  }

  .attendance-form label span {
    font-size: 11px;
  }

  .attendance-form input,
  .attendance-form select {
    width: 100%;
    min-height: 50px;
    border-radius: 11px;
    padding: 12px 14px;
  }

  .attendance-player-picker {
    width: 100%;
  }

  .attendance-player-picker input[type="search"] {
    width: 100%;
    min-height: 50px;
  }

  .save-btn {
    width: 100%;
    min-height: 50px;
    margin-top: 2px;
    border-radius: 11px;
  }

  #attendanceMessage {
    padding: 0 18px;
  }

  .attendance-table-wrap table,
  .players table {
    min-width: 620px;
  }

  th,
  td {
    padding: 13px 14px;
  }

  .evaluation-entry {
    gap: 14px;
  }

  .evaluation-btn {
    width: 100%;
    min-height: 50px;
    border-radius: 11px;
  }
}



/* ===== MOBILE UI REFINEMENT ===== */
*, *::before, *::after {
  box-sizing: border-box;
}

.panel {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.schedule-row {
  align-items: start;
  min-width: 0;
}

.schedule-row strong,
.schedule-row span,
.schedule-info {
  min-width: 0;
  overflow-wrap: anywhere;
}

.evaluation-entry {
  min-width: 0;
}

.evaluation-entry > div {
  min-width: 0;
  flex: 1 1 auto;
}

.evaluation-entry p {
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: normal;
}

.attendance-form > *,
.attendance-player-picker {
  min-width: 0;
}

@media (max-width: 700px) {
  .section {
    margin-top: 34px;
  }

  .section-head {
    display: block;
    margin-bottom: 14px;
  }

  .section h2 {
    font-size: clamp(24px, 7vw, 30px);
    line-height: 1.15;
    margin-bottom: 7px;
  }

  .section-note {
    display: block;
    line-height: 1.45;
  }

  .panel {
    border-radius: 16px;
    overflow: hidden;
  }

  /* Jadwal dibuat seperti daftar kartu profesional */
  .schedule-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 5px;
    padding: 17px 18px;
  }

  .schedule-row strong {
    display: block;
    color: var(--gold);
    font-size: 16px;
    line-height: 1.25;
    font-weight: 800;
  }

  .schedule-row .schedule-info {
    display: block;
    color: #f1f5f2;
    font-size: 15px;
    line-height: 1.55;
  }

  .schedule-row + .schedule-row {
    border-top: 1px solid rgba(255,255,255,.07);
  }

  /* Absensi */
  .attendance-form {
    grid-template-columns: 1fr;
    gap: 17px;
    padding: 18px;
  }

  .attendance-form input,
  .attendance-form select {
    min-height: 48px;
    border-radius: 10px;
  }

  .save-btn {
    width: 100%;
    min-height: 50px;
    margin-top: 2px;
    border-radius: 10px;
    font-size: 16px;
  }

  #attendanceMessage {
    padding: 0 18px;
  }

  .attendance-table-wrap {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  /* Penilaian */
  .evaluation-entry {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 18px;
    padding: 0;
  }

  .evaluation-entry p {
    margin-top: 8px;
    line-height: 1.65;
  }

  .evaluation-btn {
    width: 100%;
    min-height: 50px;
    border-radius: 10px;
    font-size: 15px;
  }

  /* Daftar pemain */
  .players {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .players table {
    min-width: 620px;
  }

  th,
  td {
    padding: 14px 16px;
  }
}



/* ===== MOBILE PROFESSIONAL SPACING ===== */
@media (max-width: 700px) {
  * {
    box-sizing: border-box;
  }

  body {
    overflow-x: hidden;
  }

  .wrap {
    width: min(100% - 32px, 1180px) !important;
    margin-left: auto;
    margin-right: auto;
  }

  .section {
    margin-top: 44px !important;
  }

  .section-head {
    margin-bottom: 16px !important;
  }

  .section-head h2 {
    margin: 0 0 7px !important;
    line-height: 1.15 !important;
  }

  .section-head p {
    margin: 0 !important;
    line-height: 1.5 !important;
  }

  /* Jadwal */
  .panel {
    width: 100% !important;
    max-width: 100% !important;
    border-radius: 18px !important;
    overflow: hidden !important;
  }

  .schedule-row {
    display: block !important;
    padding: 18px 20px !important;
    margin: 0 !important;
    line-height: 1.5 !important;
  }

  .schedule-row + .schedule-row {
    border-top: 1px solid rgba(255,255,255,.10) !important;
  }

  .schedule-row strong {
    display: block !important;
    margin: 0 0 6px !important;
    font-size: 17px !important;
    line-height: 1.3 !important;
  }

  .schedule-row > div {
    min-width: 0 !important;
    margin: 0 !important;
  }

  .schedule-row b,
  .schedule-row small,
  .schedule-row span {
    display: block !important;
    overflow-wrap: anywhere !important;
    line-height: 1.45 !important;
  }

  .schedule-row small {
    margin-top: 3px !important;
  }

  /* Absensi */
  .attendance-form {
    grid-template-columns: 1fr !important;
    gap: 18px !important;
    padding: 20px !important;
  }

  .attendance-form > div {
    min-width: 0 !important;
  }

  .attendance-form label {
    display: block !important;
    margin-bottom: 8px !important;
    line-height: 1.25 !important;
  }

  .attendance-form input,
  .attendance-form select,
  .attendance-form textarea {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    min-height: 48px !important;
    box-sizing: border-box !important;
  }

  .attendance-form textarea {
    min-height: 100px !important;
    resize: vertical !important;
  }

  .attendance-player-picker {
    min-width: 0 !important;
  }

  .attendance-player-picker .player-results {
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
  }

  #saveAttendance {
    width: 100% !important;
    min-height: 50px !important;
    margin-top: 2px !important;
  }

  /* Tabel */
  .players {
    width: 100% !important;
    max-width: 100% !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
    border-radius: 18px !important;
  }

  .players table {
    min-width: 620px !important;
  }

  .players th,
  .players td {
    padding: 13px 14px !important;
    white-space: nowrap !important;
  }

  /* Promo Penilaian */
  .evaluation-entry {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    justify-content: flex-start !important;
    gap: 20px !important;
    padding: 22px !important;
    min-width: 0 !important;
  }

  .evaluation-entry > div {
    min-width: 0 !important;
    width: 100% !important;
  }

  .evaluation-entry h3 {
    margin: 0 0 10px !important;
    line-height: 1.25 !important;
    overflow-wrap: anywhere !important;
  }

  .evaluation-entry p {
    margin: 0 !important;
    line-height: 1.65 !important;
    overflow-wrap: anywhere !important;
  }

  .evaluation-btn {
    width: 100% !important;
    min-height: 52px !important;
    margin: 0 !important;
    padding: 13px 18px !important;
    line-height: 1.3 !important;
    white-space: normal !important;
  }
}


/* ===== FINAL MOBILE UI — PROFESSIONAL SPACING ===== */
@media (max-width: 700px) {

  html, body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  * {
    box-sizing: border-box;
  }

  .wrap {
    width: calc(100% - 32px) !important;
    max-width: none !important;
    margin-left: 16px !important;
    margin-right: 16px !important;
  }

  main {
    width: 100%;
  }

  /* ---------- SECTION ---------- */

  .section {
    width: 100% !important;
    margin-top: 48px !important;
  }

  .section-head {
    width: 100%;
    margin-bottom: 18px !important;
    gap: 7px !important;
  }

  .section-head h2 {
    margin: 0 !important;
    line-height: 1.2 !important;
    letter-spacing: -0.3px;
  }

  .section-head .section-note {
    line-height: 1.45 !important;
  }

  /* ---------- SEMUA PANEL ---------- */

  .panel {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    border-radius: 18px !important;
    overflow: hidden;
  }

  /* ---------- JADWAL ---------- */

  #schedulePanel {
    display: flex !important;
    flex-direction: column !important;
    gap: 14px !important;
    background: transparent !important;
    border: 0 !important;
    overflow: visible !important;
  }

  #schedulePanel .schedule-row {
    display: block !important;
    width: 100% !important;
    min-width: 0 !important;
    padding: 20px 22px !important;
    margin: 0 !important;
    border: 1px solid rgba(230,180,20,.22) !important;
    border-radius: 18px !important;
    background: rgba(255,255,255,.035) !important;
    line-height: 1.55 !important;
  }

  #schedulePanel .schedule-row + .schedule-row {
    border-top: 1px solid rgba(230,180,20,.22) !important;
  }

  #schedulePanel .schedule-day {
    display: block !important;
    margin: 0 0 9px !important;
    color: var(--gold) !important;
    font-size: 18px !important;
    font-weight: 800 !important;
    line-height: 1.3 !important;
  }

  #schedulePanel .schedule-info {
    display: block !important;
    width: 100% !important;
    min-width: 0 !important;
    margin: 0 !important;
    color: var(--white) !important;
    font-size: 16px !important;
    line-height: 1.55 !important;
    overflow-wrap: anywhere !important;
    word-break: normal !important;
  }

  #schedulePanel .empty {
    padding: 22px !important;
    border: 1px solid var(--green-border) !important;
    border-radius: 18px !important;
  }

  /* ---------- ABSENSI ---------- */

  .attendance-panel {
    width: 100% !important;
    border-radius: 18px !important;
  }

  .attendance-form {
    display: grid !important;
    grid-template-columns: 1fr !important;
    gap: 20px !important;
    padding: 22px !important;
  }

  .attendance-form label {
    display: block !important;
    width: 100% !important;
    min-width: 0 !important;
    margin: 0 !important;
  }

  .attendance-form label > span {
    display: block !important;
    margin: 0 0 9px !important;
    line-height: 1.3 !important;
  }

  .attendance-form input,
  .attendance-form select,
  .attendance-form textarea,
  .attendance-player-picker input[type="search"] {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    min-height: 50px !important;
    margin: 0 !important;
    padding: 13px 15px !important;
    border-radius: 12px !important;
    font-size: 16px !important;
    line-height: 1.4 !important;
  }

  .attendance-form textarea {
    min-height: 105px !important;
  }

  .picker-help {
    display: block !important;
    margin: 8px 0 0 !important;
    line-height: 1.45 !important;
  }

  #attendanceMessage {
    margin: 0 !important;
    padding: 0 22px !important;
    line-height: 1.5 !important;
  }

  #saveAttendance,
  .save-btn {
    width: 100% !important;
    min-height: 52px !important;
    margin: 0 !important;
    border-radius: 13px !important;
    font-size: 16px !important;
    font-weight: 800 !important;
  }

  .attendance-table-wrap {
    width: 100% !important;
    max-width: 100% !important;
    margin-top: 4px !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch;
  }

  .attendance-table-wrap table {
    min-width: 620px !important;
  }

  /* ---------- PROMO PENILAIAN ---------- */

  .evaluation-entry {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    justify-content: flex-start !important;
    width: 100% !important;
    min-width: 0 !important;
    gap: 20px !important;
    padding: 22px !important;
  }

  .evaluation-entry > div {
    width: 100% !important;
    min-width: 0 !important;
  }

  .evaluation-entry h3 {
    margin: 0 !important;
    line-height: 1.3 !important;
    overflow-wrap: anywhere !important;
  }

  .evaluation-entry p {
    margin: 10px 0 0 !important;
    line-height: 1.65 !important;
    overflow-wrap: anywhere !important;
  }

  .evaluation-btn {
    display: flex !important;
    width: 100% !important;
    min-height: 52px !important;
    margin: 0 !important;
    padding: 13px 18px !important;
    border-radius: 13px !important;
    text-align: center !important;
    line-height: 1.3 !important;
  }

  /* ---------- DAFTAR PEMAIN ---------- */

  .players {
    width: 100% !important;
    max-width: 100% !important;
    border-radius: 18px !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    -webkit-overflow-scrolling: touch;
  }

  .players table {
    width: 100% !important;
    min-width: 600px !important;
    margin: 0 !important;
  }

  .players th,
  .players td {
    padding: 15px 16px !important;
    line-height: 1.4 !important;
    white-space: nowrap !important;
  }

  .players th {
    font-size: 13px !important;
    letter-spacing: .04em;
  }

  .players td {
    font-size: 16px !important;
  }

  /* ---------- STAT CARD ---------- */

  .stats {
    width: 100% !important;
    gap: 14px !important;
  }

  .stat {
    width: 100% !important;
    min-width: 0 !important;
    padding: 20px 22px !important;
    border-radius: 18px !important;
  }

  .stat small {
    display: block !important;
    margin-bottom: 9px !important;
    line-height: 1.4 !important;
  }

  .stat strong {
    line-height: 1 !important;
  }

  /* ---------- SEARCH RESULT ---------- */

  .player-results {
    width: 100% !important;
    max-width: 100% !important;
    border-radius: 13px !important;
  }

  .player-result {
    min-height: 48px !important;
    padding: 13px 15px !important;
    line-height: 1.4 !important;
  }
}

</style>
</head>

<body>
  <div class="wrap">
    <header>
      <div class="brand">SSB Bhayangkara Junior 2018</div>
      <button id="logout" class="logout" type="button">Keluar</button>
    </header>

    <main>
      <div class="eyebrow">PELATIH</div>
      <h1 id="welcome">Dashboard Pelatih</h1>
      <p class="intro">
        Kelola aktivitas latihan dan perkembangan pemain.
      </p>

      <section class="stats">
        <div class="stat">
          <small>Pemain Diterima</small>
          <strong id="statPlayers">—</strong>
        </div>

        <div class="stat">
          <small>Jadwal Latihan</small>
          <strong id="statSchedules">—</strong>
        </div>

        <div class="stat">
          <small>Total Pendaftaran</small>
          <strong id="statRegistrations">—</strong>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Jadwal Latihan</h2>
          <span class="section-note">Data dari CMS</span>
        </div>

        <div id="schedulePanel" class="panel">
          <div class="loading">Memuat jadwal...</div>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Absensi Latihan</h2>
          <span class="section-note">Catat kehadiran pemain</span>
        </div>

        <div class="panel attendance-panel">
          <div class="attendance-form">
            <label>
              <span>Tanggal</span>
              <input id="attendanceDate" type="date" />
            </label>

            <label>
              <span>Pemain</span>
              <input
                id="attendanceSearch"
                type="search"
                placeholder="Ketik nama pemain..."
                autocomplete="off"
              />
              <input id="attendancePlayer" type="hidden" />
              <div id="attendanceResults" class="player-results"></div>
              <small class="picker-help">
                Ketik minimal 2 huruf untuk mencari pemain.
              </small>
            </label>

            <label>
              <span>Status</span>
              <select id="attendanceStatus">
                <option value="hadir">Hadir</option>
                <option value="izin">Izin</option>
                <option value="sakit">Sakit</option>
                <option value="alpa">Alpa</option>
              </select>
            </label>

            <label>
              <span>Keterangan</span>
              <input
                id="attendanceNote"
                type="text"
                placeholder="Opsional"
              />
            </label>

            <button id="saveAttendance" class="save-btn" type="button">
              Simpan Absensi
            </button>
          </div>

          <div id="attendanceMessage"></div>

          <div class="attendance-table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tanggal</th>
                  <th>Pemain</th>
                  <th>Status</th>
                  <th>Keterangan</th>
                </tr>
              </thead>
              <tbody id="attendanceBody">
                <tr>
                  <td colspan="4" class="loading">
                    Memuat absensi...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Penilaian Pemain</h2>
          <span class="section-note">Dasar perkembangan anak</span>
        </div>

        <div class="panel evaluation-entry">
          <div>
            <strong>Perkembangan Pemain</strong>
            <p>
              Catat teknik, taktik, fisik, mental, dan kerja sama
              pemain secara berkala sebagai dasar perkembangan anak.
            </p>
          </div>

          <a href="/pelatih/penilaian" class="evaluation-btn">
            Buka Penilaian Pemain →
          </a>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Daftar Pemain</h2>
          <span class="section-note">Peserta dengan status diterima</span>
        </div>

        <div class="panel players">
          <table>
            <thead>
              <tr>
                <th>No.</th>
                <th>Nama Pemain</th>
                <th>Posisi</th>
                <th>Tanggal Lahir</th>
                <th>Status</th>
              </tr>
            </thead>

            <tbody id="playersBody">
              <tr>
                <td colspan="5" class="loading">Memuat pemain...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <script is:inline>
    const destinations = {
      admin: '/admin/pendaftaran',
      pelatih: '/pelatih',
      orang_tua: '/orang-tua',
      siswa: '/siswa'
    };

    function esc(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    let playersCache = [];

    async function loadAttendance() {
      const response = await fetch('/api/pelatih/absensi', {
        cache: 'no-store'
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(
          result.message || 'Gagal memuat absensi.'
        );
      }

      const records = result.data || [];
      const body = document.getElementById('attendanceBody');

      if (!records.length) {
        body.innerHTML = `
          <tr>
            <td colspan="4" class="empty">
              Belum ada data absensi.
            </td>
          </tr>
        `;
        return;
      }

      records.sort((a, b) =>
        String(b.date).localeCompare(String(a.date))
      );

      body.innerHTML = records.map(item => `
        <tr>
          <td>${esc(item.date)}</td>
          <td><strong>${esc(item.playerName)}</strong></td>
          <td>
            <span class="attendance-status">
              ${esc(item.status)}
            </span>
          </td>
          <td>${esc(item.note || '-')}</td>
        </tr>
      `).join('');
    }

    const attendanceSearch =
      document.getElementById('attendanceSearch');

    const attendanceResults =
      document.getElementById('attendanceResults');

    function renderAttendanceResults(keyword = '') {
      const query =
        String(keyword || '').trim().toLowerCase();

      if (query.length < 2) {
        attendanceResults.innerHTML =
          '<div class="picker-empty">Ketik minimal 2 huruf untuk mencari.</div>';
        attendanceResults.classList.add('show');
        return;
      }

      const matches = playersCache
        .map((player, index) => ({
          player,
          index,
          name: String(player.nama || player.name || 'Pemain'),
          number: String(
            player.nomor ||
            player.nomor_pendaftaran ||
            ''
          )
        }))
        .filter(item =>
          `${item.name} ${item.number}`
            .toLowerCase()
            .includes(query)
        )
        .slice(0, 12);

      if (!matches.length) {
        attendanceResults.innerHTML =
          '<div class="picker-empty">Pemain tidak ditemukan.</div>';
        attendanceResults.classList.add('show');
        return;
      }

      attendanceResults.innerHTML = matches.map(item => `
        <button
          type="button"
          class="player-result"
          data-index="${item.index}"
        >
          <span class="player-result-name">${esc(item.name)}</span>
          <span class="player-result-meta">
            ${esc(item.number || String(item.player.id || 'ID pemain'))}
          </span>
        </button>
      `).join('');

      attendanceResults.classList.add('show');
    }

    function chooseAttendancePlayer(player) {
      document.getElementById('attendancePlayer').value =
        String(player.registration_number || player.nomor || player.nomor_pendaftaran || player.id || '');

      attendanceSearch.value =
        player.nama || player.name || 'Pemain';

      attendanceResults.innerHTML = '';
      attendanceResults.classList.remove('show');
    }

    function populateAttendancePlayers() {
      document.getElementById('attendancePlayer').value = '';
      attendanceSearch.value = '';

      attendanceResults.innerHTML =
        '<div class="picker-empty">Ketik nama pemain untuk mencari.</div>';
    }

    attendanceSearch?.addEventListener('input', event => {
      document.getElementById('attendancePlayer').value = '';
      renderAttendanceResults(event.target.value);
    });

    attendanceSearch?.addEventListener('focus', () => {
      if (attendanceSearch.value.length >= 2) {
        renderAttendanceResults(attendanceSearch.value);
      }
    });

    attendanceResults?.addEventListener('click', event => {
      const button = event.target.closest('.player-result');
      if (!button) return;

      const index = Number(button.dataset.index);
      const player = playersCache[index];

      if (player) {
        chooseAttendancePlayer(player);
      }
    });

    document.addEventListener('click', event => {
      if (!event.target.closest('.attendance-player-picker')) {
        attendanceResults?.classList.remove('show');
      }
    });

    async function saveAttendanceRecord() {
      const playerId =
        document.getElementById('attendancePlayer').value;

      const player =
        playersCache.find(item => item.id === playerId);

      const date =
        document.getElementById('attendanceDate').value;

      const status =
        document.getElementById('attendanceStatus').value;

      const note =
        document.getElementById('attendanceNote').value;

      const message =
        document.getElementById('attendanceMessage');

      if (!playerId || !player || !date) {
        message.textContent =
          'Pilih pemain dan tanggal terlebih dahulu.';
        return;
      }

      const response = await fetch('/api/pelatih/absensi', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          playerId,
          playerName: player.nama,
          date,
          status,
          note
        })
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        message.textContent =
          result.message || 'Gagal menyimpan absensi.';
        return;
      }

      message.textContent = 'Absensi berhasil disimpan.';
      document.getElementById('attendanceNote').value = '';

      await loadAttendance();
    }

    async function loadDashboard() {
      const meResponse = await fetch('/api/auth/me', {
        cache: 'no-store'
      });

      const me = await meResponse.json();

      if (!me.authenticated) {
        window.location.href = '/login';
        return;
      }

      if (me.user.role !== 'pelatih') {
        window.location.href =
          destinations[me.user.role] || '/dashboard';
        return;
      }

      document.getElementById('welcome').textContent =
        `Halo, ${me.user.name}`;

      const response = await fetch('/api/pelatih/data', {
        cache: 'no-store'
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(
          result.message || 'Gagal memuat dashboard.'
        );
      }

      const data = result.data;

      playersCache = data.players || [];
      populateAttendancePlayers();

      document.getElementById('statPlayers').textContent =
        data.statistics.players;

      document.getElementById('statSchedules').textContent =
        data.statistics.schedules;

      document.getElementById('statRegistrations').textContent =
        data.statistics.registrations;

      const schedulePanel =
        document.getElementById('schedulePanel');

      if (!data.schedules.length) {
        schedulePanel.innerHTML =
          '<div class="empty">Belum ada jadwal latihan yang diatur melalui CMS.</div>';
      } else {
        schedulePanel.innerHTML =
          data.schedules.map((item) => `
            <div class="schedule-row">
              <div class="schedule-day">
                ${esc(item.day || 'Jadwal')}
              </div>
              <div class="schedule-info">
                ${esc(item.info || '-')}
              </div>
            </div>
          `).join('');
      }

      const playersBody =
        document.getElementById('playersBody');

      if (!data.players.length) {
        playersBody.innerHTML = `
          <tr>
            <td colspan="5" class="empty">
              Belum ada pemain dengan status diterima.
            </td>
          </tr>
        `;
      } else {
        playersBody.innerHTML =
          data.players.map((player, index) => `
            <tr>
              <td>${index + 1}</td>
              <td><strong>${esc(player.nama)}</strong></td>
              <td>${esc(player.posisi)}</td>
              <td>${esc(player.tanggalLahir)}</td>
              <td>
                <span class="status">
                  ${esc(player.status)}
                </span>
              </td>
            </tr>
          `).join('');
      }

      await loadAttendance();
    }

    document.getElementById('saveAttendance')?.addEventListener(
      'click',
      () => {
        saveAttendanceRecord().catch(error => {
          console.error(error);
          document.getElementById('attendanceMessage').textContent =
            'Terjadi kesalahan saat menyimpan absensi.';
        });
      }
    );

    document.getElementById('attendanceDate').value =
      new Date().toISOString().slice(0, 10);

    document.getElementById('logout')?.addEventListener(
      'click',
      async () => {
        await fetch('/api/auth/logout', {
          method: 'POST'
        });

        window.location.href = '/login';
      }
    );

    loadDashboard().catch((error) => {
      console.error(error);

      document.getElementById('schedulePanel').innerHTML =
        '<div class="error">Gagal memuat data dashboard pelatih.</div>';

      document.getElementById('playersBody').innerHTML = `
        <tr>
          <td colspan="5" class="error">
            Gagal memuat data pemain.
          </td>
        </tr>
      `;
    });
  </script>
</body>
</html>

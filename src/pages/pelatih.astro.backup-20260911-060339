---
export const prerender = false;
---

<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Pelatih · SSB Bhayangkara Junior 2018</title>

  <style>
    :root {
      --green: #063b2a;
      --green-dark: #021f16;
      --green-card: rgba(255,255,255,.055);
      --green-border: rgba(255,255,255,.10);
      --gold: #d6ad3a;
      --white: #fff;
      --muted: #aebbb5;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Inter, system-ui, sans-serif;
      color: var(--white);
      background:
        radial-gradient(circle at top right, rgba(214,173,58,.12), transparent 32%),
        linear-gradient(135deg, var(--green), var(--green-dark));
    }

    .wrap {
      width: min(1180px, calc(100% - 32px));
      margin: auto;
      padding: 28px 0 60px;
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      margin-bottom: 65px;
    }

    .brand {
      color: var(--gold);
      font-weight: 800;
      font-size: 12px;
      letter-spacing: .10em;
      text-transform: uppercase;
    }

    button {
      font: inherit;
    }

    .logout {
      border: 1px solid rgba(214,173,58,.5);
      background: transparent;
      color: var(--gold);
      border-radius: 8px;
      padding: 10px 16px;
      cursor: pointer;
      font-weight: 700;
    }

    .eyebrow {
      color: var(--gold);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    h1 {
      font-size: clamp(38px, 7vw, 70px);
      line-height: .98;
      margin: 14px 0 16px;
    }

    .intro {
      color: var(--muted);
      font-size: 17px;
      line-height: 1.6;
      margin: 0;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-top: 42px;
    }

    .stat {
      border: 1px solid var(--green-border);
      background: var(--green-card);
      border-radius: 14px;
      padding: 22px;
    }

    .stat small {
      color: var(--muted);
      display: block;
      font-size: 12px;
      margin-bottom: 10px;
    }

    .stat strong {
      color: var(--gold);
      font-size: 34px;
    }

    .section {
      margin-top: 48px;
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 16px;
    }

    .section h2 {
      margin: 0;
      font-size: 24px;
    }

    .section-note {
      color: var(--muted);
      font-size: 13px;
    }

    .panel {
      border: 1px solid var(--green-border);
      background: rgba(255,255,255,.04);
      border-radius: 14px;
      overflow: hidden;
    }

    .schedule-row {
      display: grid;
      grid-template-columns: 150px 1fr;
      gap: 20px;
      padding: 18px 20px;
      border-bottom: 1px solid rgba(255,255,255,.07);
    }

    .schedule-row:last-child {
      border-bottom: 0;
    }

    .schedule-day {
      color: var(--gold);
      font-weight: 800;
    }

    .schedule-info {
      color: var(--white);
      line-height: 1.5;
    }

    .empty {
      padding: 28px 20px;
      color: var(--muted);
    }

    .players {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 600px;
    }

    th,
    td {
      text-align: left;
      padding: 15px 18px;
      border-bottom: 1px solid rgba(255,255,255,.07);
    }

    th {
      color: var(--gold);
      font-size: 11px;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    td {
      color: #edf3ef;
      font-size: 14px;
    }

    .status {
      display: inline-block;
      padding: 5px 9px;
      border-radius: 999px;
      color: var(--gold);
      background: rgba(214,173,58,.10);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .attendance-form {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      padding: 20px;
      border-bottom: 1px solid rgba(255,255,255,.07);
    }

    .attendance-form label {
      display: grid;
      gap: 7px;
    }

    .attendance-form label span {
      color: var(--gold);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .attendance-form input,
    .attendance-form select {
      width: 100%;
      min-height: 44px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 8px;
      background: rgba(0,0,0,.16);
      color: white;
      padding: 10px 12px;
      font: inherit;
      font-size: 16px;
    }

    .save-btn {
      align-self: end;
      min-height: 44px;
      border: 0;
      border-radius: 8px;
      background: var(--gold);
      color: #102d22;
      font-weight: 800;
      cursor: pointer;
      padding: 10px 16px;
    }

    #attendanceMessage {
      padding: 0 20px;
      color: var(--gold);
      font-size: 13px;
    }

    .attendance-table-wrap {
      overflow-x: auto;
    }

    .attendance-table-wrap table {
      min-width: 650px;
    }

    .attendance-status {
      display: inline-block;
      padding: 5px 9px;
      border-radius: 999px;
      background: rgba(214,173,58,.10);
      color: var(--gold);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
    }

    .loading {
      color: var(--muted);
      padding: 20px 0;
    }

    .error {
      color: #ffb4a8;
      padding: 20px 0;
    }

    .evaluation-entry {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .evaluation-entry p {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
    }

    .evaluation-btn {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 11px 18px;
      border-radius: 8px;
      background: var(--gold);
      color: #10251c;
      text-decoration: none;
      font-weight: 800;
    }

    .evaluation-btn:hover {
      filter: brightness(1.05);
    }

    @media (max-width: 700px) {
      .wrap {
        width: min(100% - 24px, 1180px);
        padding-top: 20px;
      }

      header {
        margin-bottom: 45px;
      }

      .stats {
        grid-template-columns: 1fr;
      }

      .schedule-row {
        grid-template-columns: 1fr;
        gap: 6px;
      }

      .evaluation-entry {
        flex-direction: column;
        align-items: stretch;
      }

      .evaluation-btn {
        width: 100%;
      }

      .section {
        margin-top: 38px;
      }
    }
  </style>
</head>

<body>
  <div class="wrap">
    <header>
      <div class="brand">SSB Bhayangkara Junior 2018</div>
      <button id="logout" class="logout" type="button">Keluar</button>
    </header>

    <main>
      <div class="eyebrow">PELATIH</div>
      <h1 id="welcome">Dashboard Pelatih</h1>
      <p class="intro">
        Kelola aktivitas latihan dan perkembangan pemain.
      </p>

      <section class="stats">
        <div class="stat">
          <small>Pemain Diterima</small>
          <strong id="statPlayers">—</strong>
        </div>

        <div class="stat">
          <small>Jadwal Latihan</small>
          <strong id="statSchedules">—</strong>
        </div>

        <div class="stat">
          <small>Total Pendaftaran</small>
          <strong id="statRegistrations">—</strong>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Jadwal Latihan</h2>
          <span class="section-note">Data dari CMS</span>
        </div>

        <div id="schedulePanel" class="panel">
          <div class="loading">Memuat jadwal...</div>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Absensi Latihan</h2>
          <span class="section-note">Catat kehadiran pemain</span>
        </div>

        <div class="panel attendance-panel">
          <div class="attendance-form">
            <label>
              <span>Tanggal</span>
              <input id="attendanceDate" type="date" />
            </label>

            <label>
              <span>Pemain</span>
              <select id="attendancePlayer">
                <option value="">Pilih pemain</option>
              </select>
            </label>

            <label>
              <span>Status</span>
              <select id="attendanceStatus">
                <option value="hadir">Hadir</option>
                <option value="izin">Izin</option>
                <option value="sakit">Sakit</option>
                <option value="alpa">Alpa</option>
              </select>
            </label>

            <label>
              <span>Keterangan</span>
              <input
                id="attendanceNote"
                type="text"
                placeholder="Opsional"
              />
            </label>

            <button id="saveAttendance" class="save-btn" type="button">
              Simpan Absensi
            </button>
          </div>

          <div id="attendanceMessage"></div>

          <div class="attendance-table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Tanggal</th>
                  <th>Pemain</th>
                  <th>Status</th>
                  <th>Keterangan</th>
                </tr>
              </thead>
              <tbody id="attendanceBody">
                <tr>
                  <td colspan="4" class="loading">
                    Memuat absensi...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Penilaian Pemain</h2>
          <span class="section-note">Dasar perkembangan anak</span>
        </div>

        <div class="panel evaluation-entry">
          <div>
            <strong>Perkembangan Pemain</strong>
            <p>
              Catat teknik, taktik, fisik, mental, dan kerja sama
              pemain secara berkala sebagai dasar perkembangan anak.
            </p>
          </div>

          <a href="/pelatih/penilaian" class="evaluation-btn">
            Buka Penilaian Pemain →
          </a>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Daftar Pemain</h2>
          <span class="section-note">Peserta dengan status diterima</span>
        </div>

        <div class="panel players">
          <table>
            <thead>
              <tr>
                <th>No.</th>
                <th>Nama Pemain</th>
                <th>Posisi</th>
                <th>Tanggal Lahir</th>
                <th>Status</th>
              </tr>
            </thead>

            <tbody id="playersBody">
              <tr>
                <td colspan="5" class="loading">Memuat pemain...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <script is:inline>
    const destinations = {
      admin: '/admin/pendaftaran',
      pelatih: '/pelatih',
      orang_tua: '/orang-tua',
      siswa: '/siswa'
    };

    function esc(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    let playersCache = [];

    async function loadAttendance() {
      const response = await fetch('/api/pelatih/absensi', {
        cache: 'no-store'
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(
          result.message || 'Gagal memuat absensi.'
        );
      }

      const records = result.data || [];
      const body = document.getElementById('attendanceBody');

      if (!records.length) {
        body.innerHTML = `
          <tr>
            <td colspan="4" class="empty">
              Belum ada data absensi.
            </td>
          </tr>
        `;
        return;
      }

      records.sort((a, b) =>
        String(b.date).localeCompare(String(a.date))
      );

      body.innerHTML = records.map(item => `
        <tr>
          <td>${esc(item.date)}</td>
          <td><strong>${esc(item.playerName)}</strong></td>
          <td>
            <span class="attendance-status">
              ${esc(item.status)}
            </span>
          </td>
          <td>${esc(item.note || '-')}</td>
        </tr>
      `).join('');
    }

    function populateAttendancePlayers() {
      const select =
        document.getElementById('attendancePlayer');

      select.innerHTML =
        '<option value="">Pilih pemain</option>' +
        playersCache.map(player => `
          <option value="${esc(player.id)}">
            ${esc(player.nama)}
          </option>
        `).join('');
    }

    async function saveAttendanceRecord() {
      const playerId =
        document.getElementById('attendancePlayer').value;

      const player =
        playersCache.find(item => item.id === playerId);

      const date =
        document.getElementById('attendanceDate').value;

      const status =
        document.getElementById('attendanceStatus').value;

      const note =
        document.getElementById('attendanceNote').value;

      const message =
        document.getElementById('attendanceMessage');

      if (!playerId || !player || !date) {
        message.textContent =
          'Pilih pemain dan tanggal terlebih dahulu.';
        return;
      }

      const response = await fetch('/api/pelatih/absensi', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          playerId,
          playerName: player.nama,
          date,
          status,
          note
        })
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        message.textContent =
          result.message || 'Gagal menyimpan absensi.';
        return;
      }

      message.textContent = 'Absensi berhasil disimpan.';
      document.getElementById('attendanceNote').value = '';

      await loadAttendance();
    }

    async function loadDashboard() {
      const meResponse = await fetch('/api/auth/me', {
        cache: 'no-store'
      });

      const me = await meResponse.json();

      if (!me.authenticated) {
        window.location.href = '/login';
        return;
      }

      if (me.user.role !== 'pelatih') {
        window.location.href =
          destinations[me.user.role] || '/dashboard';
        return;
      }

      document.getElementById('welcome').textContent =
        `Halo, ${me.user.name}`;

      const response = await fetch('/api/pelatih/data', {
        cache: 'no-store'
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(
          result.message || 'Gagal memuat dashboard.'
        );
      }

      const data = result.data;

      playersCache = data.players || [];
      populateAttendancePlayers();

      document.getElementById('statPlayers').textContent =
        data.statistics.players;

      document.getElementById('statSchedules').textContent =
        data.statistics.schedules;

      document.getElementById('statRegistrations').textContent =
        data.statistics.registrations;

      const schedulePanel =
        document.getElementById('schedulePanel');

      if (!data.schedules.length) {
        schedulePanel.innerHTML =
          '<div class="empty">Belum ada jadwal latihan yang diatur melalui CMS.</div>';
      } else {
        schedulePanel.innerHTML =
          data.schedules.map((item) => `
            <div class="schedule-row">
              <div class="schedule-day">
                ${esc(item.day || 'Jadwal')}
              </div>
              <div class="schedule-info">
                ${esc(item.info || '-')}
              </div>
            </div>
          `).join('');
      }

      const playersBody =
        document.getElementById('playersBody');

      if (!data.players.length) {
        playersBody.innerHTML = `
          <tr>
            <td colspan="5" class="empty">
              Belum ada pemain dengan status diterima.
            </td>
          </tr>
        `;
      } else {
        playersBody.innerHTML =
          data.players.map((player, index) => `
            <tr>
              <td>${index + 1}</td>
              <td><strong>${esc(player.nama)}</strong></td>
              <td>${esc(player.posisi)}</td>
              <td>${esc(player.tanggalLahir)}</td>
              <td>
                <span class="status">
                  ${esc(player.status)}
                </span>
              </td>
            </tr>
          `).join('');
      }

      await loadAttendance();
    }

    document.getElementById('saveAttendance')?.addEventListener(
      'click',
      () => {
        saveAttendanceRecord().catch(error => {
          console.error(error);
          document.getElementById('attendanceMessage').textContent =
            'Terjadi kesalahan saat menyimpan absensi.';
        });
      }
    );

    document.getElementById('attendanceDate').value =
      new Date().toISOString().slice(0, 10);

    document.getElementById('logout')?.addEventListener(
      'click',
      async () => {
        await fetch('/api/auth/logout', {
          method: 'POST'
        });

        window.location.href = '/login';
      }
    );

    loadDashboard().catch((error) => {
      console.error(error);

      document.getElementById('schedulePanel').innerHTML =
        '<div class="error">Gagal memuat data dashboard pelatih.</div>';

      document.getElementById('playersBody').innerHTML = `
        <tr>
          <td colspan="5" class="error">
            Gagal memuat data pemain.
          </td>
        </tr>
      `;
    });
  </script>
</body>
</html>

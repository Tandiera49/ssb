---
import Layout from '../layouts/Layout.astro';
import PublicNav from '../components/PublicNav.astro';
import PublicFooter from '../components/PublicFooter.astro';
import { getContent } from '../lib/contentStore';
const content = await getContent();
const missions = Array.isArray(content.mission?.items) ? content.mission.items : [];
---
<Layout title="Tentang SSB Bhayangkara Junior 2018 | Pembinaan Sepak Bola Anak">
  <PublicNav active="tentang" />
  <main id="main-content" class="pro-page">
    <section class="pro-hero"><div class="pro-wrap"><span class="eyebrow">Tentang Kami</span><h1>Membangun pemain.<br /><span>Membentuk pribadi.</span></h1><p>SSB Bhayangkara Junior 2018 adalah ruang tumbuh bagi anak-anak yang ingin belajar sepak bola dengan cara yang positif, terarah, dan menyenangkan.</p><div class="hero-actions"><a class="primary" href="/pendaftaran">Mulai Pendaftaran <span>→</span></a><a class="secondary" href="/program">Lihat Program</a></div></div><div class="hero-mark">BJ<br /><small>2018</small></div></section>
    <section class="pro-section"><div class="pro-wrap"><div class="section-intro"><span class="eyebrow">Mengapa Kami</span><h2>Sepak bola adalah <span>sekolah kehidupan.</span></h2><p>Kami percaya latihan yang baik bukan hanya tentang teknik. Anak belajar hadir tepat waktu, mendengar arahan, bekerja sama, mengelola emosi, dan berani mencoba lagi.</p></div><div class="value-grid"><article><b>01</b><h3>Terarah</h3><p>Latihan disusun untuk membantu perkembangan teknik, fisik, dan pemahaman permainan sesuai tahap usia.</p></article><article><b>02</b><h3>Berkarakter</h3><p>Disiplin, sportivitas, tanggung jawab, dan rasa hormat menjadi bagian dari proses sehari-hari.</p></article><article><b>03</b><h3>Bertumbuh</h3><p>Setiap anak memiliki ritme perkembangan yang berbeda dan perlu didampingi dengan konsisten.</p></article></div></div></section>
    <section class="pro-section dark"><div class="pro-wrap two-col"><div><span class="eyebrow">Visi</span><h2>{content.vision?.title || 'Visi'}</h2><p class="large">{content.vision?.text}</p></div><div><span class="eyebrow">Misi</span><h2>{content.mission?.title || 'Misi'}</h2><ul>{missions.map((item: string) => <li>{item}</li>)}</ul></div></div></section>
    <section class="pro-cta"><div class="pro-wrap cta-row"><div><span class="eyebrow">Untuk Orang Tua</span><h2>Berikan ruang untuk anak <span>menemukan potensinya.</span></h2></div><a class="primary" href="/kontak">Konsultasi Sekarang <span>→</span></a></div></section>
  </main>
  <PublicFooter />
</Layout>
<style>
.pro-page{background:#f4f8f5;color:#123126}.pro-wrap{width:min(1180px,calc(100% - 36px));margin:auto}.pro-hero{min-height:530px;padding:100px max(18px,calc((100% - 1180px)/2));display:flex;align-items:center;justify-content:space-between;gap:30px;background:linear-gradient(120deg,#032b1d,#075d39);color:white}.eyebrow{color:#b78b15;font-size:12px;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.pro-hero .eyebrow,.dark .eyebrow{color:#ffd84f}.pro-hero h1{max-width:720px;margin:17px 0;font-size:clamp(48px,7vw,88px);line-height:.95;letter-spacing:-.06em}.pro-hero h1 span,h2 span{color:#ffd84f}.pro-hero p{max-width:620px;color:#d5e5dc;font-size:19px;line-height:1.65}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.primary,.secondary{display:inline-flex;align-items:center;gap:10px;padding:14px 20px;border-radius:999px;font-weight:900}.primary{background:#f4c52d;color:#052217}.secondary{border:1px solid rgba(255,255,255,.35);color:white}.hero-mark{width:220px;height:220px;display:grid;place-items:center;border:1px solid rgba(255,216,79,.45);border-radius:50%;color:#ffd84f;font-size:74px;font-weight:1000;text-align:center;line-height:.7;box-shadow:0 0 80px rgba(18,163,93,.25)}.hero-mark small{font-size:18px;letter-spacing:.2em}.pro-section{padding:100px 0}.section-intro{max-width:700px}.section-intro h2,.two-col h2,.pro-cta h2{margin:12px 0 18px;font-size:clamp(34px,5vw,58px);line-height:.98;letter-spacing:-.05em}.section-intro p,.value-grid p,.two-col p,.two-col li{color:#587066;line-height:1.75;font-size:17px}.value-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:46px}.value-grid article{padding:28px;border:1px solid #d5e5dc;border-radius:20px;background:#fff}.value-grid b{color:#b78b15}.value-grid h3{font-size:25px;margin:34px 0 8px}.value-grid p{font-size:15px;margin:0}.dark{background:#032b1d;color:#fff}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:70px}.dark p,.dark li{color:#bcd0c5}.dark ul{padding-left:20px;line-height:2}.large{font-size:20px!important}.pro-cta{padding:70px 0;background:#075d39;color:#fff}.cta-row{display:flex;align-items:center;justify-content:space-between;gap:30px}.pro-cta h2{max-width:700px;margin-bottom:0}@media(max-width:760px){.pro-hero{padding-top:70px;display:block}.hero-mark{width:140px;height:140px;font-size:42px;margin:45px auto 0}.value-grid,.two-col{grid-template-columns:1fr;gap:18px}.two-col{gap:40px}.cta-row{display:block}.cta-row .primary{margin-top:25px}}
</style>
